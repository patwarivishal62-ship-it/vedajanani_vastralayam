[
  {
    "name": "theme_info",
    "theme_name": "Vedajanani Editorial",
    "theme_version": "2.0.0",
    "theme_author": "Vedajanani Vastralayam",
    "theme_documentation_url": "https://github.com/patwarivishal62-ship-it/vedajanani_vastralayam",
    "theme_support_url": "https://github.com/patwarivishal62-ship-it/vedajanani_vastralayam"
  },
  {
    "name": "Logo & Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon image",
        "info": "Scaled down to 32 x 32px"
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Default store logo",
        "info": "Used as fallback if no logo is set in the Header section"
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Default logo width",
        "min": 60,
        "max": 320,
        "step": 10,
        "unit": "px",
        "default": 160
      }
    ]
  },
