<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ page_title }}{% if current_page_handle %} – {{ current_page_handle }}{% endif %} | {{ shop.name }}</title>
<meta name="description" content="{{ page_description | escape }}">
{{ content_for_header }}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Jost:wght@300;400;500;600&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">
{{ 'base.css' | asset_url | stylesheet_tag }}
{{ 'editorial.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'header.css' | asset_url | stylesheet_tag }}
</head>
<body>
<a class="skip-link" href="#MainContent">Skip to content</a>
{% section 'announcement-bar' %}
{% section 'header' %}
<main id="MainContent">{{ content_for_layout }}</main>
{% section 'footer' %}
{% section 'cart-drawer' %}
{{ 'theme.js' | asset_url | script_tag }}
</body>
</html>
