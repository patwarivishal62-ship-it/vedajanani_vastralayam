<section class="wrap" style="padding: {{ section.settings.padding_y }}px 16px; text-align: center; max-width: 680px;">
  <span class="eyebrow">404</span>
  <h1 style="font-size: {{ section.settings.heading_size }}px; margin-bottom: 12px;">{{ section.settings.heading }}</h1>
  <p style="color: var(--text-muted); margin-bottom: 28px;">{{ section.settings.message }}</p>

  {% if section.settings.show_search %}
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-form" style="max-width: 500px; margin: 0 auto 28px;">
      <input type="hidden" name="type" value="product">
      <div class="search-input-wrap">
        <label for="NotFoundSearch-{{ section.id }}" class="visually-hidden">Search sarees</label>
        <input id="NotFoundSearch-{{ section.id }}" type="search" name="q" placeholder="Search cotton, silk, chiffon, festive…" data-clearable-input>
        <button type="button" class="search-clear-btn" data-search-clear aria-label="Clear search" hidden>{% render 'icons', icon: 'close' %}</button>
      </div>
      <button type="submit" class="btn">Search</button>
    </form>
  {% endif %}

  <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; margin-bottom: 28px;">
    <a class="btn" href="{{ routes.all_products_collection_url }}">{{ section.settings.shop_all_label }}</a>
    <a class="btn outline" href="{{ section.settings.button_url | default: routes.root_url }}">{{ section.settings.button_label }}</a>
  </div>

  <div class="search-recovery-links" style="border-top: 1px solid var(--border-color); padding-top: 24px;">
    <a class="link-cta" href="{{ routes.collections_url }}/cotton">Cotton</a>
    <a class="link-cta" href="{{ routes.collections_url }}/silk">Silk</a>
    <a class="link-cta" href="{{ routes.collections_url }}/chiffon">Chiffon</a>
    <a class="link-cta" href="{{ routes.collections_url }}/georgette">Georgette</a>
  </div>
</section>

{% schema %}
{
  "name": "404 Not Found",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Page Not Found" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 28, "max": 52, "step": 2, "unit": "px", "default": 40 },
    { "type": "textarea", "id": "message", "label": "Message", "default": "The page you are looking for may have moved or is no longer available. Search our sarees or browse a collection below." },
    { "type": "checkbox", "id": "show_search", "label": "Show search bar", "default": true },
    { "type": "text", "id": "shop_all_label", "label": "Primary button label", "default": "Shop All Sarees" },
    { "type": "text", "id": "button_label", "label": "Secondary button label", "default": "Return Home" },
    { "type": "url", "id": "button_url", "label": "Secondary button link" },
    { "type": "range", "id": "padding_y", "label": "Vertical padding", "min": 40, "max": 120, "step": 8, "unit": "px", "default": 80 }
  ]
}
{% endschema %}
