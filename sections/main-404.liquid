<section class="wrap" style="padding: {{ section.settings.padding_y }}px 20px; text-align: center; max-width: 660px;">
  <span class="eyebrow">404</span>
  <h1 style="font-size: {{ section.settings.heading_size }}px; margin-bottom: 14px;">{{ section.settings.heading }}</h1>
  <p style="color: var(--text-muted); margin-bottom: 26px;">{{ section.settings.message }}</p>

  {% if section.settings.show_search %}
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-form" style="max-width: 480px; margin: 0 auto 28px;">
      <input type="hidden" name="type" value="product">
      <input type="search" name="q" placeholder="Search cotton, silk, chiffon, festive..." aria-label="Search sarees">
      <button type="submit" class="btn">Search</button>
    </form>
  {% endif %}

  <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
    <a class="btn" href="{{ section.settings.button_url | default: routes.root_url }}">{{ section.settings.button_label }}</a>
    <a class="btn outline" href="{{ routes.all_products_collection_url }}">{{ section.settings.shop_all_label }}</a>
  </div>
</section>

{% schema %}
{
  "name": "404 Not Found",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Page Not Found" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 28, "max": 64, "step": 2, "unit": "px", "default": 42 },
    { "type": "textarea", "id": "message", "label": "Message", "default": "The page you are looking for may have moved or is no longer available. Search our collections or return to the storefront below." },
    { "type": "checkbox", "id": "show_search", "label": "Show search bar", "default": true },
    { "type": "text", "id": "button_label", "label": "Primary button label", "default": "Return Home" },
    { "type": "url", "id": "button_url", "label": "Primary button link" },
    { "type": "text", "id": "shop_all_label", "label": "Secondary button label", "default": "Shop All Sarees" },
    { "type": "range", "id": "padding_y", "label": "Vertical padding", "min": 40, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ]
}
{% endschema %}
