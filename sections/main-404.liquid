<section style="padding: {{ section.settings.padding_y }}px 0; text-align: {{ section.settings.align }};">
  <div class="wrap" style="max-width: 640px;">
    <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    <h1 style="font-size: {{ section.settings.heading_size }}px; margin: 12px 0;">{{ section.settings.heading }}</h1>
    <p style="color: var(--text-muted); margin-bottom: 28px;">{{ section.settings.message }}</p>
    <a class="btn" href="{{ section.settings.cta_url | default: routes.root_url }}">{{ section.settings.cta_label }}</a>
  </div>
</section>

{% schema %}
{
  "name": "404 Not Found",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "404" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Page not found" },
    { "type": "textarea", "id": "message", "label": "Message", "default": "The weave you are looking for may have moved or sold out." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Return Home" },
    { "type": "url", "id": "cta_url", "label": "Button link" },
    { "type": "text_alignment", "id": "align", "label": "Alignment", "default": "center" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 28, "max": 68, "step": 2, "unit": "px", "default": 44 },
    { "type": "range", "id": "padding_y", "label": "Vertical padding", "min": 32, "max": 140, "step": 4, "unit": "px", "default": 88 }
  ]
}
{% endschema %}
