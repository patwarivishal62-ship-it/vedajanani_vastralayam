<section style="padding: {{ section.settings.padding_y }}px 0;">
  <div class="wrap">
    <div class="section-head section-head--center">
      <h1>{{ section.settings.heading }}</h1>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "List Blogs",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Journal" },
    { "type": "range", "id": "padding_y", "label": "Vertical padding", "min": 16, "max": 100, "step": 4, "unit": "px", "default": 48 }
  ]
}
{% endschema %}
