{%- liquid
  assign has_reviews = false
  if section.blocks.size > 0
    assign has_reviews = true
  endif
-%}

{% unless section.settings.hide_when_empty and has_reviews == false %}
{% style %}
  #shopify-section-{{ section.id }} .vv-testi-sec {
    {% if section.settings.bg_color != blank and section.settings.bg_color != 'rgba(0,0,0,0)' %}
      background: {{ section.settings.bg_color }};
    {% endif %}
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .vv-grid {
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
    gap: {{ section.settings.grid_gap }}px;
  }
  #shopify-section-{{ section.id }} .testi-card {
    background: {{ section.settings.card_bg }};
    color: {{ section.settings.card_text }};
    border-radius: {{ section.settings.card_radius }}px;
    padding: {{ section.settings.card_pad }}px;
    text-align: {{ section.settings.card_align }};
  }
  #shopify-section-{{ section.id }} .testi-stars {
    color: {{ section.settings.star_color }};
  }
  #shopify-section-{{ section.id }} .testi-quote {
    font-size: {{ section.settings.quote_size }}px;
  }
  @media (max-width: 900px) {
    #shopify-section-{{ section.id }} .vv-testi-sec {
      padding-top: 44px;
      padding-bottom: 44px;
    }
    #shopify-section-{{ section.id }} .vv-grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, minmax(0, 1fr));
      gap: 14px;
    }
  }
{% endstyle %}

<section class="vv-testi-sec">
  <div class="wrap">
    {% if section.settings.eyebrow != blank or section.settings.heading != blank %}
      <div class="section-head section-head--{{ section.settings.heading_align }}">
        {% if section.settings.eyebrow != blank %}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 style="font-size: {{ section.settings.heading_size }}px; color: {{ section.settings.heading_color }};">
            {{ section.settings.heading }}
          </h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p class="section-sub">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="vv-grid">
      {% if has_reviews %}
        {% for block in section.blocks %}
          <article class="testi-card" {{ block.shopify_attributes }}>
            {% if section.settings.show_stars and block.settings.rating > 0 %}
              <div class="testi-stars" aria-label="{{ block.settings.rating }} out of 5 stars">
                {% for s in (1..block.settings.rating) %}★{% endfor %}
              </div>
            {% endif %}
            <p class="testi-quote">“{{ block.settings.quote }}”</p>
            {% if block.settings.author != blank %}
              <div class="testi-author">{{ block.settings.author }}</div>
            {% endif %}
            {% if block.settings.meta != blank %}
              <div class="testi-meta">{{ block.settings.meta }}</div>
            {% endif %}
          </article>
        {% endfor %}
      {% else %}
        <article class="testi-card">
          <p class="testi-quote">“Verified customer reviews will be featured here as orders are delivered. Add authentic customer notes from your Theme Editor.”</p>
          <div class="testi-author">Verified Customer Note</div>
          <div class="testi-meta">Cotton Collection</div>
        </article>
        <article class="testi-card">
          <p class="testi-quote">“Replace these placeholders with authentic feedback from Vedajanani Vastralayam patrons once orders arrive.”</p>
          <div class="testi-author">Verified Customer Note</div>
          <div class="testi-meta">Silk &amp; Festive Edit</div>
        </article>
        <article class="testi-card">
          <p class="testi-quote">“Every review published here represents a real saree experience shared by our customers.”</p>
          <div class="testi-author">Verified Customer Note</div>
          <div class="testi-meta">Wedding Edit</div>
        </article>
      {% endif %}
    </div>
  </div>
</section>
{% endunless %}

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    { "type": "checkbox", "id": "hide_when_empty", "label": "Hide section when no reviews are added", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Customer Reflections" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Words From Our Patrons" },
    { "type": "textarea", "id": "subheading", "label": "Subheading (optional)", "default": "Verified reviews from customers who have worn Vedajanani Vastralayam." },
    { "type": "text_alignment", "id": "heading_align", "label": "Header alignment", "default": "center" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 24, "max": 48, "step": 2, "unit": "px", "default": 36 },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#202521" },
    { "type": "header", "content": "Grid & Cards" },
    { "type": "range", "id": "columns_desktop", "label": "Columns (desktop)", "min": 1, "max": 4, "step": 1, "default": 3 },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns (mobile)",
      "options": [
        { "value": "1", "label": "1 column" },
        { "value": "2", "label": "2 columns" }
      ],
      "default": "1"
    },
    { "type": "range", "id": "grid_gap", "label": "Grid gap (desktop)", "min": 12, "max": 36, "step": 4, "unit": "px", "default": 24 },
    { "type": "checkbox", "id": "show_stars", "label": "Show star ratings", "default": false },
    { "type": "color", "id": "star_color", "label": "Star color", "default": "#A88A48" },
    { "type": "range", "id": "quote_size", "label": "Quote font size", "min": 15, "max": 24, "step": 1, "unit": "px", "default": 18 },
    { "type": "text_alignment", "id": "card_align", "label": "Card alignment", "default": "left" },
    { "type": "range", "id": "card_pad", "label": "Card padding", "min": 16, "max": 40, "step": 4, "unit": "px", "default": 28 },
    { "type": "range", "id": "card_radius", "label": "Card corner radius", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 12 },
    { "type": "color", "id": "card_bg", "label": "Card background", "default": "#FFFFFF" },
    { "type": "color", "id": "card_text", "label": "Card text color", "default": "#202521" },
    { "type": "header", "content": "Section Spacing" },
    { "type": "color", "id": "bg_color", "label": "Section background (optional)" },
    { "type": "range", "id": "padding_top", "label": "Top padding (desktop)", "min": 32, "max": 96, "step": 8, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding (desktop)", "min": 32, "max": 96, "step": 8, "unit": "px", "default": 72 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Customer Review",
      "settings": [
        { "type": "range", "id": "rating", "label": "Star rating (0 to hide)", "min": 0, "max": 5, "step": 1, "default": 0 },
        { "type": "textarea", "id": "quote", "label": "Review quote", "default": "Add a verified customer quote here once orders are fulfilled." },
        { "type": "text", "id": "author", "label": "Customer name", "default": "Verified Patron" },
        { "type": "text", "id": "meta", "label": "City or collection (optional)", "default": "Coming Soon" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "review", "settings": { "rating": 0, "quote": "Verified customer notes on fabric feel, drape and finishing will appear here once orders are delivered.", "author": "Verified Patron", "meta": "Cotton Collection" } },
        { "type": "review", "settings": { "rating": 0, "quote": "Replace this placeholder in Theme Editor with authentic feedback from your customers.", "author": "Verified Patron", "meta": "Silk & Festive Edit" } },
        { "type": "review", "settings": { "rating": 0, "quote": "Every story shared here comes directly from patrons wearing Vedajanani Vastralayam sarees.", "author": "Verified Patron", "meta": "Wedding Edit" } }
      ]
    }
  ]
}
{% endschema %}
