{%- liquid
  assign show_side = section.settings.show_side_panel
  assign recover_submitted = false
-%}

{% style %}
  #shopify-section-{{ section.id }} .vv-auth-sec {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .vv-auth-shell {
    border-radius: {{ section.settings.card_radius }}px;
  }
  #shopify-section-{{ section.id }} .vv-auth-aside {
    background: {{ section.settings.side_bg }};
  }
  @media (max-width: 860px) {
    #shopify-section-{{ section.id }} .vv-auth-sec {
      padding-top: 28px;
      padding-bottom: 52px;
    }
  }
{% endstyle %}

<section class="vv-auth-sec">
  <div class="wrap">
    <div class="vv-auth-shell{% unless show_side %} vv-auth-shell--single{% endunless %}" data-auth-shell>
      {% if show_side %}
        <div class="vv-auth-aside">
          {% if section.settings.side_image != blank %}
            <img
              class="vv-auth-aside-img"
              src="{{ section.settings.side_image | image_url: width: 900 }}"
              alt="{{ section.settings.side_image.alt | default: shop.name | escape }}"
              width="600"
              height="780"
              loading="eager"
            >
            <div class="vv-auth-aside-scrim" aria-hidden="true"></div>
          {% endif %}
          <div class="vv-auth-aside-frame" aria-hidden="true"></div>
          <div class="vv-auth-aside-content">
            <span class="vv-auth-brand-kicker">{{ section.settings.side_kicker }}</span>
            <div class="vv-woven-accent" aria-hidden="true" style="margin: 14px 0 18px;"></div>
            <h2>{{ section.settings.side_heading }}</h2>
            {% if section.settings.side_copy != blank %}
              <p class="vv-auth-aside-copy">{{ section.settings.side_copy }}</p>
            {% endif %}
            {% if section.settings.perk_1 != blank or section.settings.perk_2 != blank or section.settings.perk_3 != blank %}
              <ul class="vv-auth-perks">
                {% if section.settings.perk_1 != blank %}<li>{{ section.settings.perk_1 }}</li>{% endif %}
                {% if section.settings.perk_2 != blank %}<li>{{ section.settings.perk_2 }}</li>{% endif %}
                {% if section.settings.perk_3 != blank %}<li>{{ section.settings.perk_3 }}</li>{% endif %}
              </ul>
            {% endif %}
          </div>
        </div>
      {% endif %}

      <div class="vv-auth-main">
        <nav class="vv-auth-tabs" aria-label="Account access">
          <a href="{{ routes.account_login_url }}" class="vv-auth-tab is-active" aria-current="page">Sign In</a>
          <a href="{{ routes.account_register_url }}" class="vv-auth-tab">Create Account</a>
        </nav>

        <div id="recover" class="vv-auth-panel vv-auth-panel--recover" data-auth-panel="recover">
          <div class="vv-auth-head">
            <span class="eyebrow">Account Recovery</span>
            <h1>Reset Password</h1>
            <p class="vv-auth-sub">Enter the email address linked to your account and we will send you a password reset link.</p>
          </div>

          {% form 'recover_customer_password', class: 'form-stack' %}
            {% if form.posted_successfully? %}
              {% assign recover_submitted = true %}
              <div class="form-success" role="status" aria-live="polite">
                We have sent a password reset link to your email address.
              </div>
            {% endif %}
            {% if form.errors %}
              <div class="errors" role="alert">{{ form.errors | default_errors }}</div>
            {% endif %}

            <div class="field-group">
              <label for="RecoverEmail-{{ section.id }}">Email address</label>
              <input
                id="RecoverEmail-{{ section.id }}"
                type="email"
                name="email"
                autocomplete="email"
                placeholder="you@example.com"
                required
              >
            </div>

            <button type="submit" class="btn full">Send Reset Link</button>
          {% endform %}

          <p class="vv-auth-foot-note">
            Remembered your password?
            <a href="#login" class="vv-auth-link" data-auth-switch="login">Back to Sign In</a>
          </p>
        </div>

        <div id="login" class="vv-auth-panel vv-auth-panel--login" data-auth-panel="login">
          <div class="vv-auth-head">
            <span class="eyebrow">Welcome Back</span>
            <h1>{{ section.settings.heading }}</h1>
            {% if section.settings.subtitle != blank %}
              <p class="vv-auth-sub">{{ section.settings.subtitle }}</p>
            {% endif %}
          </div>

          {% if recover_submitted %}
            <div class="form-success" role="status" aria-live="polite" style="margin-bottom: 18px;">
              We have sent a password reset link to your email address.
            </div>
          {% endif %}

          {% form 'customer_login', class: 'form-stack' %}
            {% if form.errors %}
              <div class="errors" role="alert">{{ form.errors | default_errors }}</div>
            {% endif %}

            <div class="field-group">
              <label for="CustomerEmail-{{ section.id }}">Email address</label>
              <input
                id="CustomerEmail-{{ section.id }}"
                type="email"
                name="customer[email]"
                autocomplete="email"
                placeholder="you@example.com"
                required
              >
            </div>

            <div class="field-group">
              <div class="vv-label-row">
                <label for="CustomerPassword-{{ section.id }}">Password</label>
                <a href="#recover" class="vv-auth-inline-link" data-auth-switch="recover">Forgot password?</a>
              </div>
              <div class="vv-password-wrap">
                <input
                  id="CustomerPassword-{{ section.id }}"
                  type="password"
                  name="customer[password]"
                  autocomplete="current-password"
                  placeholder="Enter your password"
                  required
                >
                <button
                  type="button"
                  class="vv-password-toggle"
                  data-password-toggle
                  aria-label="Show password"
                  aria-pressed="false"
                >
                  <span data-eye-show>{% render 'icons', icon: 'eye' %}</span>
                  <span data-eye-hide hidden>{% render 'icons', icon: 'eye-off' %}</span>
                </button>
              </div>
            </div>

            <button type="submit" class="btn full">Sign In</button>
          {% endform %}

          {% if shop.checkout.guest_login %}
            <div class="vv-auth-divider"><span>or</span></div>
            {% form 'guest_login' %}
              <button type="submit" class="btn outline full">Continue as Guest</button>
            {% endform %}
          {% endif %}

          <p class="vv-auth-foot-note">
            New to {{ shop.name }}?
            <a href="{{ routes.account_register_url }}" class="vv-auth-link">Create an account</a>
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Customer Login",
  "settings": [
    { "type": "header", "content": "Sign In Form" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Sign In to Your Account" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "View your saree orders, track deliveries and manage saved addresses." },
    { "type": "header", "content": "Heritage Side Panel" },
    { "type": "checkbox", "id": "show_side_panel", "label": "Show heritage side panel (desktop)", "default": true },
    { "type": "image_picker", "id": "side_image", "label": "Editorial saree photograph (optional)" },
    { "type": "color", "id": "side_bg", "label": "Side panel fallback color", "default": "#1C382B" },
    { "type": "text", "id": "side_kicker", "label": "Brand kicker", "default": "Vedajanani Vastralayam · Hyderabad" },
    { "type": "text", "id": "side_heading", "label": "Editorial quote / heading", "default": "Woven with Grace, Worn with Pride." },
    { "type": "textarea", "id": "side_copy", "label": "Editorial note", "default": "Handpicked Cotton, Silk, Chiffon & Georgette sarees curated with personal care from our boutique in Nagole, Hyderabad." },
    { "type": "text", "id": "perk_1", "label": "Member benefit 1", "default": "Track current orders & revisit past saree selections" },
    { "type": "text", "id": "perk_2", "label": "Member benefit 2", "default": "Save shipping addresses for effortless checkout" },
    { "type": "text", "id": "perk_3", "label": "Member benefit 3", "default": "Direct support from our Hyderabad boutique team" },
    { "type": "header", "content": "Spacing & Corners" },
    { "type": "range", "id": "card_radius", "label": "Card corner radius", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 24, "max": 96, "step": 8, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 32, "max": 96, "step": 8, "unit": "px", "default": 72 }
  ]
}
{% endschema %}
