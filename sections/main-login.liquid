<section class="account-sec">
  <div class="wrap account-narrow">
    <div id="recover" class="account-card account-recover">
      <div class="account-head">
        <span class="eyebrow">Account Recovery</span>
        <h1>Reset Password</h1>
        <p class="account-sub">Enter the email address linked to your account and we will send you a password reset link.</p>
      </div>
      {% form 'recover_customer_password', class: 'form-stack' %}
        {% if form.posted_successfully? %}
          <p class="form-success" role="status" aria-live="polite">We have sent a password reset link to your email address.</p>
        {% endif %}
        {% if form.errors %}
          <div class="errors" role="alert">{{ form.errors | default_errors }}</div>
        {% endif %}
        <div class="field-group">
          <label for="RecoverEmail">Email address</label>
          <input id="RecoverEmail" type="email" name="email" autocomplete="email" placeholder="you@example.com" required>
        </div>
        <button type="submit" class="btn full">Send Reset Link</button>
        <p class="account-alt"><a href="#login" class="link-cta">Back to Sign In</a></p>
      {% endform %}
    </div>

    <div id="login" class="account-card">
      <div class="account-head">
        <span class="eyebrow">Welcome Back</span>
        <h1>{{ section.settings.heading }}</h1>
        {% if section.settings.subtitle != blank %}
          <p class="account-sub">{{ section.settings.subtitle }}</p>
        {% endif %}
      </div>

      {% form 'customer_login', class: 'form-stack' %}
        {% if form.errors %}
          <div class="errors" role="alert">{{ form.errors | default_errors }}</div>
        {% endif %}
        <div class="field-group">
          <label for="CustomerEmail">Email address</label>
          <input id="CustomerEmail" type="email" name="customer[email]" autocomplete="email" placeholder="you@example.com" required>
        </div>
        <div class="field-group">
          <label for="CustomerPassword">Password</label>
          <input id="CustomerPassword" type="password" name="customer[password]" autocomplete="current-password" placeholder="Enter your password" required>
        </div>
        <button type="submit" class="btn full">Sign In</button>
      {% endform %}

      <div class="account-links">
        <a href="#recover">Forgot password?</a>
        <span>·</span>
        <a href="{{ routes.account_register_url }}">Create an account</a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Customer Login",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Sign In" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "Sign in to view your order history and manage your saved shipping addresses." }
  ]
}
{% endschema %}
