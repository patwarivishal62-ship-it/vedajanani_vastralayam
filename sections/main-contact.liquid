{%- liquid
  assign wa_digits = settings.whatsapp_number | strip | remove: ' ' | remove: '+' | remove: '-' | remove: '(' | remove: ')'
  assign has_contact_meta = false
  if section.settings.address != blank or section.settings.phone != blank or section.settings.email != blank or section.settings.hours != blank or wa_digits != blank
    assign has_contact_meta = true
  endif
-%}

{% style %}
  #shopify-section-{{ section.id }} .vv-contact-sec {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  @media (max-width: 900px) {
    #shopify-section-{{ section.id }} .vv-contact-sec {
      padding-top: 32px;
      padding-bottom: 52px;
    }
  }
{% endstyle %}

<section class="vv-contact-sec">
  <div class="wrap">
    {% render 'breadcrumbs' %}

    <div class="section-head section-head--left" style="margin-bottom: 36px; max-width: 680px;">
      {% if section.settings.eyebrow != blank %}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}
      <h1 style="font-size: 38px; margin-bottom: 10px;">{{ section.settings.heading | default: page.title }}</h1>
      {% if section.settings.intro != blank %}
        <p class="section-sub" style="margin: 0;">{{ section.settings.intro }}</p>
      {% endif %}
    </div>

    <div class="contact-layout">
      <div class="contact-form-card">
        <h2>{{ section.settings.form_heading }}</h2>

        {% form 'contact', class: 'form-stack' %}
          {% if form.posted_successfully? %}
            <div class="form-success" role="status" aria-live="polite">
              {{ section.settings.success_message }}
            </div>
          {% endif %}
          {% if form.errors %}
            <div class="errors" role="alert" aria-live="assertive">
              {{ form.errors | default_errors }}
            </div>
          {% endif %}

          <div class="field-group">
            <label for="ContactName-{{ section.id }}">Full name</label>
            <input
              id="ContactName-{{ section.id }}"
              type="text"
              name="contact[name]"
              autocomplete="name"
              required
              value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
              placeholder="Your name"
            >
          </div>

          <div class="field-group">
            <label for="ContactEmail-{{ section.id }}">Email address</label>
            <input
              id="ContactEmail-{{ section.id }}"
              type="email"
              name="contact[email]"
              autocomplete="email"
              required
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
              placeholder="you@example.com"
            >
          </div>

          <div class="field-group">
            <label for="ContactPhone-{{ section.id }}">Phone / WhatsApp (optional)</label>
            <input
              id="ContactPhone-{{ section.id }}"
              type="tel"
              name="contact[phone]"
              autocomplete="tel"
              value="{{ form.phone }}"
              placeholder="+91"
            >
          </div>

          <div class="field-group">
            <label for="ContactMessage-{{ section.id }}">Message</label>
            <textarea
              id="ContactMessage-{{ section.id }}"
              name="contact[body]"
              rows="5"
              required
              placeholder="Ask about a saree fabric, drape, order or bespoke request…"
            >{{ form.body }}</textarea>
          </div>

          <div>
            <button type="submit" class="btn">{{ section.settings.submit_label }}</button>
          </div>
        {% endform %}
      </div>

      <div class="contact-side">
        {% if has_contact_meta %}
          <div class="contact-details-card">
            <h2>{{ section.settings.details_heading }}</h2>
            <dl class="contact-details-list">
              {% if section.settings.address != blank %}
                <div>
                  <dt>Location</dt>
                  <dd>{{ section.settings.address }}</dd>
                </div>
              {% endif %}
              {% if section.settings.phone != blank %}
                <div>
                  <dt>Phone</dt>
                  <dd><a href="tel:{{ section.settings.phone | remove: ' ' }}">{{ section.settings.phone }}</a></dd>
                </div>
              {% endif %}
              {% if section.settings.email != blank %}
                <div>
                  <dt>Email</dt>
                  <dd><a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a></dd>
                </div>
              {% endif %}
              {% if section.settings.hours != blank %}
                <div>
                  <dt>Hours</dt>
                  <dd>{{ section.settings.hours }}</dd>
                </div>
              {% endif %}
            </dl>
            {% if wa_digits != blank %}
              <div style="margin-top: 20px;">
                <a
                  class="btn outline"
                  href="https://wa.me/{{ wa_digits }}?text={{ 'Hello Vedajanani Vastralayam, I have a question regarding sarees.' | url_encode }}"
                  target="_blank"
                  rel="noopener"
                >
                  {% render 'icons', icon: 'whatsapp' %}
                  <span>Message on WhatsApp</span>
                </a>
              </div>
            {% endif %}
          </div>
        {% endif %}

        {% if section.blocks.size > 0 %}
          <div class="contact-faq-card" id="faq">
            <span class="eyebrow">Help</span>
            <h2>{{ section.settings.faq_heading }}</h2>
            <div class="faq-list">
              {% for block in section.blocks %}
                <details class="vv-accordion" {% if forloop.first %}open{% endif %} {{ block.shopify_attributes }}>
                  <summary>
                    <span>
                      {% if block.settings.category != blank %}<em class="faq-cat">{{ block.settings.category }}</em>{% endif %}
                      {{ block.settings.question }}
                    </span>
                    <span class="vv-accordion-icon" aria-hidden="true">{% render 'icons', icon: 'chevron-down' %}</span>
                  </summary>
                  <div class="vv-accordion-body rte">
                    {{ block.settings.answer }}
                    {% if block.settings.policy_link == 'shipping' and shop.shipping_policy != blank %}
                      <p style="margin-top: 10px;"><a class="link-cta" href="{{ shop.shipping_policy.url }}"><span>View Shipping Policy</span>{% render 'icons', icon: 'arrow-right' %}</a></p>
                    {% elsif block.settings.policy_link == 'refund' and shop.refund_policy != blank %}
                      <p style="margin-top: 10px;"><a class="link-cta" href="{{ shop.refund_policy.url }}"><span>View Returns &amp; Refund Policy</span>{% render 'icons', icon: 'arrow-right' %}</a></p>
                    {% endif %}
                  </div>
                </details>
              {% endfor %}
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact & FAQ",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Customer Care" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Contact & Frequently Asked Questions" },
    { "type": "textarea", "id": "intro", "label": "Intro copy", "default": "Have a question about a saree weave, fabric care or an existing order? Send us a note and our team in Anantapur will get back to you." },
    { "type": "header", "content": "Contact Form" },
    { "type": "text", "id": "form_heading", "label": "Form heading", "default": "Send Us a Message" },
    { "type": "text", "id": "submit_label", "label": "Submit button label", "default": "Send Message" },
    { "type": "text", "id": "success_message", "label": "Success confirmation", "default": "Thank you for writing to Vedajanani Vastralayam. We have received your message and will reply shortly." },
    { "type": "header", "content": "Verified Store Details (Optional)" },
    { "type": "text", "id": "details_heading", "label": "Details heading", "default": "Store Details" },
    { "type": "text", "id": "address", "label": "Store location", "default": "Anantapur, Andhra Pradesh, India" },
    { "type": "text", "id": "phone", "label": "Phone number (leave blank to hide)" },
    { "type": "text", "id": "email", "label": "Support email (leave blank to hide)" },
    { "type": "text", "id": "hours", "label": "Store hours (leave blank to hide)" },
    { "type": "header", "content": "FAQ Section" },
    { "type": "text", "id": "faq_heading", "label": "FAQ heading", "default": "Frequently Asked Questions" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 24, "max": 88, "step": 8, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 32, "max": 96, "step": 8, "unit": "px", "default": 72 }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Question",
      "settings": [
        { "type": "text", "id": "category", "label": "Group label (e.g. Fabric & Care, Shipping)", "default": "Fabrics & Care" },
        { "type": "text", "id": "question", "label": "Question", "default": "How do I find the exact length, fabric and blouse details of a saree?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Each saree page displays its verified specifications — including fabric, weave, length, blouse piece details and care notes — directly below the purchase options. If you would like additional photographs of the pallu or border, please reach out before ordering.</p>" },
        {
          "type": "select",
          "id": "policy_link",
          "label": "Attach Shopify policy link",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "shipping", "label": "Shipping Policy" },
            { "value": "refund", "label": "Returns & Refund Policy" }
          ],
          "default": "none"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "faq_item",
        "settings": {
          "category": "Saree Details",
          "question": "Where can I check fabric, length and blouse piece details?",
          "answer": "<p>Every saree lists its verified specifications directly on the product page. Because handloom and curated textiles vary by weave, we list details per saree rather than assuming one universal specification.</p>"
        }
      },
      {
        "type": "faq_item",
        "settings": {
          "category": "Fabric Care",
          "question": "How should I care for Cotton, Silk, Chiffon and Georgette sarees?",
          "answer": "<p>Care depends on the individual fabric and zari or print finish. Please follow the care instructions shown on each saree page, and air silk and zari weaves in shade before folding in breathable cotton cloth.</p>"
        }
      },
      {
        "type": "faq_item",
        "settings": {
          "category": "Shipping",
          "question": "How are shipping rates and delivery timelines calculated?",
          "answer": "<p>Available delivery options and shipping charges for your PIN code are shown transparently at checkout before you confirm payment.</p>",
          "policy_link": "shipping"
        }
      },
      {
        "type": "faq_item",
        "settings": {
          "category": "Returns",
          "question": "What is your returns and exchange policy?",
          "answer": "<p>Please review our published Returns &amp; Refund Policy for eligibility, timelines and assistance with damaged or incorrect items.</p>",
          "policy_link": "refund"
        }
      }
    ]
  }
}
{% endschema %}
