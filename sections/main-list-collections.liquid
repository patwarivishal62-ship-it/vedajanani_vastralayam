{% style %}
  #shopify-section-{{ section.id }} .vv-listcol-sec {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .vv-grid {
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
    gap: {{ section.settings.grid_gap }}px;
  }
  #shopify-section-{{ section.id }} .vv-tile {
    border-radius: {{ section.settings.card_radius }}px;
    min-height: {{ section.settings.card_height }}px;
  }
  @media (max-width: 900px) {
    #shopify-section-{{ section.id }} .vv-grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, minmax(0, 1fr));
    }
  }
{% endstyle %}

<section class="vv-listcol-sec">
  <div class="wrap">
    <div class="section-head section-head--{{ section.settings.header_align }}">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h1 style="font-size: {{ section.settings.heading_size }}px;">{{ section.settings.heading }}</h1>
    </div>

    {% paginate collections by 24 %}
      <div class="vv-grid">
        {% for col in collections %}
          {%- assign col_img = col.featured_image -%}
          <a class="vv-tile{% if col_img != blank %} vv-tile--overlay{% endif %}" href="{{ col.url }}" style="justify-content: flex-end; text-align: center;">
            {% if col_img != blank %}
              <div class="vv-tile-media">
                <img src="{{ col_img | image_url: width: 900 }}" alt="{{ col.title | escape }}" width="600" height="750" loading="lazy">
              </div>
              <div class="vv-tile-overlay" style="background: #000000; opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>
            {% endif %}
            <div class="vv-tile-body">
              <h2 class="vv-tile-title" style="font-size: 24px;">{{ col.title }}</h2>
              {% if section.settings.show_count %}
                <p class="vv-tile-sub">{{ col.products_count }} sarees</p>
              {% endif %}
            </div>
          </a>
        {% endfor %}
      </div>

      {% if paginate.pages > 1 %}
        <nav class="pagination" aria-label="Pagination">{{ paginate | default_pagination }}</nav>
      {% endif %}
    {% endpaginate %}
  </div>
</section>

{% schema %}
{
  "name": "Collections List",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Vedajanani Vastralayam"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "All Collections"
    },
    {
      "type": "text_alignment",
      "id": "header_align",
      "label": "Header alignment",
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 24,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns (mobile)",
      "min": 1,
      "max": 2,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Grid gap",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "card_height",
      "label": "Card min height",
      "min": 160,
      "max": 520,
      "step": 20,
      "unit": "px",
      "default": 280
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 36,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image overlay opacity",
      "min": 0,
      "max": 85,
      "step": 5,
      "unit": "%",
      "default": 35
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Show product count",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 16,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 16,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ]
}
{% endschema %}
