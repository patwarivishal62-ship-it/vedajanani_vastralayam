<section class="account-sec">
  <div class="wrap account-wide">
    <div class="account-top-bar">
      <div>
        <span class="eyebrow">Order Summary</span>
        <h1>Order {{ order.name }}</h1>
        <p class="account-sub" style="margin: 6px 0 0;">Placed on {{ order.created_at | date: '%b %d, %Y' }}</p>
      </div>
      <a href="{{ routes.account_url }}" class="btn outline">Back to Account</a>
    </div>

    <div class="account-card">
      <div class="account-table-wrap">
        <table class="account-table">
          <thead>
            <tr>
              <th>Saree / Item</th>
              <th>Quantity</th>
              <th>Total</th>
            </tr>
          </thead>
          <tbody>
            {% for line_item in order.line_items %}
              <tr>
                <td>{{ line_item.title }}</td>
                <td>{{ line_item.quantity }}</td>
                <td>{{ line_item.final_line_price | money }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      <div class="order-total-row">
        <span>Order Total</span>
        <strong>{{ order.total_price | money }}</strong>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Customer Order",
  "settings": []
}
{% endschema %}
