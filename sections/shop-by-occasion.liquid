{% style %}
  #shopify-section-{{ section.id }} .vv-occ-sec {
    {% if section.settings.bg_color != blank and section.settings.bg_color != 'rgba(0,0,0,0)' %}
      background: {{ section.settings.bg_color }};
    {% endif %}
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .vv-grid {
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
    gap: {{ section.settings.grid_gap }}px;
  }
  #shopify-section-{{ section.id }} .vv-tile {
    border-radius: {{ section.settings.card_radius }}px;
    background: {{ section.settings.card_bg }};
    color: {{ section.settings.card_text }};
    min-height: {{ section.settings.card_height_desktop }}px;
    text-align: {{ section.settings.card_align }};
  }
  #shopify-section-{{ section.id }} .vv-tile-title {
    font-size: {{ section.settings.title_size }}px;
  }
  @media (max-width: 900px) {
    #shopify-section-{{ section.id }} .vv-occ-sec {
      padding-top: 44px;
      padding-bottom: 44px;
    }
    #shopify-section-{{ section.id }} .vv-grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, minmax(0, 1fr));
      gap: 12px;
    }
    #shopify-section-{{ section.id }} .vv-tile {
      min-height: {{ section.settings.card_height_mobile }}px;
    }
  }
{% endstyle %}

<section class="vv-occ-sec">
  <div class="wrap">
    {% if section.settings.eyebrow != blank or section.settings.heading != blank %}
      <div class="section-head section-head--{{ section.settings.heading_align }}">
        {% if section.settings.eyebrow != blank %}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 style="font-size: {{ section.settings.heading_size }}px; color: {{ section.settings.heading_color }};">
            {{ section.settings.heading }}
          </h2>
        {% endif %}
      </div>
    {% endif %}

    <div class="vv-grid">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          {%- liquid
            assign col = block.settings.collection
            assign tile_img = block.settings.image
            if tile_img == blank and col != blank
              assign tile_img = col.featured_image
            endif
            assign tile_href = block.settings.url
            if tile_href == blank and col != blank
              assign tile_href = col.url
            endif
            if tile_href == blank
              assign tile_href = block.settings.fallback_path | default: routes.all_products_collection_url
            endif
            assign ov_alpha = block.settings.overlay_opacity | divided_by: 100.0
          -%}
          <a
            class="vv-tile vv-tile--occasion{% if tile_img != blank %} vv-tile--overlay{% endif %}"
            href="{{ tile_href }}"
            style="
              {% if block.settings.card_bg != blank and block.settings.card_bg != 'rgba(0,0,0,0)' %}background: {{ block.settings.card_bg }};{% endif %}
              {% if block.settings.text_color != blank and block.settings.text_color != 'rgba(0,0,0,0)' %}color: {{ block.settings.text_color }};{% endif %}
            "
            {{ block.shopify_attributes }}
          >
            {% if tile_img != blank %}
              <div class="vv-tile-media">
                <img src="{{ tile_img | image_url: width: 900 }}" alt="{{ tile_img.alt | default: block.settings.title | escape }}" width="600" height="750" loading="lazy">
              </div>
              <div class="vv-tile-overlay" style="background: #141A16; opacity: {{ ov_alpha }};"></div>
            {% endif %}
            <div class="vv-tile-body">
              <div class="vv-tile-heading-row">
                <h3 class="vv-tile-title">{{ block.settings.title }}</h3>
                <span class="vv-tile-arrow" aria-hidden="true">{% render 'icons', icon: 'arrow-right' %}</span>
              </div>
              {% if block.settings.subtitle != blank %}
                <p class="vv-tile-sub">{{ block.settings.subtitle }}</p>
              {% endif %}
            </div>
          </a>
        {% endfor %}
      {% else %}
        <a class="vv-tile vv-tile--occasion" href="{{ routes.collections_url }}/daily-use"><div class="vv-tile-body"><div class="vv-tile-heading-row"><h3 class="vv-tile-title">Everyday</h3><span class="vv-tile-arrow" aria-hidden="true">{% render 'icons', icon: 'arrow-right' %}</span></div><p class="vv-tile-sub">Breathable cottons &amp; light prints</p></div></a>
        <a class="vv-tile vv-tile--occasion" href="{{ routes.collections_url }}/office"><div class="vv-tile-body"><div class="vv-tile-heading-row"><h3 class="vv-tile-title">Office</h3><span class="vv-tile-arrow" aria-hidden="true">{% render 'icons', icon: 'arrow-right' %}</span></div><p class="vv-tile-sub">Crisp, composed drapes for workdays</p></div></a>
        <a class="vv-tile vv-tile--occasion" href="{{ routes.collections_url }}/festive"><div class="vv-tile-body"><div class="vv-tile-heading-row"><h3 class="vv-tile-title">Festive</h3><span class="vv-tile-arrow" aria-hidden="true">{% render 'icons', icon: 'arrow-right' %}</span></div><p class="vv-tile-sub">Zari borders &amp; celebratory tones</p></div></a>
        <a class="vv-tile vv-tile--occasion" href="{{ routes.collections_url }}/wedding"><div class="vv-tile-body"><div class="vv-tile-heading-row"><h3 class="vv-tile-title">Wedding</h3><span class="vv-tile-arrow" aria-hidden="true">{% render 'icons', icon: 'arrow-right' %}</span></div><p class="vv-tile-sub">Brides, family &amp; ceremony guests</p></div></a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop by Occasion",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "By Occasion" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by Occasion" },
    { "type": "text_alignment", "id": "heading_align", "label": "Header alignment", "default": "center" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 24, "max": 48, "step": 2, "unit": "px", "default": 36 },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#202521" },
    { "type": "header", "content": "Grid & Cards" },
    { "type": "range", "id": "columns_desktop", "label": "Columns (desktop)", "min": 2, "max": 5, "step": 1, "default": 4 },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns (mobile)",
      "options": [
        { "value": "1", "label": "1 column" },
        { "value": "2", "label": "2 columns" }
      ],
      "default": "2"
    },
    { "type": "range", "id": "grid_gap", "label": "Grid gap (desktop)", "min": 12, "max": 36, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "card_height_desktop", "label": "Card min height (desktop)", "min": 140, "max": 440, "step": 20, "unit": "px", "default": 180 },
    { "type": "range", "id": "card_height_mobile", "label": "Card min height (mobile)", "min": 120, "max": 320, "step": 20, "unit": "px", "default": 140 },
    { "type": "range", "id": "card_radius", "label": "Card corner radius", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 12 },
    { "type": "range", "id": "title_size", "label": "Card title size", "min": 16, "max": 28, "step": 1, "unit": "px", "default": 20 },
    { "type": "text_alignment", "id": "card_align", "label": "Card text alignment", "default": "left" },
    { "type": "color", "id": "card_bg", "label": "Default card background", "default": "#FFFFFF" },
    { "type": "color", "id": "card_text", "label": "Default card text color", "default": "#202521" },
    { "type": "header", "content": "Section Spacing" },
    { "type": "color", "id": "bg_color", "label": "Section background (optional)" },
    { "type": "range", "id": "padding_top", "label": "Top padding (desktop)", "min": 32, "max": 96, "step": 8, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding (desktop)", "min": 32, "max": 96, "step": 8, "unit": "px", "default": 72 }
  ],
  "blocks": [
    {
      "type": "occasion",
      "name": "Occasion Card",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Custom cover image (optional)" },
        { "type": "range", "id": "overlay_opacity", "label": "Image overlay opacity", "min": 0, "max": 85, "step": 5, "unit": "%", "default": 40 },
        { "type": "text", "id": "title", "label": "Title", "default": "Festive" },
        { "type": "text", "id": "subtitle", "label": "Subtitle (optional)" },
        { "type": "url", "id": "url", "label": "Custom link" },
        { "type": "text", "id": "fallback_path", "label": "Fallback path", "default": "/collections/festive" },
        { "type": "color", "id": "card_bg", "label": "Custom card background" },
        { "type": "color", "id": "text_color", "label": "Custom text color" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by Occasion",
      "blocks": [
        { "type": "occasion", "settings": { "title": "Everyday", "subtitle": "Breathable cottons & light prints", "fallback_path": "/collections/daily-use" } },
        { "type": "occasion", "settings": { "title": "Office", "subtitle": "Crisp drapes for workdays", "fallback_path": "/collections/office" } },
        { "type": "occasion", "settings": { "title": "Festive", "subtitle": "Zari borders & celebratory tones", "fallback_path": "/collections/festive" } },
        { "type": "occasion", "settings": { "title": "Wedding", "subtitle": "Brides, family & ceremony guests", "fallback_path": "/collections/wedding" } }
      ]
    }
  ]
}
{% endschema %}
