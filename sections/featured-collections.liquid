{% style %}
  #shopify-section-{{ section.id }} .vv-fcol-sec {
    {% if section.settings.bg_color != blank and section.settings.bg_color != 'rgba(0,0,0,0)' %}
      background: {{ section.settings.bg_color }};
    {% endif %}
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .vv-grid {
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
    gap: {{ section.settings.grid_gap }}px;
  }
  #shopify-section-{{ section.id }} .vv-tile {
    border-radius: {{ section.settings.card_radius }}px;
    background: {{ section.settings.card_bg }};
    color: {{ section.settings.card_text }};
    min-height: {{ section.settings.card_height_desktop }}px;
    text-align: {{ section.settings.card_align }};
  }
  #shopify-section-{{ section.id }} .vv-tile-title {
    font-size: {{ section.settings.card_title_size }}px;
  }
  @media (max-width: 900px) {
    #shopify-section-{{ section.id }} .vv-grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, minmax(0, 1fr));
    }
    #shopify-section-{{ section.id }} .vv-tile {
      min-height: {{ section.settings.card_height_mobile }}px;
    }
  }
{% endstyle %}

<section class="vv-fcol-sec">
  <div class="wrap">
    {% if section.settings.eyebrow != blank or section.settings.heading != blank %}
      <div class="section-head section-head--{{ section.settings.heading_align }}">
        {% if section.settings.eyebrow != blank %}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 style="font-size: {{ section.settings.heading_size }}px; color: {{ section.settings.heading_color }};">
            {{ section.settings.heading }}
          </h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p class="section-sub">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="vv-grid">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          {%- liquid
            assign col = block.settings.collection
            assign col_img = block.settings.image
            if col_img == blank and col != blank
              assign col_img = col.featured_image
            endif
            assign col_title = block.settings.title
            if col_title == blank and col != blank
              assign col_title = col.title
            endif
            assign col_href = block.settings.url
            if col_href == blank and col != blank
              assign col_href = col.url
            endif
            if col_href == blank
              assign col_href = block.settings.fallback_path | default: routes.all_products_collection_url
            endif
            assign ov_alpha = block.settings.overlay_opacity | divided_by: 100.0
          -%}
          <a
            class="vv-tile{% if col_img != blank and section.settings.card_style == 'overlay' %} vv-tile--overlay{% endif %}"
            href="{{ col_href }}"
            style="
              {% if block.settings.card_bg != blank and block.settings.card_bg != 'rgba(0,0,0,0)' %}background: {{ block.settings.card_bg }};{% endif %}
              {% if block.settings.text_color != blank and block.settings.text_color != 'rgba(0,0,0,0)' %}color: {{ block.settings.text_color }};{% endif %}
            "
            {{ block.shopify_attributes }}
          >
            {% if col_img != blank %}
              <div class="vv-tile-media" style="{% unless section.settings.card_style == 'overlay' %}aspect-ratio: {{ section.settings.image_ratio }};{% endunless %}">
                <img
                  src="{{ col_img | image_url: width: 900 }}"
                  alt="{{ col_img.alt | default: col_title | escape }}"
                  style="object-position: {{ block.settings.focal_point }};"
                  width="600"
                  height="750"
                  loading="lazy"
                >
              </div>
              {% if section.settings.card_style == 'overlay' %}
                <div class="vv-tile-overlay" style="background: #000000; opacity: {{ ov_alpha }};"></div>
              {% endif %}
            {% endif %}
            <div class="vv-tile-body" style="padding: {{ section.settings.card_pad }}px;">
              {% if block.settings.badge != blank %}
                <span class="vv-tile-badge">{{ block.settings.badge }}</span>
              {% endif %}
              <h3 class="vv-tile-title">{{ col_title }}</h3>
              {% if block.settings.subtitle != blank %}
                <p class="vv-tile-sub">{{ block.settings.subtitle }}</p>
              {% endif %}
            </div>
          </a>
        {% endfor %}
      {% elsif section.settings.collections != blank %}
        {% for col in section.settings.collections %}
          <a class="vv-tile{% if col.featured_image != blank and section.settings.card_style == 'overlay' %} vv-tile--overlay{% endif %}" href="{{ col.url }}">
            {% if col.featured_image != blank %}
              <div class="vv-tile-media" style="{% unless section.settings.card_style == 'overlay' %}aspect-ratio: {{ section.settings.image_ratio }};{% endunless %}">
                <img src="{{ col.featured_image | image_url: width: 900 }}" alt="{{ col.title | escape }}" width="600" height="750" loading="lazy">
              </div>
              {% if section.settings.card_style == 'overlay' %}
                <div class="vv-tile-overlay" style="background: #000000; opacity: 0.3;"></div>
              {% endif %}
            {% endif %}
            <div class="vv-tile-body" style="padding: {{ section.settings.card_pad }}px;">
              <h3 class="vv-tile-title">{{ col.title }}</h3>
            </div>
          </a>
        {% endfor %}
      {% else %}
        <a class="vv-tile" href="{{ routes.collections_url }}/cotton" style="justify-content:center;"><div class="vv-tile-body"><span class="vv-tile-badge">9 Weaves</span><h3 class="vv-tile-title">Cotton</h3><p class="vv-tile-sub">Mul, Madurai, Kanchi, Kota & Jamdhani</p></div></a>
        <a class="vv-tile" href="{{ routes.collections_url }}/silk" style="justify-content:center;"><div class="vv-tile-body"><span class="vv-tile-badge">8 Weaves</span><h3 class="vv-tile-title">Silk</h3><p class="vv-tile-sub">Banarasi, Soft, Crepe & Viscose Silk</p></div></a>
        <a class="vv-tile" href="{{ routes.collections_url }}/chiffon" style="justify-content:center;"><div class="vv-tile-body"><span class="vv-tile-badge">5 Styles</span><h3 class="vv-tile-title">Chiffon</h3><p class="vv-tile-sub">Printed, Embroidered, Bandhani & Floral</p></div></a>
        <a class="vv-tile" href="{{ routes.collections_url }}/georgette" style="justify-content:center;"><div class="vv-tile-body"><span class="vv-tile-badge">5 Styles</span><h3 class="vv-tile-title">Georgette</h3><p class="vv-tile-sub">Satin, Printed, Bandhani & Plain</p></div></a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Collections",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "By Fabric"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Collection"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading (optional)"
    },
    {
      "type": "text_alignment",
      "id": "heading_align",
      "label": "Header alignment",
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 20,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 34
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1C1C1C"
    },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "Quick collection list (used if no Collection Card blocks added)"
    },
    {
      "type": "header",
      "content": "Grid & Card Styling"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Card layout when image is set",
      "options": [
        {
          "value": "overlay",
          "label": "Text overlaid on image"
        },
        {
          "value": "below",
          "label": "Text below image"
        }
      ],
      "default": "overlay"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image aspect ratio (text-below mode)",
      "options": [
        {
          "value": "3 / 4",
          "label": "Portrait (3:4)"
        },
        {
          "value": "4 / 5",
          "label": "Editorial (4:5)"
        },
        {
          "value": "1 / 1",
          "label": "Square (1:1)"
        },
        {
          "value": "4 / 3",
          "label": "Landscape (4:3)"
        }
      ],
      "default": "3 / 4"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns (mobile)",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        },
        {
          "value": "3",
          "label": "3 columns"
        }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Grid gap",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "card_height_desktop",
      "label": "Card min height (desktop)",
      "min": 140,
      "max": 580,
      "step": 20,
      "unit": "px",
      "default": 240
    },
    {
      "type": "range",
      "id": "card_height_mobile",
      "label": "Card min height (mobile)",
      "min": 120,
      "max": 420,
      "step": 20,
      "unit": "px",
      "default": 180
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 36,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "card_pad",
      "label": "Card padding",
      "min": 12,
      "max": 44,
      "step": 2,
      "unit": "px",
      "default": 26
    },
    {
      "type": "range",
      "id": "card_title_size",
      "label": "Card title size",
      "min": 14,
      "max": 36,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "text_alignment",
      "id": "card_align",
      "label": "Card text alignment",
      "default": "center"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Default card background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "card_text",
      "label": "Default card text color",
      "default": "#1C1C1C"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background (optional)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection Card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom cover image (optional)"
        },
        {
          "type": "select",
          "id": "focal_point",
          "label": "Image focal point",
          "options": [
            {
              "value": "center center",
              "label": "Center"
            },
            {
              "value": "top center",
              "label": "Top"
            },
            {
              "value": "bottom center",
              "label": "Bottom"
            }
          ],
          "default": "center center"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "label": "Image overlay opacity",
          "min": 0,
          "max": 85,
          "step": 5,
          "unit": "%",
          "default": 35
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Small eyebrow badge"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title (overrides collection title)"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle / weaves list"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Custom link"
        },
        {
          "type": "text",
          "id": "fallback_path",
          "label": "Fallback path",
          "default": "/collections/all"
        },
        {
          "type": "color",
          "id": "card_bg",
          "label": "Custom card background (optional)"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Custom text color (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Collections",
      "blocks": [
        {
          "type": "collection_card",
          "settings": {
            "badge": "9 Weaves",
            "title": "Cotton",
            "subtitle": "Mul, Madurai, Kanchi, Kota & Jamdhani",
            "fallback_path": "/collections/cotton"
          }
        },
        {
          "type": "collection_card",
          "settings": {
            "badge": "8 Weaves",
            "title": "Silk",
            "subtitle": "Banarasi, Soft, Crepe & Viscose Silk",
            "fallback_path": "/collections/silk"
          }
        },
        {
          "type": "collection_card",
          "settings": {
            "badge": "5 Styles",
            "title": "Chiffon",
            "subtitle": "Printed, Embroidered, Bandhani & Floral",
            "fallback_path": "/collections/chiffon"
          }
        },
        {
          "type": "collection_card",
          "settings": {
            "badge": "5 Styles",
            "title": "Georgette",
            "subtitle": "Satin, Printed, Bandhani & Plain",
            "fallback_path": "/collections/georgette"
          }
        }
      ]
    }
  ]
}
{% endschema %}
