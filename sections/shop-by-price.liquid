{% style %}
  #shopify-section-{{ section.id }} .vv-price-sec {
    {% if section.settings.bg_color != blank and section.settings.bg_color != 'rgba(0,0,0,0)' %}
      background: {{ section.settings.bg_color }};
    {% endif %}
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .vv-grid {
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
    gap: {{ section.settings.grid_gap }}px;
  }
  #shopify-section-{{ section.id }} .price-tier-card {
    border-radius: {{ section.settings.card_radius }}px;
    background: {{ section.settings.card_bg }};
    color: {{ section.settings.card_text }};
    border-color: {{ section.settings.card_border }};
    padding: {{ section.settings.card_pad }}px;
    text-align: {{ section.settings.card_align }};
  }
  #shopify-section-{{ section.id }} .price-tier-title {
    font-size: {{ section.settings.tier_title_size }}px;
    margin: 6px 0;
  }
  #shopify-section-{{ section.id }} .price-tier-range {
    font-family: var(--font-accent);
    font-size: {{ section.settings.tier_price_size }}px;
    color: {{ section.settings.accent_color }};
    font-weight: 600;
    margin-bottom: 8px;
  }
  @media (max-width: 900px) {
    #shopify-section-{{ section.id }} .vv-grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, minmax(0, 1fr));
    }
  }
{% endstyle %}

<section class="vv-price-sec">
  <div class="wrap">
    {% if section.settings.eyebrow != blank or section.settings.heading != blank %}
      <div class="section-head section-head--{{ section.settings.heading_align }}">
        {% if section.settings.eyebrow != blank %}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 style="font-size: {{ section.settings.heading_size }}px; color: {{ section.settings.heading_color }};">
            {{ section.settings.heading }}
          </h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p class="section-sub">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="vv-grid">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          {%- assign tier_href = block.settings.url | default: block.settings.collection.url | default: block.settings.fallback_path | default: routes.all_products_collection_url -%}
          <a
            class="price-tier-card"
            href="{{ tier_href }}"
            style="
              {% if block.settings.card_bg != blank and block.settings.card_bg != 'rgba(0,0,0,0)' %}background: {{ block.settings.card_bg }};{% endif %}
              {% if block.settings.text_color != blank and block.settings.text_color != 'rgba(0,0,0,0)' %}color: {{ block.settings.text_color }};{% endif %}
            "
            {{ block.shopify_attributes }}
          >
            <div>
              {% if block.settings.image != blank %}
                <div style="margin-bottom: 16px; overflow: hidden; border-radius: {{ section.settings.card_radius | minus: 4 | at_least: 0 }}px; aspect-ratio: 16 / 10;">
                  <img src="{{ block.settings.image | image_url: width: 700 }}" alt="{{ block.settings.title | escape }}" style="width:100%; height:100%; object-fit:cover; border-radius:0;" width="600" height="375" loading="lazy">
                </div>
              {% endif %}
              {% if block.settings.badge != blank %}
                <span class="eyebrow">{{ block.settings.badge }}</span>
              {% endif %}
              <h3 class="price-tier-title">{{ block.settings.title }}</h3>
              {% if block.settings.price_range != blank %}
                <div class="price-tier-range">{{ block.settings.price_range }}</div>
              {% endif %}
              {% if block.settings.description != blank %}
                <p style="font-size: 13px; opacity: 0.8; margin-bottom: 16px;">{{ block.settings.description }}</p>
              {% endif %}
            </div>
            {% if block.settings.cta_label != blank %}
              <div><span class="link-cta">{{ block.settings.cta_label }} →</span></div>
            {% endif %}
          </a>
        {% endfor %}
      {% else %}
        <a class="price-tier-card" href="{{ routes.collections_url }}/affordable"><div><span class="eyebrow">Daily Use</span><h3 class="price-tier-title">Affordable</h3><div class="price-tier-range">₹500 – ₹1,500</div></div><div><span class="link-cta">Explore →</span></div></a>
        <a class="price-tier-card" href="{{ routes.collections_url }}/mid-range"><div><span class="eyebrow">Most Loved</span><h3 class="price-tier-title">Mid Range</h3><div class="price-tier-range">₹1,500 – ₹3,000</div></div><div><span class="link-cta">Explore →</span></div></a>
        <a class="price-tier-card" href="{{ routes.collections_url }}/premium"><div><span class="eyebrow">Heirloom & Festive</span><h3 class="price-tier-title">Premium</h3><div class="price-tier-range">₹3,000 – ₹5,000</div></div><div><span class="link-cta">Explore →</span></div></a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop by Price",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Curated For Every Budget"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Price"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading (optional)"
    },
    {
      "type": "text_alignment",
      "id": "heading_align",
      "label": "Header alignment",
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 20,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 34
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1C1C1C"
    },
    {
      "type": "header",
      "content": "Grid & Card Styling"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns (desktop)",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns (mobile)",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Grid gap",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "card_pad",
      "label": "Card padding",
      "min": 16,
      "max": 52,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 36,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "text_alignment",
      "id": "card_align",
      "label": "Card text alignment",
      "default": "center"
    },
    {
      "type": "range",
      "id": "tier_title_size",
      "label": "Tier title size",
      "min": 16,
      "max": 38,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "tier_price_size",
      "label": "Price range font size",
      "min": 14,
      "max": 36,
      "step": 1,
      "unit": "px",
      "default": 22
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "card_text",
      "label": "Card text color",
      "default": "#1C1C1C"
    },
    {
      "type": "color",
      "id": "card_border",
      "label": "Card border color",
      "default": "#E5DFD5"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Price highlight color",
      "default": "#5C1A24"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background (optional)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Price Tier",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Optional image"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Tag / badge",
          "default": "Daily Use"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Tier title",
          "default": "Affordable"
        },
        {
          "type": "text",
          "id": "price_range",
          "label": "Price range",
          "default": "₹500 – ₹1,500"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Short description",
          "default": "Breathable cottons & effortless everyday drapes."
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Link label",
          "default": "Shop Tier"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Linked collection"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Custom link (overrides collection)"
        },
        {
          "type": "text",
          "id": "fallback_path",
          "label": "Fallback path",
          "default": "/collections/all"
        },
        {
          "type": "color",
          "id": "card_bg",
          "label": "Custom card background (optional)"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Custom text color (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by Price",
      "blocks": [
        {
          "type": "tier",
          "settings": {
            "badge": "Daily Use",
            "title": "Affordable",
            "price_range": "₹500 – ₹1,500",
            "description": "Breathable cottons & effortless everyday drapes.",
            "fallback_path": "/collections/affordable"
          }
        },
        {
          "type": "tier",
          "settings": {
            "badge": "Most Loved",
            "title": "Mid Range",
            "price_range": "₹1,500 – ₹3,000",
            "description": "Office-ready weaves, printed chiffons & soft silks.",
            "fallback_path": "/collections/mid-range"
          }
        },
        {
          "type": "tier",
          "settings": {
            "badge": "Heirloom & Festive",
            "title": "Premium",
            "price_range": "₹3,000 – ₹5,000",
            "description": "Banarasi, Kanchi & wedding celebration drapes.",
            "fallback_path": "/collections/premium"
          }
        }
      ]
    }
  ]
}
{% endschema %}
