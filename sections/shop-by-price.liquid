{% style %}
  #shopify-section-{{ section.id }} .vv-price-sec {
    {% if section.settings.bg_color != blank and section.settings.bg_color != 'rgba(0,0,0,0)' %}
      background: {{ section.settings.bg_color }};
    {% endif %}
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .vv-grid {
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
    gap: {{ section.settings.grid_gap }}px;
  }
  #shopify-section-{{ section.id }} .price-tier {
    background: {{ section.settings.card_bg }};
    color: {{ section.settings.card_text }};
    border: {{ section.settings.card_border_w }}px solid {{ section.settings.card_border_color }};
    border-top: 2px solid var(--gold);
    border-radius: {{ section.settings.card_radius }}px;
    padding: {{ section.settings.card_pad_y }}px {{ section.settings.card_pad_x }}px;
    text-align: {{ section.settings.card_align }};
  }
  #shopify-section-{{ section.id }} .price-tier-range {
    font-size: {{ section.settings.range_font_size }}px;
    color: {{ section.settings.range_color }};
  }
  @media (max-width: 900px) {
    #shopify-section-{{ section.id }} .vv-price-sec {
      padding-top: 44px;
      padding-bottom: 44px;
    }
    #shopify-section-{{ section.id }} .vv-grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, minmax(0, 1fr));
      gap: 14px;
    }
  }
{% endstyle %}

<section class="vv-price-sec">
  <div class="wrap">
    {% if section.settings.eyebrow != blank or section.settings.heading != blank %}
      <div class="section-head section-head--{{ section.settings.heading_align }}">
        {% if section.settings.eyebrow != blank %}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 style="font-size: {{ section.settings.heading_size }}px; color: {{ section.settings.heading_color }};">
            {{ section.settings.heading }}
          </h2>
        {% endif %}
      </div>
    {% endif %}

    <div class="vv-grid">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          {%- assign tier_href = block.settings.url | default: block.settings.collection.url | default: block.settings.fallback_path | default: routes.all_products_collection_url -%}
          <a
            class="price-tier"
            href="{{ tier_href }}"
            style="
              {% if block.settings.card_bg != blank and block.settings.card_bg != 'rgba(0,0,0,0)' %}background: {{ block.settings.card_bg }};{% endif %}
              {% if block.settings.text_color != blank and block.settings.text_color != 'rgba(0,0,0,0)' %}color: {{ block.settings.text_color }};{% endif %}
            "
            {{ block.shopify_attributes }}
          >
            {% if block.settings.eyebrow != blank %}
              <span class="eyebrow" style="margin-bottom: 10px;">{{ block.settings.eyebrow }}</span>
            {% endif %}
            <strong class="price-tier-range">{{ block.settings.price_range }}</strong>
            {% if block.settings.subtitle != blank %}
              <span class="price-tier-sub">{{ block.settings.subtitle }}</span>
            {% endif %}
            {% if block.settings.cta_label != blank %}
              <span class="link-cta"><span>{{ block.settings.cta_label }}</span>{% render 'icons', icon: 'arrow-right' %}</span>
            {% endif %}
          </a>
        {% endfor %}
      {% else %}
        <a class="price-tier" href="{{ routes.collections_url }}/affordable">
          <span class="eyebrow">Affordable</span>
          <strong class="price-tier-range">₹500 – ₹1,499</strong>
          <span class="price-tier-sub">Everyday cottons, chiffons &amp; light prints</span>
          <span class="link-cta"><span>Shop Range</span>{% render 'icons', icon: 'arrow-right' %}</span>
        </a>
        <a class="price-tier" href="{{ routes.collections_url }}/mid-range">
          <span class="eyebrow">Mid Range</span>
          <strong class="price-tier-range">₹1,500 – ₹2,999</strong>
          <span class="price-tier-sub">Festive weaves, silk blends &amp; zari borders</span>
          <span class="link-cta"><span>Shop Range</span>{% render 'icons', icon: 'arrow-right' %}</span>
        </a>
        <a class="price-tier" href="{{ routes.collections_url }}/premium">
          <span class="eyebrow">Premium</span>
          <strong class="price-tier-range">₹3,000 &amp; Above</strong>
          <span class="price-tier-sub">Statement occasion &amp; wedding drapes</span>
          <span class="link-cta"><span>Shop Range</span>{% render 'icons', icon: 'arrow-right' %}</span>
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop by Price",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "By Price" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by Price" },
    { "type": "text_alignment", "id": "heading_align", "label": "Header alignment", "default": "center" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 24, "max": 48, "step": 2, "unit": "px", "default": 36 },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#202521" },
    { "type": "header", "content": "Grid & Card Styling" },
    { "type": "range", "id": "columns_desktop", "label": "Columns (desktop)", "min": 1, "max": 4, "step": 1, "default": 3 },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns (mobile)",
      "options": [
        { "value": "1", "label": "1 column" },
        { "value": "2", "label": "2 columns" }
      ],
      "default": "1"
    },
    { "type": "range", "id": "grid_gap", "label": "Grid gap (desktop)", "min": 12, "max": 36, "step": 4, "unit": "px", "default": 24 },
    { "type": "text_alignment", "id": "card_align", "label": "Card alignment", "default": "left" },
    { "type": "range", "id": "card_pad_y", "label": "Card vertical padding", "min": 20, "max": 48, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "card_pad_x", "label": "Card horizontal padding", "min": 16, "max": 40, "step": 4, "unit": "px", "default": 28 },
    { "type": "range", "id": "card_radius", "label": "Card corner radius", "min": 0, "max": 12, "step": 2, "unit": "px", "default": 4 },
    { "type": "range", "id": "card_border_w", "label": "Card border width", "min": 0, "max": 2, "step": 1, "unit": "px", "default": 1 },
    { "type": "color", "id": "card_border_color", "label": "Card border color", "default": "#E3D8C5" },
    { "type": "color", "id": "card_bg", "label": "Card background", "default": "#FFFFFF" },
    { "type": "color", "id": "card_text", "label": "Card text color", "default": "#202521" },
    { "type": "range", "id": "range_font_size", "label": "Price range font size", "min": 20, "max": 36, "step": 2, "unit": "px", "default": 26 },
    { "type": "color", "id": "range_color", "label": "Price range color", "default": "#244737" },
    { "type": "header", "content": "Section Spacing" },
    { "type": "color", "id": "bg_color", "label": "Section background (optional)" },
    { "type": "range", "id": "padding_top", "label": "Top padding (desktop)", "min": 32, "max": 96, "step": 8, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding (desktop)", "min": 32, "max": 96, "step": 8, "unit": "px", "default": 72 }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Price Tier",
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Tier label", "default": "Affordable" },
        { "type": "text", "id": "price_range", "label": "Price range text", "default": "₹500 – ₹1,499" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Everyday cottons, chiffons & light prints" },
        { "type": "text", "id": "cta_label", "label": "Link label", "default": "Shop Range" },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "url", "id": "url", "label": "Custom link (optional)" },
        { "type": "text", "id": "fallback_path", "label": "Fallback path", "default": "/collections/affordable" },
        { "type": "color", "id": "card_bg", "label": "Custom card background" },
        { "type": "color", "id": "text_color", "label": "Custom text color" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by Price",
      "blocks": [
        { "type": "tier", "settings": { "eyebrow": "Affordable", "price_range": "₹500 – ₹1,499", "subtitle": "Everyday cottons, chiffons & light prints", "fallback_path": "/collections/affordable" } },
        { "type": "tier", "settings": { "eyebrow": "Mid Range", "price_range": "₹1,500 – ₹2,999", "subtitle": "Festive weaves, silk blends & zari borders", "fallback_path": "/collections/mid-range" } },
        { "type": "tier", "settings": { "eyebrow": "Premium", "price_range": "₹3,000 & Above", "subtitle": "Statement occasion & wedding drapes", "fallback_path": "/collections/premium" } }
      ]
    }
  ]
}
{% endschema %}
