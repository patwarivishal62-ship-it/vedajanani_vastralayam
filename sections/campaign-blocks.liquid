{% style %}
  #shopify-section-{{ section.id }} .vv-campaigns-sec {
    {% if section.settings.bg_color != blank and section.settings.bg_color != 'rgba(0,0,0,0)' %}
      background: {{ section.settings.bg_color }};
    {% endif %}
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .campaigns-grid {
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
    gap: {{ section.settings.grid_gap }}px;
  }
  #shopify-section-{{ section.id }} .campaign-card {
    min-height: {{ section.settings.height_desktop }}px;
    border-radius: {{ section.settings.card_radius }}px;
  }
  #shopify-section-{{ section.id }} .campaign-card-body {
    padding: {{ section.settings.content_pad }}px;
  }
  #shopify-section-{{ section.id }} .campaign-card-body h3 {
    font-size: {{ section.settings.card_heading_desktop }}px;
    margin: 6px 0 10px;
  }
  #shopify-section-{{ section.id }} .campaign-card-body p {
    font-size: {{ section.settings.card_desc_size }}px;
    margin: 0 0 18px;
  }
  @media (max-width: 900px) {
    #shopify-section-{{ section.id }} .campaigns-grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, minmax(0, 1fr));
    }
    #shopify-section-{{ section.id }} .campaign-card {
      min-height: {{ section.settings.height_mobile }}px;
    }
    #shopify-section-{{ section.id }} .campaign-card-body h3 {
      font-size: {{ section.settings.card_heading_mobile }}px;
    }
  }
{% endstyle %}

<section class="vv-campaigns-sec">
  <div class="{% if section.settings.full_width %}vv-banner-wrap--inset{% else %}wrap{% endif %}">
    {% if section.settings.eyebrow != blank or section.settings.heading != blank %}
      <div class="section-head section-head--{{ section.settings.heading_align }}">
        {% if section.settings.eyebrow != blank %}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 style="font-size: {{ section.settings.heading_size }}px; color: {{ section.settings.heading_color }};">
            {{ section.settings.heading }}
          </h2>
        {% endif %}
      </div>
    {% endif %}

    <div class="campaigns-grid">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          {%- assign ov_alpha = block.settings.overlay_opacity | divided_by: 100.0 -%}
          {%- assign cta_href = block.settings.cta_url | default: block.settings.fallback_path | default: routes.all_products_collection_url -%}
          <article
            class="campaign-card"
            {{ block.shopify_attributes }}
            style="
              background: {{ block.settings.bg_gradient }};
              align-items: {{ block.settings.align_vertical }};
              justify-content: {{ block.settings.align_horizontal }};
              color: {{ block.settings.text_color }};
            "
          >
            {% if block.settings.image != blank %}
              <div class="campaign-card-media">
                <img
                  src="{{ block.settings.image | image_url: width: 1200 }}"
                  alt="{{ block.settings.image.alt | default: block.settings.heading | escape }}"
                  style="object-position: {{ block.settings.focal_point }};"
                  width="1200"
                  height="900"
                  loading="lazy"
                >
              </div>
            {% endif %}
            <div class="campaign-card-overlay" style="background: {{ block.settings.overlay_color }}; opacity: {{ ov_alpha }};"></div>
            <div class="campaign-card-body" style="text-align: {{ block.settings.text_align }};">
              {% if block.settings.kicker != blank %}
                <span class="kicker" style="color: {{ block.settings.kicker_color }};">{{ block.settings.kicker }}</span>
              {% endif %}
              {% if block.settings.heading != blank %}
                <h3>{{ block.settings.heading }}</h3>
              {% endif %}
              {% if block.settings.description != blank %}
                <p>{{ block.settings.description }}</p>
              {% endif %}
              {% if block.settings.cta_label != blank %}
                <a
                  class="{% if block.settings.cta_style == 'solid' %}btn{% elsif block.settings.cta_style == 'outline' %}btn outline{% else %}link-cta{% endif %}"
                  href="{{ cta_href }}"
                  {% if block.settings.cta_style == 'underline' or block.settings.cta_style == 'outline' %}
                    style="color: {{ block.settings.text_color }};"
                  {% endif %}
                >
                  {{ block.settings.cta_label }}{% if block.settings.cta_style == 'underline' %} →{% endif %}
                </a>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      {% else %}
        <article class="campaign-card" style="background: linear-gradient(155deg, #A8492D, #6F2E1B); align-items: flex-end;">
          <div class="campaign-card-body">
            <span class="kicker" style="color: #F4E6CE;">Celebration Curations</span>
            <h3>The Festive Edit</h3>
            <p>Zari cottons, luminous silks and graceful Bandhani drapes.</p>
            <a class="link-cta" href="{{ routes.collections_url }}/festive">Shop Festive →</a>
          </div>
        </article>
        <article class="campaign-card" style="background: linear-gradient(155deg, #244737, #13281F); align-items: flex-end;">
          <div class="campaign-card-body">
            <span class="kicker" style="color: #DFC896;">Timeless Occasions</span>
            <h3>The Wedding Edit</h3>
            <p>Statement weaves curated for brides, family and guests.</p>
            <a class="link-cta" href="{{ routes.collections_url }}/wedding">Shop Wedding →</a>
          </div>
        </article>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Campaign Banners",
  "settings": [
    {
      "type": "header",
      "content": "Section Header (optional)"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
