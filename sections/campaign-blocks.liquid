      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "content_pad",
      "label": "Inner text padding",
      "min": 16,
      "max": 72,
      "step": 4,
      "unit": "px",
      "default": 36
