{% if section.settings.show_bar %}
  {% style %}
    #shopify-section-{{ section.id }} .announcement {
      background: {{ section.settings.bg_color }};
      color: {{ section.settings.text_color }};
      font-size: {{ section.settings.font_size }}px;
      letter-spacing: {{ section.settings.letter_spacing }}px;
      text-transform: {{ section.settings.text_transform }};
      text-align: {{ section.settings.text_alignment }};
    }
    {% if section.settings.sticky_bar %}
      #shopify-section-{{ section.id }} .announcement {
        position: sticky;
        top: 0;
        z-index: 65;
      }
    {% endif %}
  {% endstyle %}

  <div
    class="announcement"
    role="region"
    aria-label="Store announcement"
    data-announcement-bar
    data-autoplay="{{ section.settings.auto_rotate }}"
    data-speed="{{ section.settings.rotate_speed | times: 1000 }}"
  >
    <div class="announcement-inner">
      {% if section.blocks.size > 1 %}
        <button type="button" class="announcement-nav" data-announcement-prev aria-label="Previous announcement">{% render 'icons', icon: 'chevron-left' %}</button>
      {% endif %}

      <div class="announcement-slides">
        {% if section.blocks.size > 0 %}
          {% for block in section.blocks %}
            <p
              class="announcement-slide{% if forloop.first %} is-active{% endif %}"
              {{ block.shopify_attributes }}
            >
              {% if block.settings.link != blank %}
                <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
              {% else %}
                {{ block.settings.text }}
              {% endif %}
            </p>
          {% endfor %}
        {% else %}
          <p class="announcement-slide is-active">{{ section.settings.announcement }}</p>
        {% endif %}
      </div>

      {% if section.blocks.size > 1 %}
        <button type="button" class="announcement-nav" data-announcement-next aria-label="Next announcement">{% render 'icons', icon: 'chevron-right' %}</button>
      {% endif %}

      {% if section.settings.show_close %}
        <button type="button" class="announcement-close" data-announcement-close aria-label="Dismiss announcement">
          {% render 'icons', icon: 'close' %}
        </button>
      {% endif %}
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_bar",
      "label": "Show announcement bar",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_close",
      "label": "Show accessible dismiss button",
      "default": true
    },
    {
      "type": "text",
      "id": "announcement",
      "label": "Fallback text (used if no announcement blocks exist)",
      "default": "Curated Cotton, Silk, Chiffon & Georgette Sarees · Vedajanani Vastralayam"
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "Auto-rotate multiple announcements",
      "default": false
    },
    {
      "type": "range",
      "id": "rotate_speed",
      "label": "Rotation interval",
      "min": 4,
      "max": 12,
      "step": 2,
      "unit": "s",
      "default": 6
    },
    {
      "type": "checkbox",
      "id": "sticky_bar",
      "label": "Keep sticky on scroll",
      "default": false
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#244737"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FAF2E3"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 12,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "label": "Letter spacing",
      "min": 0,
      "max": 3,
      "step": 0.5,
      "unit": "px",
      "default": 0.5
    },
    {
      "type": "select",
      "id": "text_transform",
      "label": "Text case",
      "options": [
        { "value": "none", "label": "Sentence case" },
        { "value": "uppercase", "label": "Uppercase" },
        { "value": "capitalize", "label": "Title case" }
      ],
      "default": "none"
    },
    {
      "type": "text_alignment",
      "id": "text_alignment",
      "label": "Text alignment",
      "default": "center"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Message",
          "default": "Woven with Grace, Worn with Pride · Curated Sarees from Anantapur"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Optional link"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "announcement",
        "settings": {
          "text": "Woven with Grace, Worn with Pride · Curated Sarees from Anantapur"
        }
      }
    ]
  }
}
{% endschema %}
