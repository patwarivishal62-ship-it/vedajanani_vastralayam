<section class="account-sec">
  <div class="wrap account-wide">
    <div class="account-top-bar">
      <div>
        <span class="eyebrow">Account</span>
        <h1>Hello, {{ customer.first_name | default: customer.name }}</h1>
      </div>
      <div class="account-top-actions">
        <a class="btn outline" href="{{ routes.account_addresses_url }}">Addresses ({{ customer.addresses_count }})</a>
        <a class="btn outline" href="{{ routes.account_logout_url }}">Log Out</a>
      </div>
    </div>

    <div class="account-card">
      <h2 class="account-section-title">Order History</h2>

      {% if customer.orders.size == 0 %}
        <div class="empty-state-box" style="margin: 0;">
          <p>You have not placed any orders yet.</p>
          <a class="btn" href="{{ routes.all_products_collection_url }}">Explore Sarees</a>
        </div>
      {% else %}
        <div class="account-table-wrap">
          <table class="account-table">
            <thead>
              <tr>
                <th>Order</th>
                <th>Date</th>
                <th>Payment</th>
                <th>Fulfillment</th>
                <th>Total</th>
              </tr>
            </thead>
            <tbody>
              {% for order in customer.orders %}
                <tr>
                  <td><a href="{{ order.customer_url }}" class="link-cta">{{ order.name }}</a></td>
                  <td>{{ order.created_at | date: '%b %d, %Y' }}</td>
                  <td>{{ order.financial_status_label }}</td>
                  <td>{{ order.fulfillment_status_label }}</td>
                  <td><strong>{{ order.total_price | money }}</strong></td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Customer Account",
  "settings": []
}
{% endschema %}
