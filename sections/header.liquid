{%- liquid
  assign logo_img = section.settings.logo_image | default: settings.logo
  assign account_url = routes.account_login_url
  if customer
    assign account_url = routes.account_url
  endif
  assign shop_all_href = section.settings.shop_all_url | default: routes.all_products_collection_url
  assign mega_blocks = section.blocks | where: 'type', 'mega_column'
  assign nav_blocks = section.blocks | where: 'type', 'nav_link'
  assign use_shopify_menu = false
  if section.settings.menu != blank and section.settings.menu.links.size > 0
    assign use_shopify_menu = true
  endif
  assign has_mega_image = false
  if section.settings.mega_image != blank
    assign has_mega_image = true
  endif
  assign mega_cols_count = mega_blocks.size | at_least: 1 | at_most: 3
  if has_mega_image
    assign mega_cols_count = mega_cols_count | plus: 1
  endif
  assign is_home_active = false
  if request.page_type == 'index'
    assign is_home_active = true
  endif
  assign is_shop_active = false
  if request.page_type == 'collection' or request.page_type == 'product'
    assign is_shop_active = true
  endif
-%}

{% style %}
  #shopify-section-{{ section.id }} .site-header {
    background: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    border-bottom-color: {{ section.settings.border_color }};
    --header-hover: {{ section.settings.hover_color }};
  }
  #shopify-section-{{ section.id }} .logo {
    color: {{ section.settings.text_color }};
  }
  #shopify-section-{{ section.id }} .logo img {
    width: {{ section.settings.logo_width_desktop }}px;
  }
  #shopify-section-{{ section.id }} .logo-name {
    font-size: {{ section.settings.logo_font_size }}px;
    letter-spacing: {{ section.settings.logo_letter_spacing }}px;
  }
  #shopify-section-{{ section.id }} .cart-count {
    background: {{ section.settings.badge_bg }};
    color: {{ section.settings.badge_text }};
  }
  #shopify-section-{{ section.id }} .desktop-menubar {
    background: {{ section.settings.menubar_bg }};
    border-top-color: {{ section.settings.border_color }};
  }
  #shopify-section-{{ section.id }} .desktop-menubar > a,
  #shopify-section-{{ section.id }} .desktop-menubar .shopall-wrap > a {
    font-size: {{ section.settings.nav_font_size }}px;
    letter-spacing: {{ section.settings.nav_letter_spacing }}px;
    text-transform: {{ section.settings.nav_transform }};
    color: {{ section.settings.text_color }};
  }
  #shopify-section-{{ section.id }} .shopall-dropdown {
    background: {{ section.settings.dropdown_bg }};
    min-width: {{ section.settings.dropdown_width }}px;
  }
  #shopify-section-{{ section.id }} .shopall-dropdown .dd-grid {
    grid-template-columns: repeat({{ mega_cols_count }}, minmax(0, 1fr));
  }
  @media (max-width: 1100px) {
    #shopify-section-{{ section.id }} .logo img {
      width: {{ section.settings.logo_width_mobile }}px;
    }
  }
{% endstyle %}

<header class="site-header{% if section.settings.sticky_header %} is-sticky{% endif %}" id="siteHeader">
  <div class="header-inner wrap{% if section.settings.logo_position == 'center' %} header-inner--logo-center{% endif %}">
    {% if section.settings.logo_position == 'center' %}
      <div class="header-left-slot">
        <button class="burger" id="menuDrawerOpen" type="button" aria-label="Open navigation menu" aria-controls="mobileDrawer" aria-expanded="false">{% render 'icons', icon: 'menu' %}</button>
      </div>
    {% else %}
      <button class="burger" id="menuDrawerOpen" type="button" aria-label="Open navigation menu" aria-controls="mobileDrawer" aria-expanded="false">{% render 'icons', icon: 'menu' %}</button>
    {% endif %}

    <a class="logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }} home">
      {% if logo_img != blank %}
        <img
          src="{{ logo_img | image_url: width: 600 }}"
          alt="{{ section.settings.logo_text | default: shop.name | escape }}"
          width="{{ section.settings.logo_width_desktop }}"
          height="{{ section.settings.logo_width_desktop | divided_by: logo_img.aspect_ratio | round }}"
          loading="eager"
        >
      {% else %}
        <span class="logo-name">{{ section.settings.logo_text | default: shop.name }}</span>
        {% if section.settings.logo_subtext != blank %}
          <span class="logo-sub">{{ section.settings.logo_subtext }}</span>
        {% endif %}
      {% endif %}
    </a>

    <div class="header-actions">
      {% if section.settings.show_search %}
        <button class="icon-btn" id="searchOpen" type="button" aria-label="Search store" aria-controls="searchDrawer" aria-expanded="false">
          {% render 'icons', icon: 'search' %}
        </button>
      {% endif %}
      {% if section.settings.show_account %}
        <a class="icon-btn" href="{{ account_url }}" aria-label="{% if customer %}My account{% else %}Sign in to account{% endif %}">
          {% render 'icons', icon: 'account' %}
        </a>
      {% endif %}
      {% if section.settings.show_cart %}
        <button class="icon-btn bag-btn" id="cartOpen" type="button" aria-label="Shopping bag, {{ cart.item_count }} items" aria-controls="cartDrawer" aria-expanded="false">
          {% render 'icons', icon: 'bag' %}
          <span class="cart-count" id="cartCount">{{ cart.item_count }}</span>
        </button>
      {% endif %}
    </div>
  </div>

  <nav class="desktop-menubar" aria-label="Main menu">
    {% if section.settings.show_home_link %}
      <a href="{{ routes.root_url }}" class="{% if is_home_active %}is-active{% endif %}"{% if is_home_active %} aria-current="page"{% endif %}>Home</a>
    {% endif %}

    {% if section.settings.show_shop_all %}
      <span class="shopall-wrap" data-mega-wrap>
        <a
          href="{{ shop_all_href }}"
          class="{% if is_shop_active %}is-active{% endif %}"
          data-mega-trigger
          aria-haspopup="true"
          aria-expanded="false"
        >
          <span>{{ section.settings.shop_all_label | default: 'Shop Sarees' }}</span>
          <span class="caret">{% render 'icons', icon: 'chevron-down' %}</span>
        </a>
        <div class="shopall-dropdown" data-mega-panel role="region" aria-label="{{ section.settings.shop_all_label | default: 'Shop Sarees' }} menu">
          <div class="dd-grid">
            {% if mega_blocks.size > 0 %}
              {% for block in mega_blocks %}
                <div class="dd-col" {{ block.shopify_attributes }}>
                  <h4>{{ block.settings.heading }}</h4>
                  {% if block.settings.menu != blank and block.settings.menu.links.size > 0 %}
                    {% for link in block.settings.menu.links %}
                      <a href="{{ link.url }}">{{ link.title }}</a>
                    {% endfor %}
                  {% else %}
                    {% assign lines = block.settings.links_list | newline_to_br | split: '<br />' %}
                    {% for line in lines %}
                      {% assign clean_line = line | strip %}
                      {% if clean_line != blank %}
                        {% assign parts = clean_line | split: '|' %}
                        {% assign lbl = parts[0] | strip %}
                        {% assign href = parts[1] | strip | default: routes.all_products_collection_url %}
                        <a href="{{ href }}">{{ lbl }}</a>
                      {% endif %}
                    {% endfor %}
                  {% endif %}
                </div>
              {% endfor %}
            {% else %}
              <div class="dd-col">
                <h4>By Fabric</h4>
                <a href="{{ routes.collections_url }}/cotton">Cotton</a>
                <a href="{{ routes.collections_url }}/silk">Silk</a>
                <a href="{{ routes.collections_url }}/chiffon">Chiffon</a>
                <a href="{{ routes.collections_url }}/georgette">Georgette</a>
              </div>
              <div class="dd-col">
                <h4>By Occasion</h4>
                <a href="{{ routes.collections_url }}/daily-use">Everyday</a>
                <a href="{{ routes.collections_url }}/office">Office</a>
                <a href="{{ routes.collections_url }}/festive">Festive</a>
                <a href="{{ routes.collections_url }}/wedding">Wedding</a>
              </div>
              <div class="dd-col">
                <h4>By Price</h4>
                <a href="{{ routes.collections_url }}/affordable">₹500–₹1,499</a>
                <a href="{{ routes.collections_url }}/mid-range">₹1,500–₹2,999</a>
                <a href="{{ routes.collections_url }}/premium">₹3,000 &amp; Above</a>
              </div>
            {% endif %}

            {% if has_mega_image %}
              <a class="dd-editorial" href="{{ section.settings.mega_image_url | default: shop_all_href }}">
                <img
                  src="{{ section.settings.mega_image | image_url: width: 520 }}"
                  alt="{{ section.settings.mega_image.alt | default: section.settings.mega_image_caption | default: 'Featured Sarees' | escape }}"
                  width="260"
                  height="325"
                  loading="lazy"
                >
                {% if section.settings.mega_image_caption != blank %}
                  <span>{{ section.settings.mega_image_caption }}</span>
                {% endif %}
              </a>
            {% endif %}
          </div>
          <div class="dd-footer">
            <a class="link-cta" href="{{ shop_all_href }}">View All Sarees {% render 'icons', icon: 'arrow-right' %}</a>
          </div>
        </div>
      </span>
    {% endif %}

    {% if use_shopify_menu %}
      {% for link in section.settings.menu.links %}
        <a href="{{ link.url }}" class="{% if link.active %}is-active{% endif %}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>
      {% endfor %}
    {% elsif nav_blocks.size > 0 %}
      {% for block in nav_blocks %}
        {%- liquid
          assign nav_href = block.settings.url | default: block.settings.fallback_path | default: routes.all_products_collection_url
          assign is_nav_active = false
          if request.path == nav_href
            assign is_nav_active = true
          endif
        -%}
        <a href="{{ nav_href }}" class="{% if is_nav_active %}is-active{% endif %}"{% if is_nav_active %} aria-current="page"{% endif %} {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
      {% endfor %}
    {% else %}
      <a href="{{ routes.collections_url }}/new-arrivals">New Arrivals</a>
      <a href="/pages/about">Our Story</a>
    {% endif %}
  </nav>
</header>

<div class="drawer-overlay" id="drawerOverlay" aria-hidden="true"></div>

<aside class="mobile-drawer" id="mobileDrawer" role="dialog" aria-modal="true" aria-label="Navigation menu" aria-hidden="true">
  <div class="drawer-head">
    <span class="logo-name">{{ section.settings.logo_text | default: shop.name }}</span>
    <button id="menuDrawerClose" class="drawer-close-btn" type="button" aria-label="Close navigation menu">{% render 'icons', icon: 'close' %}</button>
  </div>

  <div class="mm-panels" data-mm-panels>
    <div class="mm-panel is-active" data-mm-panel="root">
      {% if section.settings.show_home_link %}
        <a class="mm-link" href="{{ routes.root_url }}">Home</a>
      {% endif %}

      {% if section.settings.show_shop_all %}
        <button type="button" class="mm-submenu-trigger" data-mm-open="shop-sarees" aria-expanded="false">
          <span>{{ section.settings.shop_all_label | default: 'Shop Sarees' }}</span>
          {% render 'icons', icon: 'chevron-right' %}
        </button>
      {% endif %}

      {% if use_shopify_menu %}
        {% for link in section.settings.menu.links %}
          <a class="mm-link" href="{{ link.url }}">{{ link.title }}</a>
        {% endfor %}
      {% elsif nav_blocks.size > 0 %}
        {% for block in nav_blocks %}
          {% assign nav_href = block.settings.url | default: block.settings.fallback_path | default: routes.all_products_collection_url %}
          <a class="mm-link" href="{{ nav_href }}">{{ block.settings.label }}</a>
        {% endfor %}
      {% else %}
        <a class="mm-link" href="{{ routes.collections_url }}/new-arrivals">New Arrivals</a>
        <a class="mm-link" href="/pages/about">Our Story</a>
      {% endif %}

      <a class="mm-link" href="/pages/contact">Contact &amp; FAQ</a>
      {% if section.settings.show_account %}
        <a class="mm-link" href="{{ account_url }}">{% if customer %}My Account{% else %}Sign In / Account{% endif %}</a>
      {% endif %}
    </div>

    {% if section.settings.show_shop_all %}
      <div class="mm-panel" data-mm-panel="shop-sarees" hidden>
        <button type="button" class="mm-back-btn" data-mm-back>
          {% render 'icons', icon: 'arrow-left' %}
          <span>Back to Menu</span>
        </button>
        <a class="mm-link mm-link--strong" href="{{ shop_all_href }}">View All Sarees</a>

        {% if mega_blocks.size > 0 %}
          {% for block in mega_blocks %}
            <details class="mm-group" open>
              <summary>
                <span>{{ block.settings.heading }}</span>
                {% render 'icons', icon: 'chevron-down' %}
              </summary>
              <div class="mm-group-links">
                {% if block.settings.menu != blank and block.settings.menu.links.size > 0 %}
                  {% for link in block.settings.menu.links %}
                    <a href="{{ link.url }}">{{ link.title }}</a>
                  {% endfor %}
                {% else %}
                  {% assign lines = block.settings.links_list | newline_to_br | split: '<br />' %}
                  {% for line in lines %}
                    {% assign clean_line = line | strip %}
                    {% if clean_line != blank %}
                      {% assign parts = clean_line | split: '|' %}
                      {% assign lbl = parts[0] | strip %}
                      {% assign href = parts[1] | strip | default: routes.all_products_collection_url %}
                      <a href="{{ href }}">{{ lbl }}</a>
                    {% endif %}
                  {% endfor %}
                {% endif %}
              </div>
            </details>
          {% endfor %}
        {% else %}
          <details class="mm-group" open>
            <summary><span>By Fabric</span>{% render 'icons', icon: 'chevron-down' %}</summary>
            <div class="mm-group-links">
              <a href="{{ routes.collections_url }}/cotton">Cotton</a>
              <a href="{{ routes.collections_url }}/silk">Silk</a>
              <a href="{{ routes.collections_url }}/chiffon">Chiffon</a>
              <a href="{{ routes.collections_url }}/georgette">Georgette</a>
            </div>
          </details>
          <details class="mm-group" open>
            <summary><span>By Occasion</span>{% render 'icons', icon: 'chevron-down' %}</summary>
            <div class="mm-group-links">
              <a href="{{ routes.collections_url }}/daily-use">Everyday</a>
              <a href="{{ routes.collections_url }}/office">Office</a>
              <a href="{{ routes.collections_url }}/festive">Festive</a>
              <a href="{{ routes.collections_url }}/wedding">Wedding</a>
            </div>
          </details>
          <details class="mm-group" open>
            <summary><span>By Price</span>{% render 'icons', icon: 'chevron-down' %}</summary>
            <div class="mm-group-links">
              <a href="{{ routes.collections_url }}/affordable">₹500–₹1,499</a>
              <a href="{{ routes.collections_url }}/mid-range">₹1,500–₹2,999</a>
              <a href="{{ routes.collections_url }}/premium">₹3,000 &amp; Above</a>
            </div>
          </details>
        {% endif %}
      </div>
    {% endif %}
  </div>
</aside>

{% if section.settings.show_search %}
  <div class="search-drawer" id="searchDrawer" role="dialog" aria-modal="true" aria-label="Search store" aria-hidden="true">
    <div class="wrap">
      <div class="drawer-head">
        <span class="eyebrow" style="margin: 0;">Search {{ section.settings.logo_text | default: shop.name }}</span>
        <button id="searchClose" class="drawer-close-btn" type="button" aria-label="Close search">{% render 'icons', icon: 'close' %}</button>
      </div>
      <form action="{{ routes.search_url }}" method="get" role="search" class="search-form" data-predictive-search-form>
        <input type="hidden" name="type" value="product">
        <div class="search-input-wrap">
          <label for="HeaderSearchInput" class="visually-hidden">Search sarees</label>
          <input
            id="HeaderSearchInput"
            type="search"
            name="q"
            autocomplete="off"
            data-predictive-search-input
            placeholder="{{ section.settings.search_placeholder | default: "Search by fabric, weave or occasion (e.g. Cotton, Silk, Jamdani)…" }}"
            aria-controls="predictiveSearchResults"
            aria-autocomplete="list"
          >
          <button type="button" class="search-clear-btn" data-search-clear aria-label="Clear search" hidden>
            {% render 'icons', icon: 'close' %}
          </button>
        </div>
        <button type="submit" class="btn">Search</button>
      </form>
      <div class="predictive-loading" id="predictiveSearchLoading" hidden>
        <span class="vv-spinner" aria-hidden="true"></span>
        <span>Searching sarees…</span>
      </div>
      <div class="predictive-results" id="predictiveSearchResults" role="listbox" aria-live="polite" hidden></div>
      {% if section.settings.popular_searches != blank %}
        {% assign terms = section.settings.popular_searches | split: ',' %}
        <div class="search-hints">
          <span>Browse:</span>
          {% for term in terms %}
            {% assign clean_term = term | strip %}
            {% if clean_term != blank %}
              <a href="{{ routes.search_url }}?type=product&amp;q={{ clean_term | url_encode }}">{{ clean_term }}</a>{% unless forloop.last %} · {% endunless %}
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "header", "content": "Logo" },
    { "type": "image_picker", "id": "logo_image", "label": "Logo image (overrides text logo)" },
    { "type": "range", "id": "logo_width_desktop", "label": "Logo width (desktop)", "min": 120, "max": 260, "step": 10, "unit": "px", "default": 200 },
    { "type": "range", "id": "logo_width_mobile", "label": "Logo width (mobile)", "min": 100, "max": 200, "step": 10, "unit": "px", "default": 140 },
    {
      "type": "select",
      "id": "logo_position",
      "label": "Desktop logo placement",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "left", "label": "Left" }
      ],
      "default": "center"
    },
    { "type": "text", "id": "logo_text", "label": "Logo text", "default": "VEDAJANANI" },
    { "type": "text", "id": "logo_subtext", "label": "Logo subtext", "default": "Vastralayam" },
    { "type": "range", "id": "logo_font_size", "label": "Text logo size", "min": 18, "max": 36, "step": 1, "unit": "px", "default": 24 },
    { "type": "range", "id": "logo_letter_spacing", "label": "Text logo letter spacing", "min": 0, "max": 6, "step": 0.5, "unit": "px", "default": 2.5 },
    { "type": "header", "content": "Navigation & Actions" },
    { "type": "checkbox", "id": "sticky_header", "label": "Sticky header on scroll", "default": true },
    { "type": "checkbox", "id": "show_home_link", "label": "Show 'Home' link", "default": true },
    { "type": "checkbox", "id": "show_shop_all", "label": "Show 'Shop Sarees' mega menu", "default": true },
    { "type": "text", "id": "shop_all_label", "label": "Mega menu label", "default": "Shop Sarees" },
    { "type": "url", "id": "shop_all_url", "label": "Mega menu primary link" },
    { "type": "image_picker", "id": "mega_image", "label": "Mega menu editorial image (optional)" },
    { "type": "text", "id": "mega_image_caption", "label": "Mega menu image caption", "default": "Explore Festive Edit" },
    { "type": "url", "id": "mega_image_url", "label": "Mega menu image link" },
    { "type": "link_list", "id": "menu", "label": "Shopify Menu (optional — overrides Nav Link blocks)" },
    { "type": "checkbox", "id": "show_search", "label": "Show Search icon", "default": true },
    { "type": "checkbox", "id": "show_account", "label": "Show Account icon", "default": true },
    { "type": "checkbox", "id": "show_cart", "label": "Show Bag icon", "default": true },
    { "type": "text", "id": "search_placeholder", "label": "Search placeholder", "default": "Search by fabric, weave or occasion (e.g. Cotton, Silk, Jamdani)…" },
    { "type": "text", "id": "popular_searches", "label": "Suggested searches (comma-separated)", "default": "Cotton, Silk, Chiffon, Festive, Wedding" },
    { "type": "header", "content": "Colors & Typography" },
    { "type": "color", "id": "bg_color", "label": "Header background", "default": "#FAF2E3" },
    { "type": "color", "id": "menubar_bg", "label": "Desktop menubar background", "default": "#FAF2E3" },
    { "type": "color", "id": "text_color", "label": "Text, logo & icon color", "default": "#202521" },
    { "type": "color", "id": "hover_color", "label": "Hover & active accent color", "default": "#244737" },
    { "type": "color", "id": "border_color", "label": "Divider border color", "default": "#E3D8C5" },
    { "type": "color", "id": "badge_bg", "label": "Bag count badge background", "default": "#244737" },
    { "type": "color", "id": "badge_text", "label": "Bag count badge text", "default": "#FFFFFF" },
    { "type": "color", "id": "dropdown_bg", "label": "Mega menu background", "default": "#FFFFFF" },
    { "type": "range", "id": "nav_font_size", "label": "Navigation font size", "min": 12, "max": 16, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "nav_letter_spacing", "label": "Navigation letter spacing", "min": 0, "max": 3, "step": 0.5, "unit": "px", "default": 0.5 },
    {
      "type": "select",
      "id": "nav_transform",
      "label": "Navigation text case",
      "options": [
        { "value": "none", "label": "Sentence case" },
        { "value": "capitalize", "label": "Title case" },
        { "value": "uppercase", "label": "Uppercase" }
      ],
      "default": "none"
    },
    { "type": "range", "id": "dropdown_width", "label": "Mega menu width", "min": 520, "max": 920, "step": 40, "unit": "px", "default": 680 }
  ],
  "blocks": [
    {
      "type": "mega_column",
      "name": "Mega Menu Column",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "heading", "label": "Column heading", "default": "By Fabric" },
        { "type": "link_list", "id": "menu", "label": "Shopify Menu (optional — overrides links below)" },
        {
          "type": "textarea",
          "id": "links_list",
          "label": "Custom links (one per line: Label | /path)",
          "default": "Cotton | /collections/cotton\nSilk | /collections/silk\nChiffon | /collections/chiffon\nGeorgette | /collections/georgette"
        }
      ]
    },
    {
      "type": "nav_link",
      "name": "Menubar Link",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "label", "label": "Link label", "default": "New Arrivals" },
        { "type": "url", "id": "url", "label": "Link destination" },
        { "type": "text", "id": "fallback_path", "label": "Fallback path (used if Link destination empty)", "default": "/collections/new-arrivals" }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "mega_column",
        "settings": {
          "heading": "By Fabric",
          "links_list": "Cotton | /collections/cotton\nSilk | /collections/silk\nChiffon | /collections/chiffon\nGeorgette | /collections/georgette"
        }
      },
      {
        "type": "mega_column",
        "settings": {
          "heading": "By Occasion",
          "links_list": "Everyday | /collections/daily-use\nOffice | /collections/office\nFestive | /collections/festive\nWedding | /collections/wedding"
        }
      },
      {
        "type": "mega_column",
        "settings": {
          "heading": "By Price",
          "links_list": "₹500–₹1,499 | /collections/affordable\n₹1,500–₹2,999 | /collections/mid-range\n₹3,000 & Above | /collections/premium"
        }
