{%- liquid
  assign active_filter_count = 0
  if search.performed and search.filters != blank
    for filter in search.filters
      assign active_filter_count = active_filter_count | plus: filter.active_values.size
      if filter.type == 'price_range'
        if filter.min_value.value != nil or filter.max_value.value != nil
          assign active_filter_count = active_filter_count | plus: 1
        endif
      endif
    endfor
  endif
  assign clear_search_filters_url = routes.search_url | append: '?type=product&q=' | append: search.terms | url_encode
-%}

{% style %}
  #shopify-section-{{ section.id }} .vv-search-sec {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .vv-grid {
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
    gap: 20px;
  }
  @media (max-width: 900px) {
    #shopify-section-{{ section.id }} .vv-grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, minmax(0, 1fr));
    }
  }
{% endstyle %}

<section class="vv-search-sec">
  <div class="wrap">
    {% render 'breadcrumbs' %}

    <div class="section-head section-head--center">
      <span class="eyebrow">Search</span>
      <h1 style="font-size: 38px;">
        {% if search.performed %}
          Results for “{{ search.terms | escape }}”
        {% else %}
          {{ section.settings.heading }}
        {% endif %}
      </h1>
    </div>

    <form action="{{ routes.search_url }}" method="get" role="search" class="search-form" style="max-width: 600px; margin: 0 auto 32px;">
      <input type="hidden" name="type" value="product">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ section.settings.placeholder }}" aria-label="Search sarees">
      <button type="submit" class="btn">Search</button>
    </form>

    {% if search.performed %}
      {% if search.filters.size > 0 %}
        <div class="collection-toolbar">
          <div class="collection-toolbar-left">
            <button
              type="button"
              class="filter-toggle-btn"
              data-filter-drawer-open="searchFilterDrawer-{{ section.id }}"
              aria-controls="searchFilterDrawer-{{ section.id }}"
              aria-expanded="false"
            >
              {% render 'icons', icon: 'filter' %}
              <span>Filter{% if active_filter_count > 0 %} ({{ active_filter_count }}){% endif %}</span>
            </button>
            <span class="collection-count">{{ search.results_count }} {{ search.results_count | pluralize: 'result', 'results' }}</span>
          </div>
        </div>

        {% if active_filter_count > 0 %}
          <div class="active-filters" aria-label="Active filters">
            {% for filter in search.filters %}
              {% for value in filter.active_values %}
                <a href="{{ value.url_to_remove }}" class="active-filter-chip">
                  <span>{{ filter.label }}: {{ value.label }}</span>
                  <span aria-hidden="true">×</span>
                </a>
              {% endfor %}
              {% if filter.type == 'price_range' %}
                {% if filter.min_value.value != nil or filter.max_value.value != nil %}
                  <a href="{{ filter.url_to_remove }}" class="active-filter-chip">
                    <span>
                      {{ filter.label }}:
                      {% if filter.min_value.value %}{{ filter.min_value.value | money }}{% else %}{{ 0 | money }}{% endif %}
                      –
                      {% if filter.max_value.value %}{{ filter.max_value.value | money }}{% else %}{{ filter.range_max | money }}{% endif %}
                    </span>
                    <span aria-hidden="true">×</span>
                  </a>
                {% endif %}
              {% endif %}
            {% endfor %}
            <a href="{{ clear_search_filters_url }}" class="active-filter-clear">Clear all</a>
          </div>
        {% endif %}

        <aside
          class="filter-drawer"
          id="searchFilterDrawer-{{ section.id }}"
          role="dialog"
          aria-modal="true"
          aria-label="Filter search results"
          aria-hidden="true"
        >
          <div class="drawer-head">
            <h3>Filter Results</h3>
            <button type="button" class="drawer-close-btn" data-filter-drawer-close aria-label="Close filters">
              {% render 'icons', icon: 'close' %}
            </button>
          </div>
          <form class="filter-form" method="get" action="{{ routes.search_url }}">
            <input type="hidden" name="type" value="product">
            <input type="hidden" name="q" value="{{ search.terms | escape }}">
            <div class="filter-drawer-body">
              {% for filter in search.filters %}
                <details class="filter-group" {% if forloop.index <= 3 or filter.active_values.size > 0 %}open{% endif %}>
                  <summary>
                    <span>{{ filter.label }}</span>
                    <span>{% render 'icons', icon: 'chevron-down' %}</span>
                  </summary>
                  <div class="filter-group-body">
                    {% case filter.type %}
                      {% when 'boolean', 'list' %}
                        <ul class="filter-list">
                          {% for value in filter.values %}
                            <li>
                              <label class="filter-check{% if value.count == 0 and value.active == false %} is-disabled{% endif %}">
                                <input
                                  type="checkbox"
                                  name="{{ value.param_name }}"
                                  value="{{ value.value }}"
                                  {% if value.active %}checked{% endif %}
                                  {% if value.count == 0 and value.active == false %}disabled{% endif %}
                                >
                                <span>{{ value.label }}</span>
                                <span class="filter-val-count">({{ value.count }})</span>
                              </label>
                            </li>
                          {% endfor %}
                        </ul>
                      {% when 'price_range' %}
                        {%- assign max_major = filter.range_max | divided_by: 100 | ceil -%}
                        <div class="filter-price-range">
                          <div class="filter-price-field">
                            <label for="SearchFilterMin-{{ forloop.index }}">Min ({{ cart.currency.symbol }})</label>
                            <input id="SearchFilterMin-{{ forloop.index }}" type="number" name="{{ filter.min_value.param_name }}" min="0" max="{{ max_major }}" placeholder="0" {% if filter.min_value.value %}value="{{ filter.min_value.value | divided_by: 100 }}"{% endif %}>
                          </div>
                          <div class="filter-price-field">
                            <label for="SearchFilterMax-{{ forloop.index }}">Max ({{ cart.currency.symbol }})</label>
                            <input id="SearchFilterMax-{{ forloop.index }}" type="number" name="{{ filter.max_value.param_name }}" min="0" max="{{ max_major }}" placeholder="{{ max_major }}" {% if filter.max_value.value %}value="{{ filter.max_value.value | divided_by: 100 }}"{% endif %}>
                          </div>
                        </div>
                    {% endcase %}
                  </div>
                </details>
              {% endfor %}
            </div>
            <div class="filter-drawer-foot">
              <a href="{{ clear_search_filters_url }}" class="btn outline">Clear All</a>
              <button type="submit" class="btn">Apply Filters</button>
            </div>
          </form>
        </aside>
      {% endif %}

      {% paginate search.results by section.settings.results_per_page %}
        {% if search.results_count > 0 %}
          <div class="vv-grid">
            {% for item in search.results %}
              {% if item.object_type == 'product' %}
                {% render 'product-card', product: item %}
              {% else %}
                <a class="blog-card" href="{{ item.url }}">
                  <div class="blog-card-body">
                    <div class="blog-card-meta">{{ item.object_type | capitalize }}</div>
                    <h3 class="blog-card-title">{{ item.title }}</h3>
                    <p class="blog-card-excerpt">{{ item.content | strip_html | truncate: 110 }}</p>
                  </div>
                </a>
              {% endif %}
            {% endfor %}
          </div>

          {% if paginate.pages > 1 %}
            <nav class="pagination" aria-label="Pagination">{{ paginate | default_pagination }}</nav>
          {% endif %}
        {% else %}
          <div class="empty-state-box">
            <p>No sarees matched “{{ search.terms | escape }}”. Try searching by fabric or browse our core collections below.</p>
            <div class="search-recovery-links">
              <a class="btn outline" href="{{ routes.collections_url }}/cotton">Cotton</a>
              <a class="btn outline" href="{{ routes.collections_url }}/silk">Silk</a>
              <a class="btn outline" href="{{ routes.collections_url }}/chiffon">Chiffon</a>
              <a class="btn outline" href="{{ routes.collections_url }}/georgette">Georgette</a>
              <a class="btn" href="{{ routes.all_products_collection_url }}">View All Sarees</a>
            </div>
          </div>
        {% endif %}
      {% endpaginate %}
    {% else %}
      <div class="empty-state-box">
        <p style="margin-bottom: 18px;">Explore popular collections:</p>
        <div class="search-recovery-links">
          <a class="btn outline" href="{{ routes.collections_url }}/cotton">Cotton</a>
          <a class="btn outline" href="{{ routes.collections_url }}/silk">Silk</a>
          <a class="btn outline" href="{{ routes.collections_url }}/chiffon">Chiffon</a>
          <a class="btn outline" href="{{ routes.collections_url }}/georgette">Georgette</a>
          <a class="btn outline" href="{{ routes.collections_url }}/festive">Festive</a>
          <a class="btn outline" href="{{ routes.collections_url }}/wedding">Wedding</a>
        </div>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Main Search",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Search Our Sarees" },
    { "type": "text", "id": "placeholder", "label": "Search input placeholder", "default": "Try 'Cotton', 'Silk', 'Jamdani', 'Festive'…" },
    { "type": "range", "id": "results_per_page", "label": "Results per page", "min": 8, "max": 48, "step": 4, "default": 24 },
    { "type": "range", "id": "columns_desktop", "label": "Columns (desktop)", "min": 2, "max": 5, "step": 1, "default": 4 },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns (mobile)",
      "options": [
        { "value": "1", "label": "1 column" },
        { "value": "2", "label": "2 columns" }
      ],
      "default": "2"
    },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 20, "max": 100, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 20, "max": 100, "step": 4, "unit": "px", "default": 72 }
  ]
}
{% endschema %}
