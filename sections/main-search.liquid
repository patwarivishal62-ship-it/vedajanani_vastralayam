{% style %}
  #shopify-section-{{ section.id }} .vv-search-sec {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .product-grid {
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
    gap: {{ section.settings.grid_gap }}px;
  }
  @media (max-width: 900px) {
    #shopify-section-{{ section.id }} .product-grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, minmax(0, 1fr));
    }
  }
{% endstyle %}

<section class="vv-search-sec">
  <div class="wrap">
    <div class="section-head section-head--center">
      <h1 style="font-size: {{ section.settings.heading_size }}px;">{{ section.settings.heading }}</h1>
      <form action="{{ routes.search_url }}" method="get" role="search" class="search-form" style="max-width: 580px; margin: 20px auto 0;">
        <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ section.settings.placeholder }}" aria-label="Search">
        <button type="submit" class="btn">Search</button>
      </form>
    </div>

    {% if search.performed %}
      {% if search.results_count == 0 %}
        <div class="empty">
          <p>No results found for “{{ search.terms | escape }}”.</p>
          <a class="btn" href="{{ routes.all_products_collection_url }}">Browse All Sarees</a>
        </div>
      {% else %}
        <p style="text-align: center; color: var(--text-muted); margin-bottom: 28px;">
          Showing {{ search.results_count }} results for “{{ search.terms | escape }}”
        </p>
        {% paginate search.results by 16 %}
          <div class="product-grid">
            {% for item in search.results %}
              {% if item.object_type == 'product' %}
                {% render 'product-card', product: item %}
              {% else %}
                <a class="blog-card" href="{{ item.url }}">
                  <div class="blog-card-body">
                    <div class="blog-card-meta">{{ item.object_type | capitalize }}</div>
                    <h3 class="blog-card-title">{{ item.title }}</h3>
                    <p class="blog-card-excerpt">{{ item.content | strip_html | truncate: 110 }}</p>
                  </div>
                </a>
              {% endif %}
            {% endfor %}
          </div>
          {% if paginate.pages > 1 %}
            <nav class="pagination" aria-label="Pagination">{{ paginate | default_pagination }}</nav>
          {% endif %}
        {% endpaginate %}
      {% endif %}
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Main Search",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Search Sarees"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Search input placeholder",
      "default": "Try 'Banarasi', 'Mul Cotton', 'Festive'…"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 24,
      "max": 56,
      "step": 2,
      "unit": "px",
      "default": 38
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns (mobile)",
      "min": 1,
      "max": 2,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Grid gap",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 16,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 16,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ]
}
{% endschema %}
