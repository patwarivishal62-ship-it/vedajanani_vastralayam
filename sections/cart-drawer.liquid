{%- liquid
  assign threshold_val = settings.free_shipping_threshold | plus: 0
  assign threshold_cents = threshold_val | times: 100
  assign remaining = threshold_cents | minus: cart.total_price
  if threshold_cents > 0
    assign pct = cart.total_price | times: 100 | divided_by: threshold_cents | at_most: 100
  else
    assign pct = 0
  endif
  assign empty_cta_href = section.settings.empty_cta_url | default: routes.all_products_collection_url
-%}

{% style %}
  #shopify-section-{{ section.id }} .cart-drawer {
    background: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
  }
  #shopify-section-{{ section.id }} .cart-ship-bar-fill {
    background: {{ section.settings.bar_color }};
  }
{% endstyle %}

<aside class="cart-drawer" id="cartDrawer" role="dialog" aria-modal="true" aria-label="Shopping bag" aria-hidden="true">
  <div class="drawer-head">
    <h3>{{ section.settings.heading }} (<span id="cartDrawerCount">{{ cart.item_count }}</span>)</h3>
    <button id="cartDrawerClose" class="drawer-close-btn" type="button" aria-label="Close bag">{% render 'icons', icon: 'close' %}</button>
  </div>

  {% if section.settings.show_free_shipping_bar and threshold_cents > 0 and cart.item_count > 0 %}
    <div class="cart-ship-bar">
      {% if remaining > 0 %}
        Add <strong>{{ remaining | money }}</strong> more to qualify for complimentary shipping
      {% else %}
        Your order qualifies for complimentary shipping
      {% endif %}
      <div class="cart-ship-bar-track">
        <div class="cart-ship-bar-fill" style="width: {{ pct }}%;"></div>
      </div>
    </div>
  {% endif %}

  <div class="cart-drawer-error" id="cartDrawerError" role="alert" hidden></div>

  <div class="cart-drawer-body" id="cartDrawerBody">
    {% if cart.item_count == 0 %}
      <div class="cart-empty">
        <p>{{ section.settings.empty_message }}</p>
        <a class="btn" href="{{ empty_cta_href }}">{{ section.settings.empty_cta_label }}</a>
      </div>
    {% else %}
      <ul class="cart-items">
        {% for item in cart.items %}
          <li class="cart-item" data-line="{{ forloop.index }}">
            <a href="{{ item.url }}" class="cart-thumb">
              {% if item.image %}
                <img src="{{ item.image | image_url: width: 180 }}" alt="{{ item.title | escape }}" width="90" height="120" loading="lazy">
              {% endif %}
            </a>
            <div class="cart-item-info">
              <a href="{{ item.url }}" class="cart-item-title">{{ item.product.title }}</a>
              {% unless item.product.has_only_default_variant %}
                <div class="cart-item-var">{{ item.variant.title }}</div>
              {% endunless %}
              <div class="cart-item-price">{{ item.final_line_price | money }}</div>
              <div class="cart-item-qty">
                <button type="button" class="js-cart-qty" data-line="{{ forloop.index }}" data-qty="{{ item.quantity | minus: 1 }}" aria-label="Decrease quantity of {{ item.product.title | escape }}">−</button>
                <span>{{ item.quantity }}</span>
                <button type="button" class="js-cart-qty" data-line="{{ forloop.index }}" data-qty="{{ item.quantity | plus: 1 }}" aria-label="Increase quantity of {{ item.product.title | escape }}">+</button>
                <button type="button" class="js-cart-qty cart-remove" data-line="{{ forloop.index }}" data-qty="0">Remove</button>
              </div>
            </div>
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>

  {% if cart.item_count > 0 %}
    <div class="cart-drawer-foot">
      {% if section.settings.show_order_note %}
        <div class="cart-drawer-note">
          <label for="CartDrawerNote">Order note / gift message</label>
          <textarea id="CartDrawerNote" name="note" rows="2" placeholder="Add a special note or saree draping request...">{{ cart.note }}</textarea>
        </div>
      {% endif %}
      <div class="cart-sub">
        <span>Subtotal</span>
        <strong id="cartSubtotal">{{ cart.total_price | money }}</strong>
      </div>
      {% if section.settings.shipping_note != blank %}
        <p class="cart-note">{{ section.settings.shipping_note }}</p>
      {% elsif settings.shipping_note != blank %}
        <p class="cart-note">{{ settings.shipping_note }}</p>
      {% endif %}
      <form action="{{ routes.cart_url }}" method="post">
        <button type="submit" name="checkout" class="btn cart-checkout">{{ section.settings.checkout_label }}</button>
      </form>
      {% if section.settings.show_view_cart_link %}
        <a href="{{ routes.cart_url }}" class="cart-view-link">View Full Bag</a>
      {% endif %}
    </div>
  {% endif %}
</aside>

{% schema %}
{
  "name": "Cart Drawer",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Drawer heading",
      "default": "Your Bag"
    },
    {
      "type": "text",
      "id": "empty_message",
      "label": "Empty bag message",
      "default": "Your bag is currently empty."
    },
    {
      "type": "text",
      "id": "empty_cta_label",
      "label": "Empty bag button label",
      "default": "Explore Sarees"
    },
    {
      "type": "url",
      "id": "empty_cta_url",
      "label": "Empty bag button link"
    },
    {
      "type": "checkbox",
      "id": "show_free_shipping_bar",
      "label": "Show free-shipping progress bar (requires threshold > 0)",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_order_note",
      "label": "Show order note field",
      "default": false
    },
    {
      "type": "text",
      "id": "shipping_note",
      "label": "Shipping note (overrides global setting)",
      "default": "Shipping and taxes calculated at checkout."
    },
    {
      "type": "text",
      "id": "checkout_label",
      "label": "Checkout button label",
      "default": "Proceed to Checkout"
    },
    {
      "type": "checkbox",
      "id": "show_view_cart_link",
      "label": "Show 'View Full Bag' link",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#1C1C1C"
    },
    {
      "type": "color",
      "id": "bar_color",
      "label": "Progress bar color",
      "default": "#244737"
    }
  ]
}
{% endschema %}
