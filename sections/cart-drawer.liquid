{%- liquid
  assign threshold_cents = settings.free_shipping_threshold | default: 999 | times: 100
  assign remaining_cents = threshold_cents | minus: cart.total_price
-%}

{% style %}
  #shopify-section-{{ section.id }} .cart-drawer {
    width: {{ section.settings.drawer_width }}px;
    background: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
  }
  #shopify-section-{{ section.id }} .cart-drawer-foot {
    background: {{ section.settings.bg_color }};
  }
  #shopify-section-{{ section.id }} .cart-shipping-bar {
    background: {{ section.settings.shipping_bar_bg }};
    color: {{ section.settings.shipping_bar_text }};
  }
{% endstyle %}

<aside class="cart-drawer" id="cartDrawer" aria-label="{{ section.settings.heading | default: 'Your Bag' | escape }}" data-section-id="{{ section.id }}">
  <div class="drawer-head">
    <span>{{ section.settings.heading | default: 'Your Bag' }} (<span id="cartDrawerCount">{{ cart.item_count }}</span>)</span>
    <button id="cartClose" type="button" aria-label="Close bag">✕</button>
  </div>

  {% if section.settings.show_shipping_bar %}
    <div class="cart-shipping-bar" id="cartShippingBar">
      {% if cart.total_price >= threshold_cents %}
        {{ section.settings.shipping_unlocked_text }}
      {% else %}
        Add {{ remaining_cents | money }} more for {{ section.settings.shipping_goal_label }}
      {% endif %}
    </div>
  {% endif %}

  <div class="cart-drawer-body" id="cartDrawerBody">
    {% if cart.item_count == 0 %}
      <div class="empty">
        <p>{{ section.settings.empty_text | default: 'Your bag is empty.' }}</p>
        <a class="btn" href="{{ section.settings.empty_cta_url | default: routes.all_products_collection_url }}">
          {{ section.settings.empty_cta_label | default: 'Start Shopping' }}
        </a>
      </div>
    {% else %}
      {% for item in cart.items %}
        <div class="cart-item" data-cart-item-key="{{ item.key }}">
          {% if item.image %}
            <img
              src="{{ item.image | image_url: width: 180 }}"
              alt="{{ item.title | escape }}"
              width="78"
              height="104"
              loading="lazy"
            >
          {% endif %}
          <div class="cart-item-info">
            <a class="cart-item-title" href="{{ item.url }}">{{ item.product.title }}</a>
            {% unless item.product.has_only_default_variant %}
              <div class="cart-item-variant">{{ item.variant.title }}</div>
            {% endunless %}
            <div>{{ item.final_price | money }}</div>
            <div class="cart-item-controls">
              <div class="qty-pill">
                <button type="button" class="js-cart-qty" data-key="{{ item.key }}" data-qty="{{ item.quantity | minus: 1 }}" aria-label="Decrease quantity">−</button>
                <span>{{ item.quantity }}</span>
                <button type="button" class="js-cart-qty" data-key="{{ item.key }}" data-qty="{{ item.quantity | plus: 1 }}" aria-label="Increase quantity">+</button>
              </div>
              <button type="button" class="cart-remove-btn js-cart-qty" data-key="{{ item.key }}" data-qty="0">Remove</button>
            </div>
          </div>
        </div>
      {% endfor %}
    {% endif %}
  </div>

  {% if cart.item_count > 0 %}
    <div class="cart-drawer-foot" id="cartDrawerFoot">
      <div class="row">
        <span>{{ section.settings.subtotal_label | default: 'Subtotal' }}</span>
        <strong>{{ cart.total_price | money }}</strong>
      </div>
      {% if section.settings.shipping_note != blank or settings.shipping_note != blank %}
        <p class="note">{{ section.settings.shipping_note | default: settings.shipping_note }}</p>
      {% endif %}
      {% if section.settings.show_view_bag %}
        <a class="btn full" href="{{ routes.cart_url }}">{{ section.settings.view_bag_label | default: 'View Bag' }}</a>
      {% endif %}
      {% if section.settings.show_checkout %}
        <a class="btn dark full" href="/checkout">{{ section.settings.checkout_label | default: 'Checkout' }}</a>
      {% endif %}
    </div>
  {% endif %}
</aside>

{% schema %}
{
  "name": "Cart Drawer",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Drawer heading",
      "default": "Your Bag"
    },
    {
      "type": "range",
      "id": "drawer_width",
      "label": "Drawer width (desktop)",
      "min": 320,
      "max": 560,
      "step": 10,
      "unit": "px",
      "default": 420
    },
    {
      "type": "header",
      "content": "Free Shipping Banner"
    },
    {
      "type": "checkbox",
      "id": "show_shipping_bar",
      "label": "Show free shipping progress bar",
      "default": true
    },
    {
      "type": "text",
      "id": "shipping_goal_label",
      "label": "Goal suffix text",
      "default": "Free Shipping"
    },
    {
      "type": "text",
      "id": "shipping_unlocked_text",
      "label": "Unlocked message",
      "default": "You have unlocked Free Shipping!"
    },
    {
      "type": "header",
      "content": "Labels & Buttons"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Empty bag text",
      "default": "Your bag is empty."
    },
    {
      "type": "text",
      "id": "empty_cta_label",
      "label": "Empty bag button label",
      "default": "Start Shopping"
    },
    {
      "type": "url",
      "id": "empty_cta_url",
      "label": "Empty bag button link"
    },
    {
      "type": "text",
      "id": "subtotal_label",
      "label": "Subtotal label",
      "default": "Subtotal"
    },
    {
      "type": "text",
      "id": "shipping_note",
      "label": "Shipping & taxes note",
      "default": "Shipping & taxes calculated at checkout. Free shipping above ₹999."
    },
    {
      "type": "checkbox",
      "id": "show_view_bag",
      "label": "Show 'View Bag' button",
      "default": true
    },
    {
      "type": "text",
      "id": "view_bag_label",
      "label": "'View Bag' button text",
      "default": "View Bag"
    },
    {
      "type": "checkbox",
      "id": "show_checkout",
      "label": "Show 'Checkout' button",
      "default": true
    },
    {
      "type": "text",
      "id": "checkout_label",
      "label": "'Checkout' button text",
      "default": "Checkout"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Drawer background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#1C1C1C"
    },
    {
      "type": "color",
      "id": "shipping_bar_bg",
      "label": "Shipping bar background",
      "default": "#F3EDE3"
    },
    {
      "type": "color",
      "id": "shipping_bar_text",
      "label": "Shipping bar text",
      "default": "#1C1C1C"
    }
  ]
}
{% endschema %}
