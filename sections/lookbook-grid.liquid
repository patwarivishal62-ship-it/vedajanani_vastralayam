{% style %}
  #shopify-section-{{ section.id }} .vv-lookbook-sec {
    {% if section.settings.bg_color != blank and section.settings.bg_color != 'rgba(0,0,0,0)' %}
      background: {{ section.settings.bg_color }};
    {% endif %}
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .vv-grid {
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
    gap: {{ section.settings.grid_gap }}px;
  }
  #shopify-section-{{ section.id }} .lookbook-card {
    aspect-ratio: {{ section.settings.image_ratio }};
    border-radius: {{ section.settings.card_radius }}px;
  }
  @media (max-width: 900px) {
    #shopify-section-{{ section.id }} .vv-grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, minmax(0, 1fr));
    }
  }
{% endstyle %}

<section class="vv-lookbook-sec">
  <div class="{% if section.settings.full_width %}vv-banner-wrap--inset{% else %}wrap{% endif %}">
    {% if section.settings.eyebrow != blank or section.settings.heading != blank %}
      <div class="section-head section-head--{{ section.settings.heading_align }}">
        {% if section.settings.eyebrow != blank %}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 style="font-size: {{ section.settings.heading_size }}px; color: {{ section.settings.heading_color }};">
            {{ section.settings.heading }}
          </h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p class="section-sub">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="vv-grid">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          {%- liquid
            assign linked_product = block.settings.product
            assign card_img = block.settings.image
            if card_img == blank and linked_product != blank
              assign card_img = linked_product.featured_image
            endif
            assign card_caption = block.settings.caption
            if card_caption == blank and linked_product != blank
              assign card_caption = linked_product.title
            endif
            assign card_sub = block.settings.subcaption
            if card_sub == blank and linked_product != blank
              assign card_sub = linked_product.price | money
            endif
            assign card_href = block.settings.url
            if card_href == blank and linked_product != blank
              assign card_href = linked_product.url
            endif
            if card_href == blank
              assign card_href = routes.all_products_collection_url
            endif
            assign ov_alpha = block.settings.overlay_opacity | divided_by: 100.0
          -%}
          <a
            class="lookbook-card"
            href="{{ card_href }}"
            style="background: {{ block.settings.bg_color }};"
            {{ block.shopify_attributes }}
          >
            {% if card_img != blank %}
              <img
                src="{{ card_img | image_url: width: 900 }}"
                alt="{{ card_img.alt | default: card_caption | escape }}"
                style="object-position: {{ block.settings.focal_point }};"
                width="600"
                height="800"
                loading="lazy"
              >
            {% else %}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
            <div class="lookbook-card-overlay" style="opacity: {{ ov_alpha }};"></div>
            {% if card_caption != blank or card_sub != blank %}
              <div class="lookbook-caption" style="color: {{ block.settings.text_color }};">
                {% if card_caption != blank %}<span>{{ card_caption }}</span>{% endif %}
                {% if card_sub != blank %}
                  <span style="display: block; font-family: var(--font-body); font-size: 12px; opacity: 0.9; margin-top: 4px;">{{ card_sub }}</span>
                {% endif %}
              </div>
            {% endif %}
          </a>
        {% endfor %}
      {% else %}
        {% for i in (1..4) %}
          <a class="lookbook-card" href="{{ routes.all_products_collection_url }}">
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            <div class="lookbook-caption">Look 0{{ i }}</div>
          </a>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lookbook Grid",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Lookbook" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Draped in Grace" },
    { "type": "textarea", "id": "subheading", "label": "Subheading (optional)" },
    { "type": "text_alignment", "id": "heading_align", "label": "Header alignment", "default": "center" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 20, "max": 60, "step": 2, "unit": "px", "default": 34 },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#1C1C1C" },
    { "type": "header", "content": "Grid & Aspect Ratio" },
    { "type": "checkbox", "id": "full_width", "label": "Full-width grid", "default": false },
    { "type": "range", "id": "columns_desktop", "label": "Columns (desktop)", "min": 2, "max": 6, "step": 1, "default": 4 },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns (mobile)",
      "options": [
        { "value": "1", "label": "1 column" },
        { "value": "2", "label": "2 columns" }
      ],
      "default": "2"
    },
    { "type": "range", "id": "grid_gap", "label": "Grid gap", "min": 4, "max": 36, "step": 2, "unit": "px", "default": 16 },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Photo aspect ratio",
      "options": [
        { "value": "3 / 4", "label": "Portrait (3:4)" },
        { "value": "4 / 5", "label": "Editorial (4:5)" },
        { "value": "2 / 3", "label": "Tall (2:3)" },
        { "value": "1 / 1", "label": "Square (1:1)" },
        { "value": "4 / 3", "label": "Landscape (4:3)" }
      ],
      "default": "3 / 4"
    },
    { "type": "range", "id": "card_radius", "label": "Card corner radius", "min": 0, "max": 36, "step": 2, "unit": "px", "default": 10 },
    { "type": "header", "content": "Section Spacing" },
    { "type": "color", "id": "bg_color", "label": "Section background (optional)" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Lookbook Photo",
      "settings": [
        { "type": "product", "id": "product", "label": "Featured saree (optional — auto-fills photo, title & price)" },
        { "type": "image_picker", "id": "image", "label": "Custom photo (overrides product image)" },
        {
          "type": "select",
          "id": "focal_point",
          "label": "Image focal point",
          "options": [
            { "value": "center center", "label": "Center" },
            { "value": "top center", "label": "Top" },
            { "value": "bottom center", "label": "Bottom" }
          ],
          "default": "center center"
        },
        { "type": "range", "id": "overlay_opacity", "label": "Bottom gradient darkness", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 70 },
        { "type": "text", "id": "caption", "label": "Caption (overrides product title)" },
        { "type": "text", "id": "subcaption", "label": "Subcaption (overrides product price)" },
        { "type": "url", "id": "url", "label": "Custom link (overrides product link)" },
        { "type": "color", "id": "bg_color", "label": "Fallback background", "default": "#244737" },
        { "type": "color", "id": "text_color", "label": "Caption color", "default": "#FAF2E3" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lookbook Grid",
      "blocks": [
        { "type": "photo", "settings": { "caption": "Cotton Weaves", "subcaption": "Explore Collection" } },
        { "type": "photo", "settings": { "caption": "Silk Drapes", "subcaption": "Explore Collection" } },
        { "type": "photo", "settings": { "caption": "Festive Chiffon", "subcaption": "Explore Collection" } },
        { "type": "photo", "settings": { "caption": "Wedding Edit", "subcaption": "Explore Collection" } }
      ]
    }
  ]
}
{% endschema %}
