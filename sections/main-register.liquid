<section class="account-sec">
  <div class="wrap account-narrow">
    <div class="account-card">
      <div class="account-head">
        <span class="eyebrow">Join Vedajanani Vastralayam</span>
        <h1>{{ section.settings.heading }}</h1>
        {% if section.settings.subtitle != blank %}
          <p class="account-sub">{{ section.settings.subtitle }}</p>
        {% endif %}
      </div>

      {% form 'create_customer', class: 'form-stack' %}
        {% if form.errors %}
          <div class="errors" role="alert">{{ form.errors | default_errors }}</div>
        {% endif %}
        <div class="field-group">
          <label for="RegisterFirstName">First name</label>
          <input id="RegisterFirstName" type="text" name="customer[first_name]" autocomplete="given-name" placeholder="First name" required>
        </div>
        <div class="field-group">
          <label for="RegisterLastName">Last name</label>
          <input id="RegisterLastName" type="text" name="customer[last_name]" autocomplete="family-name" placeholder="Last name" required>
        </div>
        <div class="field-group">
          <label for="RegisterEmail">Email address</label>
          <input id="RegisterEmail" type="email" name="customer[email]" autocomplete="email" placeholder="you@example.com" required>
        </div>
        <div class="field-group">
          <label for="RegisterPassword">Password</label>
          <input id="RegisterPassword" type="password" name="customer[password]" autocomplete="new-password" placeholder="Create a password" required>
        </div>
        <button type="submit" class="btn full">Create Account</button>
      {% endform %}

      <p class="account-alt">
        Already have an account? <a href="{{ routes.account_login_url }}" class="link-cta">Sign In</a>
      </p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Customer Register",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Create Account" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "Create an account for faster checkout and easy access to your orders." }
  ]
}
{% endschema %}
