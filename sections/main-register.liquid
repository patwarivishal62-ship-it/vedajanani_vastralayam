{%- liquid
  assign show_side = section.settings.show_side_panel
-%}

{% style %}
  #shopify-section-{{ section.id }} .vv-auth-sec {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .vv-auth-shell {
    border-radius: {{ section.settings.card_radius }}px;
  }
  #shopify-section-{{ section.id }} .vv-auth-aside {
    background: {{ section.settings.side_bg }};
  }
  @media (max-width: 860px) {
    #shopify-section-{{ section.id }} .vv-auth-sec {
      padding-top: 28px;
      padding-bottom: 52px;
    }
  }
{% endstyle %}

<section class="vv-auth-sec">
  <div class="wrap">
    <div class="vv-auth-shell{% unless show_side %} vv-auth-shell--single{% endunless %}">
      {% if show_side %}
        <div class="vv-auth-aside">
          {% if section.settings.side_image != blank %}
            <img
              class="vv-auth-aside-img"
              src="{{ section.settings.side_image | image_url: width: 900 }}"
              alt="{{ section.settings.side_image.alt | default: shop.name | escape }}"
              width="600"
              height="780"
              loading="eager"
            >
            <div class="vv-auth-aside-scrim" aria-hidden="true"></div>
          {% endif %}
          <div class="vv-auth-aside-frame" aria-hidden="true"></div>
          <div class="vv-auth-aside-content">
            <span class="vv-auth-brand-kicker">{{ section.settings.side_kicker }}</span>
            <div class="vv-woven-accent" aria-hidden="true" style="margin: 14px 0 18px;"></div>
            <h2>{{ section.settings.side_heading }}</h2>
            {% if section.settings.side_copy != blank %}
              <p class="vv-auth-aside-copy">{{ section.settings.side_copy }}</p>
            {% endif %}
            {% if section.settings.perk_1 != blank or section.settings.perk_2 != blank or section.settings.perk_3 != blank %}
              <ul class="vv-auth-perks">
                {% if section.settings.perk_1 != blank %}<li>{{ section.settings.perk_1 }}</li>{% endif %}
                {% if section.settings.perk_2 != blank %}<li>{{ section.settings.perk_2 }}</li>{% endif %}
                {% if section.settings.perk_3 != blank %}<li>{{ section.settings.perk_3 }}</li>{% endif %}
              </ul>
            {% endif %}
          </div>
        </div>
      {% endif %}

      <div class="vv-auth-main">
        <nav class="vv-auth-tabs" aria-label="Account access">
          <a href="{{ routes.account_login_url }}" class="vv-auth-tab">Sign In</a>
          <a href="{{ routes.account_register_url }}" class="vv-auth-tab is-active" aria-current="page">Create Account</a>
        </nav>

        <div class="vv-auth-head">
          <span class="eyebrow">Join {{ shop.name }}</span>
          <h1>{{ section.settings.heading }}</h1>
          {% if section.settings.subtitle != blank %}
            <p class="vv-auth-sub">{{ section.settings.subtitle }}</p>
          {% endif %}
        </div>

        {% form 'create_customer', class: 'form-stack' %}
          {% if form.errors %}
            <div class="errors" role="alert">{{ form.errors | default_errors }}</div>
          {% endif %}

          <div class="vv-auth-name-row">
            <div class="field-group">
              <label for="RegisterFirstName-{{ section.id }}">First name</label>
              <input
                id="RegisterFirstName-{{ section.id }}"
                type="text"
                name="customer[first_name]"
                autocomplete="given-name"
                value="{{ form.first_name }}"
                placeholder="First name"
                required
              >
            </div>

            <div class="field-group">
              <label for="RegisterLastName-{{ section.id }}">Last name</label>
              <input
                id="RegisterLastName-{{ section.id }}"
                type="text"
                name="customer[last_name]"
                autocomplete="family-name"
                value="{{ form.last_name }}"
                placeholder="Last name"
                required
              >
            </div>
          </div>

          <div class="field-group">
            <label for="RegisterEmail-{{ section.id }}">Email address</label>
            <input
              id="RegisterEmail-{{ section.id }}"
              type="email"
              name="customer[email]"
              autocomplete="email"
              value="{{ form.email }}"
              placeholder="you@example.com"
              required
            >
          </div>

          <div class="field-group">
            <label for="RegisterPassword-{{ section.id }}">Password</label>
            <div class="vv-password-wrap">
              <input
                id="RegisterPassword-{{ section.id }}"
                type="password"
                name="customer[password]"
                autocomplete="new-password"
                minlength="5"
                placeholder="Create a password"
                required
              >
              <button
                type="button"
                class="vv-password-toggle"
                data-password-toggle
                aria-label="Show password"
                aria-pressed="false"
              >
                <span data-eye-show>{% render 'icons', icon: 'eye' %}</span>
                <span data-eye-hide hidden>{% render 'icons', icon: 'eye-off' %}</span>
              </button>
            </div>
            <span class="vv-field-hint">Use at least 5 characters.</span>
          </div>

          {% if section.settings.show_marketing_optin %}
            <label class="vv-check-row" for="RegisterMarketing-{{ section.id }}">
              <input
                id="RegisterMarketing-{{ section.id }}"
                type="checkbox"
                name="customer[accepts_marketing]"
                value="true"
                checked
              >
              <span>{{ section.settings.marketing_label }}</span>
            </label>
          {% endif %}

          <button type="submit" class="btn full">Create Account</button>
        {% endform %}

        <p class="vv-auth-foot-note">
          Already have an account?
          <a href="{{ routes.account_login_url }}" class="vv-auth-link">Sign In</a>
        </p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Customer Register",
  "settings": [
    { "type": "header", "content": "Create Account Form" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Create Your Account" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "Sign up for effortless checkout, order tracking and saved shipping addresses." },
    { "type": "checkbox", "id": "show_marketing_optin", "label": "Show newsletter opt-in checkbox", "default": true },
    { "type": "text", "id": "marketing_label", "label": "Newsletter opt-in label", "default": "Notify me about new saree arrivals & festive edits" },
    { "type": "header", "content": "Heritage Side Panel" },
    { "type": "checkbox", "id": "show_side_panel", "label": "Show heritage side panel (desktop)", "default": true },
    { "type": "image_picker", "id": "side_image", "label": "Editorial saree photograph (optional)" },
    { "type": "color", "id": "side_bg", "label": "Side panel fallback color", "default": "#1C382B" },
    { "type": "text", "id": "side_kicker", "label": "Brand kicker", "default": "Vedajanani Vastralayam · Hyderabad" },
    { "type": "text", "id": "side_heading", "label": "Editorial quote / heading", "default": "Timeless Weaves for Every Chapter." },
    { "type": "textarea", "id": "side_copy", "label": "Editorial note", "default": "Join our community of saree patrons for curated Cotton, Silk, Chiffon & Georgette collections." },
    { "type": "text", "id": "perk_1", "label": "Member benefit 1", "default": "Faster checkout with saved delivery details" },
    { "type": "text", "id": "perk_2", "label": "Member benefit 2", "default": "Complete order history & shipment updates" },
    { "type": "text", "id": "perk_3", "label": "Member benefit 3", "default": "Personal care from our Nagole, Hyderabad boutique" },
    { "type": "header", "content": "Spacing & Corners" },
    { "type": "range", "id": "card_radius", "label": "Card corner radius", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 24, "max": 96, "step": 8, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 32, "max": 96, "step": 8, "unit": "px", "default": 72 }
  ]
}
{% endschema %}
