{%- liquid
  assign has_split = false
  if section.settings.image != blank and section.settings.image_placement != 'none' and section.settings.image_placement != 'top'
    assign has_split = true
  endif
-%}

{% style %}
  #shopify-section-{{ section.id }} .vv-founder-sec {
    {% if section.settings.outer_bg != blank and section.settings.outer_bg != 'rgba(0,0,0,0)' %}
      background: {{ section.settings.outer_bg }};
    {% endif %}
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .founder-card {
    background: {{ section.settings.card_bg }};
    color: {{ section.settings.text_color }};
    border-radius: {{ section.settings.card_radius }}px;
    padding: {{ section.settings.card_pad_y }}px {{ section.settings.card_pad_x }}px;
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    text-align: {{ section.settings.text_align }};
    border: 1px solid var(--border-color, #E3D8C5);
  }
  #shopify-section-{{ section.id }} .founder-card h2 {
    font-size: {{ section.settings.heading_size }}px;
    color: {{ section.settings.heading_color }};
  }
  #shopify-section-{{ section.id }} .founder-body {
    font-size: {{ section.settings.body_size }}px;
    line-height: 1.85;
  }
  #shopify-section-{{ section.id }} .founder-sign {
    color: {{ section.settings.signature_color }};
    font-size: {{ section.settings.signature_size }}px;
  }
  #shopify-section-{{ section.id }} .founder-img img {
    border-radius: {{ section.settings.image_radius }}px;
    aspect-ratio: {{ section.settings.image_ratio }};
    object-fit: cover;
  }
  @media (max-width: 760px) {
    #shopify-section-{{ section.id }} .founder-card {
      padding: 28px 20px;
    }
  }
{% endstyle %}

<section class="vv-founder-sec">
  <div class="wrap">
    <div class="founder-card">
      <div class="founder-grid{% if has_split %} founder-grid--split{% endif %}{% if section.settings.image_placement == 'right' %} founder-grid--reverse{% endif %}">
        {% if section.settings.image != blank and section.settings.image_placement != 'none' %}
          <div class="founder-img">
            <img
              src="{{ section.settings.image | image_url: width: 1000 }}"
              alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
              width="700"
              height="875"
              loading="lazy"
            >
          </div>
        {% endif %}
        <div class="founder-copy">
          {% if section.settings.eyebrow != blank %}
            <span class="eyebrow">{{ section.settings.eyebrow }}</span>
          {% endif %}
          {% if section.settings.heading != blank %}
            <h2>{{ section.settings.heading }}</h2>
          {% endif %}
          {% if section.settings.body != blank %}
            <div class="founder-body">{{ section.settings.body }}</div>
          {% endif %}
          {% if section.settings.signature != blank %}
            <div class="founder-sign">{{ section.settings.signature }}</div>
          {% endif %}
          {% if section.settings.cta_label != blank %}
            <div style="margin-top: 24px;">
              <a class="btn outline" href="{{ section.settings.cta_url | default: routes.all_products_collection_url }}">{{ section.settings.cta_label }}</a>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Founder Letter",
  "settings": [
    { "type": "header", "content": "Image (Optional)" },
    { "type": "image_picker", "id": "image", "label": "Portrait or store image" },
    {
      "type": "select",
      "id": "image_placement",
      "label": "Image placement",
      "options": [
        { "value": "left", "label": "Left of letter" },
        { "value": "right", "label": "Right of letter" },
        { "value": "top", "label": "Above letter" },
        { "value": "none", "label": "Hidden" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image aspect ratio",
      "options": [
        { "value": "4 / 5", "label": "Portrait (4:5)" },
        { "value": "1 / 1", "label": "Square (1:1)" },
        { "value": "4 / 3", "label": "Landscape (4:3)" }
      ],
      "default": "4 / 5"
    },
    { "type": "range", "id": "image_radius", "label": "Image corner radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 12 },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our Story" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Woven with Grace, Worn with Pride" },
    {
      "type": "richtext",
      "id": "body",
      "label": "Letter content",
      "default": "<p>Vedajanani Vastralayam began in Hyderabad, Telangana with a simple promise: to bring together honest, thoughtfully selected Cotton, Silk, Chiffon &amp; Georgette sarees for every chapter of life — from breathable daily wear to festive family gatherings and timeless weddings.</p><p>Personalize this story in Theme Editor with your founder note, store photographs and milestones.</p>"
    },
    { "type": "text", "id": "signature", "label": "Signature", "default": "— Vedajanani Vastralayam, Hyderabad" },
    { "type": "text", "id": "cta_label", "label": "Button label (optional)", "default": "Explore Our Sarees" },
    { "type": "url", "id": "cta_url", "label": "Button link" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "outer_bg", "label": "Outer background (optional)" },
    { "type": "color", "id": "card_bg", "label": "Card background", "default": "#FFFFFF" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#1C1C1C" },
    { "type": "color", "id": "text_color", "label": "Body text color", "default": "#3A3732" },
    { "type": "color", "id": "signature_color", "label": "Signature color", "default": "#244737" },
    { "type": "header", "content": "Typography & Spacing" },
    { "type": "text_alignment", "id": "text_align", "label": "Text alignment", "default": "left" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 22, "max": 54, "step": 2, "unit": "px", "default": 34 },
    { "type": "range", "id": "body_size", "label": "Body font size", "min": 13, "max": 22, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "signature_size", "label": "Signature size", "min": 14, "max": 32, "step": 1, "unit": "px", "default": 20 },
    { "type": "range", "id": "max_width", "label": "Card max width", "min": 600, "max": 1240, "step": 40, "unit": "px", "default": 960 },
    { "type": "range", "id": "card_pad_y", "label": "Card vertical padding", "min": 20, "max": 96, "step": 4, "unit": "px", "default": 52 },
    { "type": "range", "id": "card_pad_x", "label": "Card horizontal padding", "min": 20, "max": 96, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "card_radius", "label": "Card corner radius", "min": 0, "max": 36, "step": 2, "unit": "px", "default": 12 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "presets": [
    { "name": "Founder Letter" }
  ]
}
{% endschema %}
