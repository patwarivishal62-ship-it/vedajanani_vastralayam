{%- liquid
  assign has_split = false
  if section.settings.image != blank and section.settings.image_placement != 'none' and section.settings.image_placement != 'top'
    assign has_split = true
  endif
  case section.settings.body_font
    when 'heading'
      assign b_font = 'var(--font-heading)'
    when 'body'
      assign b_font = 'var(--font-body)'
    else
      assign b_font = 'var(--font-accent)'
  endcase
-%}

{% style %}
  #shopify-section-{{ section.id }} .vv-founder-sec {
    {% if section.settings.bg_color != blank and section.settings.bg_color != 'rgba(0,0,0,0)' %}
      background: {{ section.settings.bg_color }};
    {% endif %}
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .founder-wrap {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    text-align: {{ section.settings.text_align }};
  }
  #shopify-section-{{ section.id }} .founder-heading {
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size }}px;
    margin: 10px 0 18px;
  }
  #shopify-section-{{ section.id }} .founder-body {
    font-family: {{ b_font }};
    font-size: {{ section.settings.body_size }}px;
    line-height: {{ section.settings.body_lh | divided_by: 100.0 }};
    color: {{ section.settings.text_color }};
  }
  #shopify-section-{{ section.id }} .founder-media img {
    border-radius: {{ section.settings.image_radius }}px;
    aspect-ratio: {{ section.settings.image_ratio }};
    object-fit: cover;
    width: 100%;
  }
{% endstyle %}

<section class="vv-founder-sec">
  <div class="wrap">
    <div class="founder-wrap">
      <div class="founder-grid{% if has_split %} founder-grid--split{% endif %}{% if section.settings.image_placement == 'right' %} founder-grid--reverse{% endif %}">
        {% if section.settings.image != blank and section.settings.image_placement != 'none' %}
          <div class="founder-media">
            <img
              src="{{ section.settings.image | image_url: width: 1000 }}"
              alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
              width="700"
              height="875"
              loading="lazy"
            >
          </div>
        {% endif %}

        <div class="founder-content">
          {% if section.settings.eyebrow != blank %}
            <span class="eyebrow">{{ section.settings.eyebrow }}</span>
          {% endif %}
          {% if section.settings.heading != blank %}
            <h2 class="founder-heading">{{ section.settings.heading }}</h2>
          {% endif %}
          {% if section.settings.letter != blank %}
            <div class="founder-body">{{ section.settings.letter }}</div>
          {% endif %}
          {% if section.settings.signature != blank %}
            <div class="founder-sig">{{ section.settings.signature }}</div>
          {% endif %}
          {% if section.settings.cta_label != blank %}
            <div style="margin-top: 24px;">
              <a class="btn" href="{{ section.settings.cta_url | default: '/pages/about' }}">{{ section.settings.cta_label }}</a>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Founder Letter",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Portrait / heritage image (optional)"
    },
    {
      "type": "select",
      "id": "image_placement",
      "label": "Image placement",
      "options": [
        { "value": "left", "label": "Left of text" },
        { "value": "right", "label": "Right of text" },
        { "value": "top", "label": "Above text" },
        { "value": "none", "label": "Hide image" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image aspect ratio",
      "options": [
        { "value": "4 / 5", "label": "Editorial Portrait (4:5)" },
        { "value": "3 / 4", "label": "Portrait (3:4)" },
        { "value": "1 / 1", "label": "Square (1:1)" },
        { "value": "4 / 3", "label": "Landscape (4:3)" }
      ],
      "default": "4 / 5"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 36,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our Heritage"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A note from our founder"
    },
    {
      "type": "richtext",
      "id": "letter",
      "label": "Founder letter text",
      "default": "<p>My mother taught me that when a woman drapes a saree, she carries her family's grace with her. At Vedajanani Vastralayam, every weave is handpicked for honest craftsmanship and timeless pride.</p>"
    },
    {
      "type": "text",
      "id": "signature",
      "label": "Signature line",
      "default": "— Vedajanani Vastralayam, Anantapur"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label (leave blank to hide)"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Typography, Colors & Spacing"
    },
    {
      "type": "select",
      "id": "body_font",
      "label": "Letter font",
      "options": [
        { "value": "accent", "label": "Theme Editorial / Product Font" },
        { "value": "body", "label": "Theme Body Font" },
        { "value": "heading", "label": "Theme Heading Font" }
      ],
      "default": "accent"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 22,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Letter font size",
      "min": 14,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "body_lh",
      "label": "Line height",
      "min": 130,
      "max": 200,
      "step": 5,
      "unit": "%",
      "default": 165
    },
    {
      "type": "text_alignment",
      "id": "text_align",
      "label": "Text alignment",
      "default": "left"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Content max width",
      "min": 560,
      "max": 1240,
      "step": 20,
      "unit": "px",
      "default": 980
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background (optional)"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1C1C1C"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Body text color",
      "default": "#2A2A2A"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Founder Letter"
    }
  ]
}
{% endschema %}
