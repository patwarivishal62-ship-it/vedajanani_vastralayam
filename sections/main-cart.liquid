{% style %}
  #shopify-section-{{ section.id }} .main-cart-sec {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}

<section class="wrap main-cart-sec">
  <h1 style="font-size: {{ section.settings.heading_size }}px;">{{ section.settings.heading }}</h1>

  {% if cart.item_count == 0 %}
    <div style="text-align: center; padding: 60px 20px; background: var(--surface, #fff); border-radius: var(--radius); border: 1px solid var(--border-color, #E3D8C5);">
      <p style="color: var(--text-muted); margin-bottom: 24px;">{{ section.settings.empty_message }}</p>
      <a class="btn" href="{{ section.settings.continue_url | default: routes.all_products_collection_url }}">{{ section.settings.continue_label }}</a>
    </div>
  {% else %}
    <form action="{{ routes.cart_url }}" method="post">
      <div class="cart-table">
        {% for item in cart.items %}
          <div class="cart-row">
            <a href="{{ item.url }}">
              {% if item.image %}
                <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}" width="100" height="133" loading="lazy">
              {% endif %}
            </a>
            <div>
              <a href="{{ item.url }}"><strong>{{ item.product.title }}</strong></a>
              {% unless item.product.has_only_default_variant %}
                <div style="font-size: 13px; color: var(--text-muted);">{{ item.variant.title }}</div>
              {% endunless %}
              <div style="margin-top: 6px;">{{ item.final_price | money }}</div>
              <a href="{{ item.url_to_remove }}" style="display: inline-block; margin-top: 8px; font-size: 12px; color: var(--text-muted); text-decoration: underline;">Remove</a>
            </div>
            <div>
              <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="Quantity for {{ item.product.title | escape }}" style="width: 72px;">
            </div>
            <div style="text-align: right;"><strong>{{ item.final_line_price | money }}</strong></div>
          </div>
        {% endfor %}
      </div>

      <div class="cart-page-foot">
        {% if section.settings.show_order_note %}
          <div style="flex: 1; max-width: 420px;">
            <label for="CartPageNote" style="display: block; font-size: 12px; text-transform: uppercase; letter-spacing: 1.5px; margin-bottom: 8px;">Order Note</label>
            <textarea id="CartPageNote" name="note" rows="3" placeholder="Special instructions, blouse note or gift message...">{{ cart.note }}</textarea>
          </div>
        {% endif %}

        <div class="cart-summary-box">
          <div style="display: flex; justify-content: space-between; font-size: 18px; margin-bottom: 10px;">
            <span>Subtotal</span>
            <strong>{{ cart.total_price | money }}</strong>
          </div>
          <p class="cart-note">{{ section.settings.shipping_note | default: settings.shipping_note }}</p>
          <div style="display: flex; gap: 10px; flex-wrap: wrap;">
            <button type="submit" name="update" class="btn outline">Update Bag</button>
            <button type="submit" name="checkout" class="btn">{{ section.settings.checkout_label }}</button>
          </div>
        </div>
      </div>
    </form>
  {% endif %}
</section>

{% schema %}
{
  "name": "Main Cart",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your Shopping Bag"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 24,
      "max": 56,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "text",
      "id": "empty_message",
      "label": "Empty bag message",
      "default": "Your shopping bag is currently empty."
    },
    {
      "type": "text",
      "id": "continue_label",
      "label": "Empty bag button label",
      "default": "Explore Sarees"
    },
    {
      "type": "url",
      "id": "continue_url",
      "label": "Empty bag button link"
    },
    {
      "type": "checkbox",
      "id": "show_order_note",
      "label": "Show order note textarea",
      "default": true
    },
    {
      "type": "text",
      "id": "shipping_note",
      "label": "Shipping & tax note",
      "default": "Shipping and taxes calculated at checkout."
    },
    {
      "type": "text",
      "id": "checkout_label",
      "label": "Checkout button label",
      "default": "Proceed to Checkout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ]
}
{% endschema %}
