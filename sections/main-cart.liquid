{% style %}
  #shopify-section-{{ section.id }} .vv-cart-sec {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}

<section class="vv-cart-sec">
  <div class="wrap" style="max-width: {{ section.settings.max_width }}px;">
    <div class="section-head section-head--{{ section.settings.header_align }}">
      <h1 style="font-size: {{ section.settings.heading_size }}px;">{{ section.settings.heading }}</h1>
    </div>

    {% if cart.item_count == 0 %}
      <div class="empty">
        <p>{{ section.settings.empty_text }}</p>
        <a class="btn" href="{{ routes.all_products_collection_url }}">Continue Shopping</a>
      </div>
    {% else %}
      <form action="{{ routes.cart_url }}" method="post">
        <div style="background: var(--surface); border-radius: var(--radius); padding: 24px; border: 1px solid var(--border-color);">
          {% for item in cart.items %}
            <div class="cart-item" style="align-items: center;">
              {% if item.image %}
                <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}" width="86" height="114" loading="lazy">
              {% endif %}
              <div class="cart-item-info">
                <a class="cart-item-title" href="{{ item.url }}">{{ item.product.title }}</a>
                {% unless item.product.has_only_default_variant %}
                  <div class="cart-item-variant">{{ item.variant.title }}</div>
                {% endunless %}
                <div>{{ item.final_price | money }}</div>
              </div>
              <div style="display: flex; align-items: center; gap: 14px; flex-wrap: wrap;">
                <input
                  type="number"
                  name="updates[]"
                  value="{{ item.quantity }}"
                  min="0"
                  aria-label="Quantity for {{ item.title | escape }}"
                  style="width: 78px;"
                >
                <strong>{{ item.final_line_price | money }}</strong>
                <a href="{{ item.url_to_remove }}" style="font-size: 12px; color: var(--text-muted);">Remove</a>
              </div>
            </div>
          {% endfor %}

          {% if section.settings.show_order_note %}
            <div style="margin-top: 20px;">
              <label for="CartNote" style="display:block; font-size: 11px; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 8px;">Order / Gifting Note</label>
              <textarea id="CartNote" name="note" rows="3" placeholder="Add fall & pico request or a gift message…">{{ cart.note }}</textarea>
            </div>
          {% endif %}

          <div style="margin-top: 24px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
            <div>
              <div style="font-size: 18px;">Subtotal: <strong>{{ cart.total_price | money }}</strong></div>
              {% if settings.shipping_note != blank %}
                <p style="font-size: 12px; color: var(--text-muted); margin-top: 4px;">{{ settings.shipping_note }}</p>
              {% endif %}
            </div>
            <div style="display: flex; gap: 12px; flex-wrap: wrap;">
              <button type="submit" name="update" class="btn outline">Update Bag</button>
              <button type="submit" name="checkout" class="btn dark">Checkout</button>
            </div>
          </div>
        </div>
      </form>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Main Cart",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your Shopping Bag"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Empty cart message",
      "default": "Your bag is currently empty."
    },
    {
      "type": "text_alignment",
      "id": "header_align",
      "label": "Header alignment",
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 24,
      "max": 56,
      "step": 2,
      "unit": "px",
      "default": 38
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Container max width",
      "min": 680,
      "max": 1360,
      "step": 20,
      "unit": "px",
      "default": 1000
    },
    {
      "type": "checkbox",
      "id": "show_order_note",
      "label": "Show order / gifting note box",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 16,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 16,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ]
}
{% endschema %}
