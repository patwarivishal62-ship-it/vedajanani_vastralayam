        }
      ]
    },
    {
      "type": "contact_info",
      "name": "Contact & Location",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Column heading",
          "default": "Visit & Connect"
        },
        {
          "type": "text",
          "id": "address",
          "label": "Store location",
          "default": "Anantapur, Andhra Pradesh, India"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Phone / WhatsApp"
        },
        {
          "type": "text",
          "id": "email",
          "label": "Support email"
        },
        {
          "type": "text",
          "id": "hours",
          "label": "Store hours"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "brand_info",
        "settings": {
          "heading": "Vedajanani Vastralayam",
          "tagline": "Woven with Grace, Worn with Pride",
          "description": "<p>Curated Cotton, Silk, Chiffon &amp; Georgette sarees from Anantapur, Andhra Pradesh.</p>"
