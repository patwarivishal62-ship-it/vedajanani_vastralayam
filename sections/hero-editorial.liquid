{%- liquid
  assign banner_h_desktop = section.settings.height_vh_desktop | append: 'vh'
  assign banner_h_mobile = section.settings.height_vh_mobile | append: 'vh'
  if section.settings.height_mode == 'px'
    assign banner_h_desktop = section.settings.height_px_desktop | append: 'px'
    assign banner_h_mobile = section.settings.height_px_mobile | append: 'px'
  endif

  assign overlay_alpha = section.settings.overlay_opacity | divided_by: 100.0
  assign box_alpha = section.settings.content_bg_opacity | divided_by: 100.0
-%}

{% style %}
  #shopify-section-{{ section.id }} .vv-hero-outer {
    {% if section.settings.outer_bg != blank and section.settings.outer_bg != 'rgba(0,0,0,0)' %}
      background: {{ section.settings.outer_bg }};
    {% endif %}
    padding-top: {{ section.settings.margin_top }}px;
    padding-bottom: {{ section.settings.margin_bottom }}px;
  }
  #shopify-section-{{ section.id }} .vv-banner {
    background: {{ section.settings.fallback_bg }};
    border-radius: {{ section.settings.banner_radius }}px;
    {% if section.settings.height_mode == 'ratio' %}
      aspect-ratio: 16 / 7;
      min-height: 460px;
      max-height: 760px;
    {% elsif section.settings.height_mode != 'adapt' %}
      min-height: {{ banner_h_desktop }};
    {% endif %}
  }
  #shopify-section-{{ section.id }} .vv-banner-media img {
    object-fit: {{ section.settings.image_fit }};
    object-position: {{ section.settings.image_position_desktop }};
  }
  #shopify-section-{{ section.id }} .vv-banner-overlay {
    {% if section.settings.align_vertical == 'flex-end' %}
      background: linear-gradient(180deg, rgba(16, 22, 18, 0.08) 0%, rgba(16, 22, 18, 0.35) 52%, {{ section.settings.overlay_color }} 100%);
    {% else %}
      background: {{ section.settings.overlay_color }};
    {% endif %}
    opacity: {{ overlay_alpha }};
  }
  #shopify-section-{{ section.id }} .vv-banner-inner {
    align-items: {{ section.settings.align_vertical }};
    justify-content: {{ section.settings.align_horizontal }};
    padding: {{ section.settings.content_pad_y }}px {{ section.settings.content_pad_x }}px;
  }
  #shopify-section-{{ section.id }} .vv-banner-content {
    max-width: {{ section.settings.content_max_width }}px;
    text-align: {{ section.settings.text_align }};
    {% if section.settings.content_bg_opacity > 0 %}
      background: {{ section.settings.content_bg_color | color_modify: 'alpha', box_alpha }};
      padding: {{ section.settings.content_box_pad }}px;
      border-radius: {{ section.settings.content_box_radius }}px;
    {% endif %}
  }
  #shopify-section-{{ section.id }} .vv-banner-actions {
    justify-content: {% if section.settings.text_align == 'center' %}center{% elsif section.settings.text_align == 'right' %}flex-end{% else %}flex-start{% endif %};
  }

  {% for block in section.blocks %}
    {% if block.type == 'heading' %}
      {%- liquid
        case block.settings.font_family
          when 'accent'
            assign bh_font = 'var(--font-accent)'
          when 'body'
            assign bh_font = 'var(--font-body)'
          else
            assign bh_font = 'var(--font-heading)'
        endcase
      -%}
      #vv-hero-block-{{ block.id }} {
        font-family: {{ bh_font }};
        color: {{ block.settings.color }};
        font-size: {{ block.settings.size_desktop }}px;
        line-height: {{ block.settings.line_height | divided_by: 100.0 }};
        letter-spacing: {{ block.settings.letter_spacing }}px;
        text-transform: {{ block.settings.transform }};
        margin: 0 0 {{ block.settings.gap_bottom }}px;
      }
      @media (max-width: 900px) {
        #vv-hero-block-{{ block.id }} {
          font-size: {{ block.settings.size_mobile }}px;
        }
      }
    {% elsif block.type == 'subheading' %}
      #vv-hero-block-{{ block.id }} {
        color: {{ block.settings.color }};
        font-size: {{ block.settings.size_desktop }}px;
        line-height: {{ block.settings.line_height | divided_by: 100.0 }};
        margin: 0 0 {{ block.settings.gap_bottom }}px;
      }
      @media (max-width: 900px) {
        #vv-hero-block-{{ block.id }} {
          font-size: {{ block.settings.size_mobile }}px;
        }
      }
    {% endif %}
  {% endfor %}

  @media (max-width: 900px) {
    #shopify-section-{{ section.id }} .vv-banner {
      {% if section.settings.height_mode == 'ratio' %}
        aspect-ratio: 4 / 5;
        min-height: 440px;
        max-height: 620px;
      {% elsif section.settings.height_mode != 'adapt' %}
        min-height: {{ banner_h_mobile }};
      {% endif %}
    }
    #shopify-section-{{ section.id }} .vv-banner-media img {
      object-position: {{ section.settings.image_position_mobile }};
    }
    #shopify-section-{{ section.id }} .vv-banner-inner {
      padding: 36px 20px;
    }
  }
{% endstyle %}

<section class="vv-hero-outer">
  <div class="{% if section.settings.banner_width == 'contained' %}vv-banner-wrap--contained{% elsif section.settings.banner_width == 'inset' %}vv-banner-wrap--inset{% endif %}">
    <div class="vv-banner{% if section.settings.height_mode == 'adapt' %} vv-banner--adapt{% endif %}">
      {% if section.settings.image_desktop != blank or section.settings.image_mobile != blank %}
        <div class="vv-banner-media">
          {% if section.settings.image_desktop != blank %}
            <img
              class="img-desktop{% if section.settings.image_mobile != blank %} has-mobile{% endif %}"
              src="{{ section.settings.image_desktop | image_url: width: 2000 }}"
              srcset="{{ section.settings.image_desktop | image_url: width: 900 }} 900w, {{ section.settings.image_desktop | image_url: width: 1400 }} 1400w, {{ section.settings.image_desktop | image_url: width: 2000 }} 2000w"
              sizes="100vw"
              alt="{{ section.settings.image_desktop.alt | default: shop.name | escape }}"
              width="{{ section.settings.image_desktop.width }}"
              height="{{ section.settings.image_desktop.height }}"
              loading="eager"
              fetchpriority="high"
            >
          {% endif %}
          {% if section.settings.image_mobile != blank %}
            <img
              class="img-mobile"
              src="{{ section.settings.image_mobile | image_url: width: 1000 }}"
              srcset="{{ section.settings.image_mobile | image_url: width: 600 }} 600w, {{ section.settings.image_mobile | image_url: width: 1000 }} 1000w"
              sizes="100vw"
              alt="{{ section.settings.image_mobile.alt | default: shop.name | escape }}"
              width="{{ section.settings.image_mobile.width }}"
              height="{{ section.settings.image_mobile.height }}"
              loading="eager"
              fetchpriority="high"
            >
          {% endif %}
        </div>
      {% endif %}

      <div class="vv-banner-overlay"></div>

      <div class="vv-banner-inner">
        <div class="vv-banner-content">
          {% if section.blocks.size > 0 %}
            {% for block in section.blocks %}
              {% case block.type %}
                {% when 'kicker' %}
                  <div
                    class="kicker"
                    style="color: {{ block.settings.color }}; font-size: {{ block.settings.size }}px; letter-spacing: {{ block.settings.letter_spacing }}px; margin-bottom: {{ block.settings.gap_bottom }}px;"
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.text }}
                  </div>

                {% when 'heading' %}
                  <h1 id="vv-hero-block-{{ block.id }}" {{ block.shopify_attributes }}>
                    {{ block.settings.text }}
                  </h1>

                {% when 'subheading' %}
                  <p id="vv-hero-block-{{ block.id }}" {{ block.shopify_attributes }}>
                    {{ block.settings.text }}
                  </p>

                {% when 'buttons' %}
                  <div
                    class="vv-banner-actions"
                    style="margin-top: {{ block.settings.gap_top }}px; margin-bottom: {{ block.settings.gap_bottom }}px;"
                    {{ block.shopify_attributes }}
                  >
                    {% if block.settings.cta_label != blank %}
                      {%- assign cta_fallback = routes.all_products_collection_url -%}
                      <a
                        class="{% if block.settings.cta_style == 'underline' %}link-cta{% else %}btn{% endif %}"
                        href="{{ block.settings.cta_url | default: cta_fallback }}"
                        style="
                          font-size: {{ block.settings.font_size }}px;
                          letter-spacing: {{ block.settings.letter_spacing }}px;
                          color: {{ block.settings.cta_color }};
                          {% if block.settings.cta_style == 'solid' %}
                            background: {{ block.settings.cta_bg }};
                            border-color: {{ block.settings.cta_bg }};
                          {% elsif block.settings.cta_style == 'outline' %}
                            background: transparent;
                            border-color: {{ block.settings.cta_color }};
                          {% endif %}
                        "
                      >
                        <span>{{ block.settings.cta_label }}</span>
                        {% if block.settings.cta_style == 'underline' %}{% render 'icons', icon: 'arrow-right' %}{% endif %}
                      </a>
                    {% endif %}

                    {% if block.settings.cta2_label != blank %}
                      <a
                        class="{% if block.settings.cta2_style == 'underline' %}link-cta{% else %}btn{% endif %}"
                        href="{{ block.settings.cta2_url | default: routes.all_products_collection_url }}"
                        style="
                          font-size: {{ block.settings.font_size }}px;
                          letter-spacing: {{ block.settings.letter_spacing }}px;
                          color: {{ block.settings.cta2_color }};
                          {% if block.settings.cta2_style == 'solid' %}
                            background: {{ block.settings.cta2_bg }};
                            border-color: {{ block.settings.cta2_bg }};
                          {% elsif block.settings.cta2_style == 'outline' %}
                            background: transparent;
                            border-color: {{ block.settings.cta2_color }};
                          {% endif %}
                        "
                      >
                        <span>{{ block.settings.cta2_label }}</span>
                        {% if block.settings.cta2_style == 'underline' %}{% render 'icons', icon: 'arrow-right' %}{% endif %}
                      </a>
                    {% endif %}
                  </div>
              {% endcase %}
            {% endfor %}
          {% else %}
            <div class="kicker" style="color: #E5D4AE; margin-bottom: 14px;">Vedajanani Vastralayam</div>
            <h1 style="color: #FAF2E3; font-size: 56px; line-height: 1.08; margin-bottom: 16px;">Woven with Grace, Worn with Pride.</h1>
            <p style="color: #EFE5D2; margin-bottom: 24px;">Curated Cotton, Silk, Chiffon &amp; Georgette sarees for everyday elegance and quiet celebrations.</p>
            <a class="btn" href="{{ routes.all_products_collection_url }}" style="background: #FAF2E3; color: #202521; border-color: #FAF2E3;">Shop Sarees</a>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Editorial",
  "settings": [
    { "type": "header", "content": "Banner Images & Size" },
    { "type": "image_picker", "id": "image_desktop", "label": "Desktop banner image" },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile banner image (optional)" },
    {
      "type": "select",
      "id": "banner_width",
      "label": "Banner width",
      "options": [
        { "value": "full", "label": "Full bleed (edge to edge)" },
        { "value": "inset", "label": "Full width with side inset" },
        { "value": "contained", "label": "Contained to page width" }
      ],
      "default": "full"
    },
    {
      "type": "select",
      "id": "height_mode",
      "label": "Banner height mode",
      "options": [
        { "value": "ratio", "label": "Editorial ratio (16:7 desktop / 4:5 mobile)" },
        { "value": "vh", "label": "Screen height (% of viewport)" },
        { "value": "px", "label": "Fixed height (pixels)" },
        { "value": "adapt", "label": "Adapt to uploaded image" }
      ],
      "default": "ratio"
    },
    { "type": "range", "id": "height_vh_desktop", "label": "Desktop height (% of screen)", "min": 40, "max": 96, "step": 2, "unit": "vh", "default": 72 },
    { "type": "range", "id": "height_px_desktop", "label": "Desktop fixed height (px mode)", "min": 360, "max": 860, "step": 20, "unit": "px", "default": 600 },
    { "type": "range", "id": "height_vh_mobile", "label": "Mobile height (% of screen)", "min": 40, "max": 90, "step": 2, "unit": "vh", "default": 66 },
    { "type": "range", "id": "height_px_mobile", "label": "Mobile fixed height (px mode)", "min": 320, "max": 720, "step": 20, "unit": "px", "default": 480 },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "options": [
        { "value": "cover", "label": "Cover (fill banner)" },
        { "value": "contain", "label": "Contain (show full image)" }
      ],
      "default": "cover"
    },
    {
      "type": "select",
      "id": "image_position_desktop",
      "label": "Image focal point (desktop)",
      "options": [
        { "value": "center center", "label": "Center" },
        { "value": "top center", "label": "Top" },
        { "value": "bottom center", "label": "Bottom" },
        { "value": "center left", "label": "Left" },
        { "value": "center right", "label": "Right" }
      ],
      "default": "top center"
    },
    {
      "type": "select",
      "id": "image_position_mobile",
      "label": "Image focal point (mobile)",
      "options": [
        { "value": "center center", "label": "Center" },
        { "value": "top center", "label": "Top" },
        { "value": "bottom center", "label": "Bottom" }
      ],
      "default": "top center"
    },
    { "type": "range", "id": "banner_radius", "label": "Banner corner radius", "min": 0, "max": 16, "step": 2, "unit": "px", "default": 0 },
    { "type": "header", "content": "Background & Overlay" },
    { "type": "color_background", "id": "fallback_bg", "label": "Fallback surface color", "default": "#1C382B" },
    { "type": "color", "id": "overlay_color", "label": "Scrim overlay color", "default": "#111A14" },
    { "type": "range", "id": "overlay_opacity", "label": "Scrim opacity", "min": 0, "max": 85, "step": 5, "unit": "%", "default": 55 },
    { "type": "header", "content": "Content Placement & Box" },
    {
      "type": "select",
      "id": "align_vertical",
      "label": "Vertical placement",
      "options": [
        { "value": "flex-start", "label": "Top" },
        { "value": "center", "label": "Middle" },
        { "value": "flex-end", "label": "Bottom" }
      ],
      "default": "flex-end"
    },
    {
      "type": "select",
      "id": "align_horizontal",
      "label": "Horizontal placement",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ],
      "default": "flex-start"
    },
    { "type": "text_alignment", "id": "text_align", "label": "Text alignment", "default": "left" },
    { "type": "range", "id": "content_max_width", "label": "Content max width", "min": 320, "max": 960, "step": 20, "unit": "px", "default": 620 },
    { "type": "range", "id": "content_pad_y", "label": "Inner top/bottom padding", "min": 24, "max": 96, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "content_pad_x", "label": "Inner left/right padding", "min": 20, "max": 96, "step": 4, "unit": "px", "default": 48 },
    { "type": "color", "id": "content_bg_color", "label": "Text box backdrop color (optional)", "default": "#16241D" },
    { "type": "range", "id": "content_bg_opacity", "label": "Text box backdrop opacity", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 0 },
    { "type": "range", "id": "content_box_pad", "label": "Text box inner padding", "min": 16, "max": 48, "step": 4, "unit": "px", "default": 28 },
    { "type": "range", "id": "content_box_radius", "label": "Text box corner radius", "min": 0, "max": 12, "step": 2, "unit": "px", "default": 4 },
    { "type": "header", "content": "Outer Section Spacing" },
    { "type": "color", "id": "outer_bg", "label": "Outer background color (optional)" },
    { "type": "range", "id": "margin_top", "label": "Top spacing", "min": 0, "max": 96, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "margin_bottom", "label": "Bottom spacing", "min": 0, "max": 96, "step": 4, "unit": "px", "default": 0 }
  ],
  "blocks": [
    {
      "type": "kicker",
      "name": "Kicker / Eyebrow",
      "limit": 2,
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Vedajanani Vastralayam · Anantapur" },
        { "type": "color", "id": "color", "label": "Color", "default": "#E5D4AE" },
        { "type": "range", "id": "size", "label": "Font size", "min": 12, "max": 18, "step": 1, "unit": "px", "default": 12 },
        { "type": "range", "id": "letter_spacing", "label": "Letter spacing", "min": 0, "max": 4, "step": 0.5, "unit": "px", "default": 2 },
        { "type": "range", "id": "gap_bottom", "label": "Bottom spacing", "min": 6, "max": 32, "step": 2, "unit": "px", "default": 12 }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "limit": 2,
      "settings": [
        { "type": "text", "id": "text", "label": "Heading", "default": "Woven with Grace, Worn with Pride." },
        {
          "type": "select",
          "id": "font_family",
          "label": "Font family",
          "options": [
            { "value": "heading", "label": "Theme Heading Font" },
            { "value": "accent", "label": "Theme Editorial Font" },
            { "value": "body", "label": "Theme Body Font" }
          ],
          "default": "heading"
        },
        { "type": "color", "id": "color", "label": "Color", "default": "#FAF2E3" },
        { "type": "range", "id": "size_desktop", "label": "Font size (desktop)", "min": 36, "max": 76, "step": 2, "unit": "px", "default": 56 },
        { "type": "range", "id": "size_mobile", "label": "Font size (mobile)", "min": 28, "max": 48, "step": 2, "unit": "px", "default": 36 },
        { "type": "range", "id": "line_height", "label": "Line height", "min": 95, "max": 135, "step": 5, "unit": "%", "default": 110 },
        { "type": "range", "id": "letter_spacing", "label": "Letter spacing", "min": -1, "max": 4, "step": 0.5, "unit": "px", "default": 0 },
        {
          "type": "select",
          "id": "transform",
          "label": "Text case",
          "options": [
            { "value": "none", "label": "Normal" },
            { "value": "capitalize", "label": "Title case" },
            { "value": "uppercase", "label": "Uppercase" }
          ],
          "default": "none"
        },
        { "type": "range", "id": "gap_bottom", "label": "Bottom spacing", "min": 8, "max": 36, "step": 2, "unit": "px", "default": 14 }
      ]
    },
    {
      "type": "subheading",
      "name": "Subheading",
      "limit": 2,
      "settings": [
        { "type": "textarea", "id": "text", "label": "Text", "default": "Cotton, Silk, Chiffon & Georgette sarees curated for everyday elegance and quiet celebrations." },
        { "type": "color", "id": "color", "label": "Color", "default": "#F2E9D8" },
        { "type": "range", "id": "size_desktop", "label": "Font size (desktop)", "min": 14, "max": 22, "step": 1, "unit": "px", "default": 16 },
        { "type": "range", "id": "size_mobile", "label": "Font size (mobile)", "min": 14, "max": 18, "step": 1, "unit": "px", "default": 15 },
        { "type": "range", "id": "line_height", "label": "Line height", "min": 135, "max": 180, "step": 5, "unit": "%", "default": 155 },
        { "type": "range", "id": "gap_bottom", "label": "Bottom spacing", "min": 12, "max": 40, "step": 2, "unit": "px", "default": 24 }
      ]
    },
    {
      "type": "buttons",
      "name": "CTA Buttons",
      "limit": 2,
      "settings": [
        { "type": "text", "id": "cta_label", "label": "Primary CTA label", "default": "Shop Sarees" },
        { "type": "url", "id": "cta_url", "label": "Primary CTA link" },
        {
          "type": "select",
          "id": "cta_style",
          "label": "Primary CTA style",
          "options": [
            { "value": "solid", "label": "Primary Solid Button" },
            { "value": "outline", "label": "Secondary Outline Button" },
            { "value": "underline", "label": "Editorial Underline Link" }
          ],
          "default": "solid"
        },
        { "type": "color", "id": "cta_color", "label": "Primary text color", "default": "#FFFFFF" },
        { "type": "color", "id": "cta_bg", "label": "Primary fill color (solid style)", "default": "#244737" },
        { "type": "text", "id": "cta2_label", "label": "Secondary CTA label (optional)" },
        { "type": "url", "id": "cta2_url", "label": "Secondary CTA link" },
        {
          "type": "select",
          "id": "cta2_style",
          "label": "Secondary CTA style",
          "options": [
            { "value": "outline", "label": "Outline Button" },
            { "value": "underline", "label": "Editorial Underline Link" },
            { "value": "solid", "label": "Solid Button" }
          ],
          "default": "outline"
        },
        { "type": "color", "id": "cta2_color", "label": "Secondary text color", "default": "#FAF2E3" },
        { "type": "color", "id": "cta2_bg", "label": "Secondary fill color (solid style)", "default": "#202521" },
        { "type": "range", "id": "font_size", "label": "Font size", "min": 12, "max": 16, "step": 1, "unit": "px", "default": 13 },
        { "type": "range", "id": "letter_spacing", "label": "Letter spacing", "min": 0, "max": 3, "step": 0.5, "unit": "px", "default": 1 },
        { "type": "range", "id": "gap_top", "label": "Top spacing", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 0 },
        { "type": "range", "id": "gap_bottom", "label": "Bottom spacing", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 0 }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Editorial",
      "blocks": [
        { "type": "kicker" },
        { "type": "heading" },
        { "type": "subheading" },
        { "type": "buttons" }
      ]
    }
  ]
}
{% endschema %}
