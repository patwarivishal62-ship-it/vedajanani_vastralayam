{%- liquid
  assign banner_h_desktop = section.settings.height_vh_desktop | append: 'vh'
  assign banner_h_mobile = section.settings.height_vh_mobile | append: 'vh'
  if section.settings.height_mode == 'px'
    assign banner_h_desktop = section.settings.height_px_desktop | append: 'px'
    assign banner_h_mobile = section.settings.height_px_mobile | append: 'px'
  endif

  assign overlay_alpha = section.settings.overlay_opacity | divided_by: 100.0
  assign box_alpha = section.settings.content_bg_opacity | divided_by: 100.0
-%}

{% style %}
  #shopify-section-{{ section.id }} .vv-hero-outer {
    {% if section.settings.outer_bg != blank and section.settings.outer_bg != 'rgba(0,0,0,0)' %}
      background: {{ section.settings.outer_bg }};
    {% endif %}
    padding-top: {{ section.settings.margin_top }}px;
    padding-bottom: {{ section.settings.margin_bottom }}px;
  }
  #shopify-section-{{ section.id }} .vv-banner {
    background: {{ section.settings.fallback_bg }};
    border-radius: {{ section.settings.banner_radius }}px;
    {% unless section.settings.height_mode == 'adapt' %}
      min-height: {{ banner_h_desktop }};
    {% endunless %}
  }
  #shopify-section-{{ section.id }} .vv-banner-media img {
    object-fit: {{ section.settings.image_fit }};
    object-position: {{ section.settings.image_position_desktop }};
  }
  #shopify-section-{{ section.id }} .vv-banner-overlay {
    background: {{ section.settings.overlay_color }};
    opacity: {{ overlay_alpha }};
  }
  #shopify-section-{{ section.id }} .vv-banner-inner {
    align-items: {{ section.settings.align_vertical }};
    justify-content: {{ section.settings.align_horizontal }};
    padding: {{ section.settings.content_pad_y }}px {{ section.settings.content_pad_x }}px;
  }
  #shopify-section-{{ section.id }} .vv-banner-content {
    max-width: {{ section.settings.content_max_width }}px;
    text-align: {{ section.settings.text_align }};
    {% if section.settings.content_bg_opacity > 0 %}
      background: {{ section.settings.content_bg_color | color_modify: 'alpha', box_alpha }};
      padding: {{ section.settings.content_box_pad }}px;
      border-radius: {{ section.settings.content_box_radius }}px;
    {% endif %}
  }
  #shopify-section-{{ section.id }} .vv-banner-actions {
    justify-content: {% if section.settings.text_align == 'center' %}center{% elsif section.settings.text_align == 'right' %}flex-end{% else %}flex-start{% endif %};
  }

  {% for block in section.blocks %}
    {% if block.type == 'heading' %}
      {%- liquid
        case block.settings.font_family
          when 'accent'
            assign bh_font = 'var(--font-accent)'
          when 'body'
            assign bh_font = 'var(--font-body)'
          else
            assign bh_font = 'var(--font-heading)'
        endcase
      -%}
      #vv-hero-block-{{ block.id }} {
        font-family: {{ bh_font }};
        color: {{ block.settings.color }};
        font-size: {{ block.settings.size_desktop }}px;
        line-height: {{ block.settings.line_height | divided_by: 100.0 }};
        letter-spacing: {{ block.settings.letter_spacing }}px;
        text-transform: {{ block.settings.transform }};
        margin: 0 0 {{ block.settings.gap_bottom }}px;
      }
      @media (max-width: 900px) {
        #vv-hero-block-{{ block.id }} {
          font-size: {{ block.settings.size_mobile }}px;
        }
      }
    {% elsif block.type == 'subheading' %}
      #vv-hero-block-{{ block.id }} {
        color: {{ block.settings.color }};
        font-size: {{ block.settings.size_desktop }}px;
        line-height: {{ block.settings.line_height | divided_by: 100.0 }};
        margin: 0 0 {{ block.settings.gap_bottom }}px;
      }
      @media (max-width: 900px) {
        #vv-hero-block-{{ block.id }} {
          font-size: {{ block.settings.size_mobile }}px;
        }
      }
    {% endif %}
  {% endfor %}

  @media (max-width: 900px) {
    #shopify-section-{{ section.id }} .vv-banner {
      {% unless section.settings.height_mode == 'adapt' %}
        min-height: {{ banner_h_mobile }};
      {% endunless %}
    }
    #shopify-section-{{ section.id }} .vv-banner-media img {
      object-position: {{ section.settings.image_position_mobile }};
    }
    #shopify-section-{{ section.id }} .vv-banner-inner {
      padding: {{ section.settings.content_pad_y | times: 0.6 | round }}px 20px;
    }
  }
{% endstyle %}

<section class="vv-hero-outer">
  <div class="{% if section.settings.banner_width == 'contained' %}vv-banner-wrap--contained{% elsif section.settings.banner_width == 'inset' %}vv-banner-wrap--inset{% endif %}">
    <div class="vv-banner{% if section.settings.height_mode == 'adapt' %} vv-banner--adapt{% endif %}">
      {% if section.settings.image_desktop != blank or section.settings.image_mobile != blank %}
        <div class="vv-banner-media">
          {% if section.settings.image_desktop != blank %}
            <img
              class="img-desktop{% if section.settings.image_mobile != blank %} has-mobile{% endif %}"
              src="{{ section.settings.image_desktop | image_url: width: 2000 }}"
              alt="{{ section.settings.image_desktop.alt | default: shop.name | escape }}"
              width="{{ section.settings.image_desktop.width }}"
              height="{{ section.settings.image_desktop.height }}"
              loading="eager"
            >
          {% endif %}
          {% if section.settings.image_mobile != blank %}
            <img
              class="img-mobile"
              src="{{ section.settings.image_mobile | image_url: width: 1000 }}"
              alt="{{ section.settings.image_mobile.alt | default: shop.name | escape }}"
              width="{{ section.settings.image_mobile.width }}"
              height="{{ section.settings.image_mobile.height }}"
              loading="eager"
            >
          {% endif %}
        </div>
      {% endif %}

      <div class="vv-banner-overlay"></div>

      <div class="vv-banner-inner">
        <div class="vv-banner-content">
          {% if section.blocks.size > 0 %}
            {% for block in section.blocks %}
              {% case block.type %}
                {% when 'kicker' %}
                  <div
                    class="kicker"
                    style="color: {{ block.settings.color }}; font-size: {{ block.settings.size }}px; letter-spacing: {{ block.settings.letter_spacing }}px; margin-bottom: {{ block.settings.gap_bottom }}px;"
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.text }}
                  </div>

                {% when 'heading' %}
                  <h1 id="vv-hero-block-{{ block.id }}" {{ block.shopify_attributes }}>
                    {{ block.settings.text }}
                  </h1>

                {% when 'subheading' %}
                  <p id="vv-hero-block-{{ block.id }}" {{ block.shopify_attributes }}>
                    {{ block.settings.text }}
                  </p>

                {% when 'buttons' %}
                  <div
                    class="vv-banner-actions"
                    style="margin-top: {{ block.settings.gap_top }}px; margin-bottom: {{ block.settings.gap_bottom }}px;"
                    {{ block.shopify_attributes }}
                  >
                    {% if block.settings.cta_label != blank %}
                      {%- assign cta_fallback = routes.collections_url | append: '/new-arrivals' -%}
                      <a
                        class="{% if block.settings.cta_style == 'underline' %}link-cta{% else %}btn{% endif %}"
                        href="{{ block.settings.cta_url | default: cta_fallback }}"
                        style="
                          font-size: {{ block.settings.font_size }}px;
                          letter-spacing: {{ block.settings.letter_spacing }}px;
                          color: {{ block.settings.cta_color }};
                          {% if block.settings.cta_style == 'solid' %}
                            background: {{ block.settings.cta_bg }};
                            border-color: {{ block.settings.cta_bg }};
                          {% elsif block.settings.cta_style == 'outline' %}
                            background: transparent;
                            border-color: {{ block.settings.cta_color }};
                          {% endif %}
                        "
                      >
                        {{ block.settings.cta_label }}{% if block.settings.cta_style == 'underline' %} →{% endif %}
                      </a>
                    {% endif %}

                    {% if block.settings.cta2_label != blank %}
                      <a
                        class="{% if block.settings.cta2_style == 'underline' %}link-cta{% else %}btn{% endif %}"
                        href="{{ block.settings.cta2_url | default: routes.all_products_collection_url }}"
                        style="
                          font-size: {{ block.settings.font_size }}px;
                          letter-spacing: {{ block.settings.letter_spacing }}px;
                          color: {{ block.settings.cta2_color }};
                          {% if block.settings.cta2_style == 'solid' %}
                            background: {{ block.settings.cta2_bg }};
                            border-color: {{ block.settings.cta2_bg }};
                          {% elsif block.settings.cta2_style == 'outline' %}
                            background: transparent;
                            border-color: {{ block.settings.cta2_color }};
                          {% endif %}
                        "
                      >
                        {{ block.settings.cta2_label }}{% if block.settings.cta2_style == 'underline' %} →{% endif %}
                      </a>
                    {% endif %}
                  </div>
              {% endcase %}
            {% endfor %}
          {% else %}
            <div class="kicker" style="color: #D9C7A5; margin-bottom: 14px;">Vedajanani Vastralayam · Festive 2026</div>
            <h1 style="color: #FFFFFF; font-size: 72px; line-height: 0.95; margin-bottom: 16px;">Drape the story you carry.</h1>
            <p style="color: #F3EDE3; margin-bottom: 28px;">Cotton, Silk, Chiffon & Georgette — handpicked from master weavers.</p>
            <a class="link-cta" href="{{ routes.all_products_collection_url }}" style="color: #FFFFFF;">Shop New Arrivals →</a>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Editorial",
  "settings": [
    {
      "type": "header",
      "content": "Banner Images & Size"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Desktop banner image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile banner image (optional)"
    },
    {
      "type": "select",
      "id": "banner_width",
      "label": "Banner width",
      "options": [
        {
          "value": "full",
          "label": "Full bleed (edge to edge)"
        },
        {
          "value": "inset",
          "label": "Full width with side inset"
        },
        {
          "value": "contained",
          "label": "Contained to page width"
        }
      ],
      "default": "full"
    },
    {
      "type": "select",
      "id": "height_mode",
      "label": "Banner height mode",
      "options": [
        {
          "value": "vh",
          "label": "Screen height (% of viewport)"
        },
        {
          "value": "px",
          "label": "Fixed height (pixels)"
        },
        {
          "value": "adapt",
          "label": "Adapt to uploaded image"
        }
      ],
      "default": "vh"
    },
    {
      "type": "range",
      "id": "height_vh_desktop",
      "label": "Desktop height (% of screen)",
      "min": 30,
      "max": 100,
      "step": 2,
      "unit": "vh",
      "default": 88
    },
    {
      "type": "range",
      "id": "height_px_desktop",
      "label": "Desktop fixed height (px mode)",
      "min": 300,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "default": 680
    },
    {
      "type": "range",
      "id": "height_vh_mobile",
      "label": "Mobile height (% of screen)",
      "min": 30,
      "max": 100,
      "step": 2,
      "unit": "vh",
      "default": 72
    },
    {
      "type": "range",
      "id": "height_px_mobile",
      "label": "Mobile fixed height (px mode)",
      "min": 240,
      "max": 840,
      "step": 20,
      "unit": "px",
      "default": 520
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "options": [
        {
          "value": "cover",
          "label": "Cover (fill banner)"
        },
        {
          "value": "contain",
          "label": "Contain (show full image)"
        }
      ],
      "default": "cover"
    },
    {
      "type": "select",
      "id": "image_position_desktop",
      "label": "Image focal point (desktop)",
      "options": [
        {
          "value": "center center",
          "label": "Center"
        },
        {
          "value": "top center",
          "label": "Top"
        },
        {
          "value": "bottom center",
          "label": "Bottom"
        },
        {
          "value": "center left",
          "label": "Left"
        },
        {
          "value": "center right",
          "label": "Right"
        },
        {
          "value": "top left",
          "label": "Top Left"
        },
        {
          "value": "top right",
          "label": "Top Right"
        }
      ],
      "default": "center center"
    },
    {
      "type": "select",
      "id": "image_position_mobile",
      "label": "Image focal point (mobile)",
      "options": [
        {
          "value": "center center",
          "label": "Center"
        },
        {
          "value": "top center",
          "label": "Top"
        },
        {
          "value": "bottom center",
          "label": "Bottom"
        },
        {
          "value": "center left",
          "label": "Left"
        },
        {
          "value": "center right",
          "label": "Right"
        }
      ],
      "default": "center center"
    },
    {
      "type": "range",
      "id": "banner_radius",
      "label": "Banner corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Background & Overlay"
    },
    {
      "type": "color_background",
      "id": "fallback_bg",
      "label": "Background color / gradient (when no image)",
      "default": "linear-gradient(160deg, #1A0A0E 0%, #5C1A24 55%, #8A3A2E 100%)"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Image overlay tint",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image overlay opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "header",
      "content": "Content Placement & Box"
    },
    {
      "type": "select",
      "id": "align_vertical",
      "label": "Vertical placement",
      "options": [
        {
          "value": "flex-start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Middle"
        },
        {
          "value": "flex-end",
          "label": "Bottom"
        }
      ],
      "default": "flex-end"
    },
    {
      "type": "select",
      "id": "align_horizontal",
      "label": "Horizontal placement",
      "options": [
        {
          "value": "flex-start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Right"
        }
      ],
      "default": "flex-start"
    },
    {
      "type": "text_alignment",
      "id": "text_align",
      "label": "Text alignment",
      "default": "left"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content max width",
      "min": 320,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 720
    },
    {
      "type": "range",
      "id": "content_pad_y",
      "label": "Inner top/bottom padding",
      "min": 16,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "content_pad_x",
      "label": "Inner left/right padding",
      "min": 16,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "color",
      "id": "content_bg_color",
      "label": "Text box backdrop color (optional)",
      "default": "#1C1C1C"
    },
    {
      "type": "range",
      "id": "content_bg_opacity",
      "label": "Text box backdrop opacity",
      "min": 0,
      "max": 95,
      "step": 5,
      "unit": "%",
      "default": 0
    },
    {
      "type": "range",
      "id": "content_box_pad",
      "label": "Text box inner padding",
      "min": 12,
      "max": 56,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "content_box_radius",
      "label": "Text box corner radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Outer Section Spacing"
    },
    {
      "type": "color",
      "id": "outer_bg",
      "label": "Outer background color (optional)"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Top spacing",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "kicker",
      "name": "Kicker / Eyebrow",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Vedajanani Vastralayam · Festive 2026"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Color",
          "default": "#D9C7A5"
        },
        {
          "type": "range",
          "id": "size",
          "label": "Font size",
          "min": 9,
          "max": 22,
          "step": 1,
          "unit": "px",
          "default": 11
        },
        {
          "type": "range",
          "id": "letter_spacing",
          "label": "Letter spacing",
          "min": 0,
          "max": 8,
          "step": 0.5,
          "unit": "px",
          "default": 4
        },
        {
          "type": "range",
          "id": "gap_bottom",
          "label": "Bottom spacing",
          "min": 4,
          "max": 44,
          "step": 2,
          "unit": "px",
          "default": 14
        }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Heading",
          "default": "Drape the story you carry."
        },
        {
          "type": "select",
          "id": "font_family",
          "label": "Font family",
          "options": [
            {
              "value": "heading",
              "label": "Theme Heading Font"
            },
            {
              "value": "accent",
              "label": "Theme Editorial / Product Font"
            },
            {
              "value": "body",
              "label": "Theme Body Font"
            }
          ],
          "default": "heading"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Color",
          "default": "#FFFFFF"
        },
        {
          "type": "range",
          "id": "size_desktop",
          "label": "Font size (desktop)",
          "min": 28,
          "max": 112,
          "step": 2,
          "unit": "px",
          "default": 76
        },
        {
          "type": "range",
          "id": "size_mobile",
          "label": "Font size (mobile)",
          "min": 24,
          "max": 64,
          "step": 2,
          "unit": "px",
          "default": 44
        },
        {
          "type": "range",
          "id": "line_height",
          "label": "Line height",
          "min": 85,
          "max": 150,
          "step": 5,
          "unit": "%",
          "default": 95
        },
        {
          "type": "range",
          "id": "letter_spacing",
          "label": "Letter spacing",
          "min": -2,
          "max": 8,
          "step": 0.5,
          "unit": "px",
          "default": 0
        },
        {
          "type": "select",
          "id": "transform",
          "label": "Text case",
          "options": [
            {
              "value": "none",
              "label": "Normal"
            },
            {
              "value": "uppercase",
              "label": "Uppercase"
            },
            {
              "value": "capitalize",
              "label": "Capitalize"
            }
          ],
          "default": "none"
        },
        {
          "type": "range",
          "id": "gap_bottom",
          "label": "Bottom spacing",
          "min": 4,
          "max": 48,
          "step": 2,
          "unit": "px",
          "default": 16
        }
      ]
    },
    {
      "type": "subheading",
      "name": "Subheading",
      "limit": 2,
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Cotton, Silk, Chiffon & Georgette — handpicked from master weavers."
        },
        {
          "type": "color",
          "id": "color",
          "label": "Color",
          "default": "#F3EDE3"
        },
        {
          "type": "range",
          "id": "size_desktop",
          "label": "Font size (desktop)",
          "min": 12,
          "max": 28,
          "step": 1,
          "unit": "px",
          "default": 16
        },
        {
          "type": "range",
          "id": "size_mobile",
          "label": "Font size (mobile)",
          "min": 12,
          "max": 22,
          "step": 1,
          "unit": "px",
          "default": 14
        },
        {
          "type": "range",
          "id": "line_height",
          "label": "Line height",
          "min": 120,
          "max": 200,
          "step": 5,
          "unit": "%",
          "default": 160
        },
        {
          "type": "range",
          "id": "gap_bottom",
          "label": "Bottom spacing",
          "min": 4,
          "max": 56,
          "step": 2,
          "unit": "px",
          "default": 28
        }
      ]
    },
    {
      "type": "buttons",
      "name": "CTA Buttons",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "cta_label",
          "label": "Primary CTA label",
          "default": "Shop New Arrivals"
        },
        {
          "type": "url",
          "id": "cta_url",
          "label": "Primary CTA link"
        },
        {
          "type": "select",
          "id": "cta_style",
          "label": "Primary CTA style",
          "options": [
            {
              "value": "underline",
              "label": "Editorial Underline"
            },
            {
              "value": "solid",
              "label": "Solid Button"
            },
            {
              "value": "outline",
              "label": "Outline Button"
            }
          ],
          "default": "underline"
        },
        {
          "type": "color",
          "id": "cta_color",
          "label": "Primary text color",
          "default": "#FFFFFF"
        },
        {
          "type": "color",
          "id": "cta_bg",
          "label": "Primary fill color (solid style)",
          "default": "#5C1A24"
        },
        {
          "type": "text",
          "id": "cta2_label",
          "label": "Secondary CTA label (optional)"
        },
        {
