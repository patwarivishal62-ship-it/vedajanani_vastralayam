<section class="vv-auth-sec">
  <div class="wrap">
    <div class="vv-auth-shell vv-auth-shell--single">
      <div class="vv-auth-main">
        <div class="vv-auth-head">
          <span class="eyebrow">Account Security</span>
          <h1>Set a New Password</h1>
          <p class="vv-auth-sub">Enter and confirm your new password below.</p>
        </div>

        {% form 'reset_customer_password', class: 'form-stack' %}
          {% if form.errors %}
            <div class="errors" role="alert">{{ form.errors | default_errors }}</div>
          {% endif %}

          <div class="field-group">
            <label for="ResetPassword">New password</label>
            <div class="vv-password-wrap">
              <input id="ResetPassword" type="password" name="customer[password]" autocomplete="new-password" minlength="5" required>
              <button type="button" class="vv-password-toggle" data-password-toggle aria-label="Show password" aria-pressed="false">
                <span data-eye-show>{% render 'icons', icon: 'eye' %}</span>
                <span data-eye-hide hidden>{% render 'icons', icon: 'eye-off' %}</span>
              </button>
            </div>
          </div>

          <div class="field-group">
            <label for="ResetPasswordConfirm">Confirm new password</label>
            <div class="vv-password-wrap">
              <input id="ResetPasswordConfirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" minlength="5" required>
              <button type="button" class="vv-password-toggle" data-password-toggle aria-label="Show password" aria-pressed="false">
                <span data-eye-show>{% render 'icons', icon: 'eye' %}</span>
                <span data-eye-hide hidden>{% render 'icons', icon: 'eye-off' %}</span>
              </button>
            </div>
          </div>

          <button type="submit" class="btn full">Update Password</button>
        {% endform %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Reset Password",
  "settings": []
}
{% endschema %}
