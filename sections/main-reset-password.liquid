<section style="padding: {{ section.settings.padding_y }}px 0;">
  <div class="wrap" style="max-width: 500px;">
    <div style="background: var(--surface); border-radius: var(--radius); padding: 36px; border: 1px solid var(--border-color);">
      <div class="section-head section-head--center" style="margin-bottom: 24px;">
        <span class="eyebrow">Account Security</span>
        <h1>Reset Password</h1>
      </div>
      {% form 'reset_customer_password', class: 'form-stack' %}
        {% if form.errors %}
          <div class="errors">{{ form.errors | default_errors }}</div>
        {% endif %}
        <input type="password" name="customer[password]" placeholder="New password" required>
        <input type="password" name="customer[password_confirmation]" placeholder="Confirm new password" required>
        <button type="submit" class="btn full">Reset Password</button>
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Main Reset Password",
  "settings": [
    { "type": "range", "id": "padding_y", "label": "Vertical padding", "min": 24, "max": 100, "step": 4, "unit": "px", "default": 64 }
  ]
}
{% endschema %}
