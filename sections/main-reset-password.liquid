<section class="account-sec">
  <div class="wrap account-narrow">
    <div class="account-card">
      <div class="account-head">
        <span class="eyebrow">Account Security</span>
        <h1>Set a New Password</h1>
        <p class="account-sub">Enter and confirm your new password below.</p>
      </div>
      {% form 'reset_customer_password', class: 'form-stack' %}
        {% if form.errors %}
          <div class="errors" role="alert">{{ form.errors | default_errors }}</div>
        {% endif %}
        <div class="field-group">
          <label for="ResetPassword">New password</label>
          <input id="ResetPassword" type="password" name="customer[password]" autocomplete="new-password" required>
        </div>
        <div class="field-group">
          <label for="ResetPasswordConfirm">Confirm new password</label>
          <input id="ResetPasswordConfirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
        </div>
        <button type="submit" class="btn full">Update Password</button>
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Reset Password",
  "settings": []
}
{% endschema %}
