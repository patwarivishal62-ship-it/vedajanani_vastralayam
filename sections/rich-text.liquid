{% style %}
  #shopify-section-{{ section.id }} .vv-richtext-sec {
    {% if section.settings.bg_color != blank and section.settings.bg_color != 'rgba(0,0,0,0)' %}
      background: {{ section.settings.bg_color }};
    {% endif %}
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .vv-richtext-inner {
    max-width: {{ section.settings.max_width }}px;
    text-align: {{ section.settings.text_align }};
    {% if section.settings.text_align == 'center' %}margin: 0 auto;{% elsif section.settings.text_align == 'right' %}margin-left: auto;{% endif %}
  }
  #shopify-section-{{ section.id }} .vv-richtext-heading {
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size_desktop }}px;
    margin: 10px 0 16px;
  }
  #shopify-section-{{ section.id }} .vv-richtext-body {
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.body_size }}px;
    line-height: {{ section.settings.body_lh | divided_by: 100.0 }};
  }
  @media (max-width: 900px) {
    #shopify-section-{{ section.id }} .vv-richtext-heading {
      font-size: {{ section.settings.heading_size_mobile }}px;
    }
  }
{% endstyle %}

<section class="vv-richtext-sec">
  <div class="wrap">
    <div class="vv-richtext-inner">
      {% if section.settings.eyebrow != blank %}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="vv-richtext-heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.body != blank %}
        <div class="vv-richtext-body">{{ section.settings.body }}</div>
      {% endif %}
      {% if section.settings.cta_label != blank %}
        <div style="margin-top: 24px;">
          <a
            class="{% if section.settings.cta_style == 'outline' %}btn outline{% elsif section.settings.cta_style == 'underline' %}link-cta{% else %}btn{% endif %}"
            href="{{ section.settings.cta_url | default: routes.all_products_collection_url }}"
          >
            {{ section.settings.cta_label }}{% if section.settings.cta_style == 'underline' %} →{% endif %}
          </a>
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Rich Text",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Woven with Grace"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Crafted for Generations"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body text",
      "default": "<p>Every saree at Vedajanani Vastralayam is chosen for its drape, authenticity and enduring beauty.</p>"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label (optional)"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "cta_style",
      "label": "Button style",
      "options": [
        { "value": "solid", "label": "Solid Button" },
        { "value": "outline", "label": "Outline Button" },
        { "value": "underline", "label": "Editorial Underline" }
      ],
      "default": "solid"
    },
    {
      "type": "header",
      "content": "Placement & Typography"
    },
    {
      "type": "text_alignment",
      "id": "text_align",
      "label": "Alignment",
      "default": "center"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Content max width",
      "min": 420,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 760
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Heading size (desktop)",
      "min": 22,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 38
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size (mobile)",
      "min": 20,
      "max": 44,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Body font size",
      "min": 13,
      "max": 26,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "body_lh",
      "label": "Body line height",
      "min": 120,
      "max": 200,
      "step": 5,
      "unit": "%",
      "default": 165
    },
    {
      "type": "header",
      "content": "Colors & Spacing"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color (optional)"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1C1C1C"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#444444"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "Rich Text"
    }
  ]
}
{% endschema %}
