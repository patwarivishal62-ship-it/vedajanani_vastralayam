{%- assign current_variant = product.selected_or_first_available_variant -%}

{% style %}
  #shopify-section-{{ section.id }} .vv-prod-sec {
    {% if section.settings.bg_color != blank and section.settings.bg_color != 'rgba(0,0,0,0)' %}
      background: {{ section.settings.bg_color }};
    {% endif %}
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .product-layout {
    grid-template-columns: {{ section.settings.gallery_width }}fr {{ 100 | minus: section.settings.gallery_width }}fr;
    gap: {{ section.settings.column_gap }}px;
  }
  #shopify-section-{{ section.id }} .product-gallery-col {
    {% if section.settings.sticky_gallery %}
      position: sticky;
      top: 110px;
    {% endif %}
  }
  #shopify-section-{{ section.id }} .product-gallery-main {
    aspect-ratio: {{ section.settings.image_ratio }};
    border-radius: {{ section.settings.image_radius }}px;
  }
  #shopify-section-{{ section.id }} .product-title-h1 {
    font-size: {{ section.settings.title_size_desktop }}px;
    color: {{ section.settings.title_color }};
    margin: 0;
  }
  @media (max-width: 900px) {
    #shopify-section-{{ section.id }} .product-gallery-col { position: static; }
    #shopify-section-{{ section.id }} .product-title-h1 {
      font-size: {{ section.settings.title_size_mobile }}px;
    }
  }
{% endstyle %}

<section class="vv-prod-sec" data-product-section>
  <div class="wrap">
    <div class="product-layout">
      <div class="product-gallery-col">
        <div class="product-gallery-main">
          {% if product.featured_image %}
            <img
              id="ProductMainImg-{{ section.id }}"
              src="{{ product.featured_image | image_url: width: 1400 }}"
              alt="{{ product.featured_image.alt | default: product.title | escape }}"
              width="1000"
              height="1333"
              loading="eager"
            >
          {% else %}
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {% endif %}
        </div>

        {% if product.images.size > 1 %}
          <div class="product-thumbs">
            {% for image in product.images %}
              <button
                type="button"
                class="product-thumb-btn{% if forloop.first %} is-active{% endif %}"
                data-thumb-target="ProductMainImg-{{ section.id }}"
                data-thumb-src="{{ image | image_url: width: 1400 }}"
                aria-label="View image {{ forloop.index }}"
              >
                <img src="{{ image | image_url: width: 240 }}" alt="{{ image.alt | default: product.title | escape }}" width="160" height="213" loading="lazy">
              </button>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <div class="product-info-stack">
        {% form 'product', product, class: 'js-ajax-cart-form product-form-wrap' %}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id-input>

          {% if section.blocks.size > 0 %}
            {% for block in section.blocks %}
              <div {{ block.shopify_attributes }} style="margin-bottom: {{ block.settings.spacing_bottom | default: 14 }}px;">
                {% case block.type %}
                  {% when 'vendor' %}
                    {% if product.vendor != blank %}
                      <span class="eyebrow">{{ product.vendor }}</span>
                    {% endif %}

                  {% when 'title' %}
                    <h1 class="product-title-h1">{{ product.title }}</h1>

                  {% when 'price' %}
                    <div style="font-size: {{ block.settings.price_size }}px;">
                      {% render 'price', product: product, variant: current_variant %}
                    </div>
                    {% if block.settings.tax_note != blank %}
                      <p style="font-size: 12px; color: var(--text-muted); margin-top: 4px;">{{ block.settings.tax_note }}</p>
                    {% endif %}

                  {% when 'variant_picker' %}
                    {% unless product.has_only_default_variant %}
                      <label style="display:block; font-size: 11px; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 8px;">
                        {{ block.settings.label | default: 'Select Option' }}
                      </label>
                      {% if block.settings.picker_type == 'pills' %}
                        <div class="variant-pills" data-variant-pills>
                          {% for variant in product.variants %}
                            <button
                              type="button"
                              class="variant-pill{% if variant.id == current_variant.id %} is-selected{% endif %}"
                              data-variant-id="{{ variant.id }}"
                              {% unless variant.available %}disabled style="opacity:0.45; cursor:not-allowed;"{% endunless %}
                            >
                              {{ variant.title }}
                            </button>
                          {% endfor %}
                        </div>
                      {% else %}
                        <select data-variant-select aria-label="Select variant">
                          {% for variant in product.variants %}
                            <option
                              value="{{ variant.id }}"
                              {% if variant.id == current_variant.id %}selected{% endif %}
                              {% unless variant.available %}disabled{% endunless %}
                            >
                              {{ variant.title }} — {{ variant.price | money }}{% unless variant.available %} (Sold Out){% endunless %}
                            </option>
                          {% endfor %}
                        </select>
                      {% endif %}
                    {% endunless %}

                  {% when 'quantity' %}
                    <label for="Qty-{{ section.id }}" style="display:block; font-size: 11px; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 8px;">Quantity</label>
                    <input id="Qty-{{ section.id }}" type="number" name="quantity" value="1" min="1" style="max-width: 110px;">

                  {% when 'buy_buttons' %}
                    <div style="display: flex; flex-direction: column; gap: 10px;">
                      <button
                        type="submit"
                        class="btn full"
                        {% unless current_variant.available %}disabled{% endunless %}
                      >
                        {% if current_variant.available %}
                          {{ block.settings.add_label | default: 'Add to Bag' }}
                        {% else %}
                          Sold Out
                        {% endif %}
                      </button>
                      {% if block.settings.show_dynamic_checkout %}
                        {{ form | payment_button }}
                      {% endif %}
                    </div>

                  {% when 'description' %}
                    {% if product.description != blank %}
                      <div class="product-description" style="line-height: 1.7;">{{ product.description }}</div>
                    {% endif %}

                  {% when 'collapsible_tab' %}
                    <details class="vv-accordion"{% if block.settings.open_default %} open{% endif %}>
                      <summary>
                        <span>{{ block.settings.heading }}</span>
                        <span>+</span>
                      </summary>
                      <div class="vv-accordion-body">{{ block.settings.content }}</div>
                    </details>

                  {% when 'custom_text' %}
                    <div style="font-size: 13px; color: var(--text-muted);">{{ block.settings.text }}</div>
                {% endcase %}
              </div>
            {% endfor %}
          {% else %}
            <h1 class="product-title-h1">{{ product.title }}</h1>
            <div style="margin: 12px 0;">{% render 'price', product: product, variant: current_variant %}</div>
            <button type="submit" class="btn full">Add to Bag</button>
            {% if product.description != blank %}
              <div style="margin-top: 20px;">{{ product.description }}</div>
            {% endif %}
          {% endif %}
        {% endform %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Main Product",
  "settings": [
    {
      "type": "range",
      "id": "gallery_width",
      "label": "Gallery width share (desktop)",
      "min": 40,
      "max": 66,
      "step": 2,
      "unit": "%",
      "default": 54
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Gap between gallery & info",
      "min": 20,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 44
    },
    {
      "type": "checkbox",
      "id": "sticky_gallery",
      "label": "Sticky product gallery on desktop",
      "default": true
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Main image aspect ratio",
      "options": [
        { "value": "3 / 4", "label": "Portrait (3:4)" },
        { "value": "4 / 5", "label": "Editorial (4:5)" },
        { "value": "2 / 3", "label": "Tall (2:3)" },
        { "value": "1 / 1", "label": "Square (1:1)" }
      ],
      "default": "3 / 4"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Gallery corner radius",
      "min": 0,
      "max": 36,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "title_size_desktop",
      "label": "Product title size (desktop)",
      "min": 22,
      "max": 56,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "label": "Product title size (mobile)",
      "min": 20,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Product title color",
      "default": "#1C1C1C"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background (optional)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 16,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 16,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "vendor",
      "name": "Vendor / Label",
      "limit": 1,
      "settings": [
        { "type": "range", "id": "spacing_bottom", "label": "Bottom spacing", "min": 0, "max": 36, "step": 2, "unit": "px", "default": 8 }
      ]
    },
    {
      "type": "title",
      "name": "Product Title",
      "limit": 1,
      "settings": [
        { "type": "range", "id": "spacing_bottom", "label": "Bottom spacing", "min": 0, "max": 36, "step": 2, "unit": "px", "default": 12 }
      ]
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1,
      "settings": [
        { "type": "range", "id": "price_size", "label": "Price font size", "min": 14, "max": 32, "step": 1, "unit": "px", "default": 20 },
        { "type": "text", "id": "tax_note", "label": "Tax / shipping note", "default": "Inclusive of all taxes. Free shipping above ₹999." },
        { "type": "range", "id": "spacing_bottom", "label": "Bottom spacing", "min": 0, "max": 36, "step": 2, "unit": "px", "default": 18 }
      ]
    },
    {
      "type": "variant_picker",
      "name": "Variant Picker",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Select Variant" },
        {
          "type": "select",
          "id": "picker_type",
          "label": "Picker style",
          "options": [
            { "value": "pills", "label": "Rounded Pills" },
            { "value": "dropdown", "label": "Dropdown" }
          ],
          "default": "pills"
        },
        { "type": "range", "id": "spacing_bottom", "label": "Bottom spacing", "min": 0, "max": 36, "step": 2, "unit": "px", "default": 16 }
      ]
    },
    {
      "type": "quantity",
      "name": "Quantity Selector",
      "limit": 1,
      "settings": [
        { "type": "range", "id": "spacing_bottom", "label": "Bottom spacing", "min": 0, "max": 36, "step": 2, "unit": "px", "default": 16 }
      ]
    },
    {
      "type": "buy_buttons",
      "name": "Buy Buttons",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "add_label", "label": "Add to bag text", "default": "Add to Bag" },
        { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show Buy It Now button", "default": true },
        { "type": "range", "id": "spacing_bottom", "label": "Bottom spacing", "min": 0, "max": 36, "step": 2, "unit": "px", "default": 22 }
      ]
    },
    {
      "type": "description",
      "name": "Product Description",
      "limit": 1,
      "settings": [
        { "type": "range", "id": "spacing_bottom", "label": "Bottom spacing", "min": 0, "max": 36, "step": 2, "unit": "px", "default": 18 }
      ]
    },
    {
      "type": "collapsible_tab",
      "name": "Collapsible Details",
      "settings": [
        { "type": "text", "id": "heading", "label": "Tab heading", "default": "Saree Details & Care" },
        { "type": "richtext", "id": "content", "label": "Tab content", "default": "<p>Length: 5.5 metres saree with 0.8 metre unstitched blouse piece. Dry clean recommended for silk weaves.</p>" },
        { "type": "checkbox", "id": "open_default", "label": "Open by default", "default": false },
        { "type": "range", "id": "spacing_bottom", "label": "Bottom spacing", "min": 0, "max": 28, "step": 2, "unit": "px", "default": 6 }
      ]
    },
    {
      "type": "custom_text",
      "name": "Trust / Note Text",
      "settings": [
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>✓ Handpicked from master weavers · ✓ Cash on Delivery Available</p>" },
        { "type": "range", "id": "spacing_bottom", "label": "Bottom spacing", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 14 }
      ]
    }
  ]
}
{% endschema %}
