{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'ProductForm-' | append: section.id
  assign wa_digits = settings.whatsapp_number | strip | remove: ' ' | remove: '+' | remove: '-' | remove: '(' | remove: ')'
  assign wa_greeting = settings.whatsapp_greeting | default: 'Hello Vedajanani Vastralayam, I would like to enquire about this saree:'
  assign product_full_url = request.origin | append: product.url
-%}

{% style %}
  #shopify-section-{{ section.id }} .vv-pdp-sec {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .pdp-grid {
    gap: {{ section.settings.column_gap }}px;
    {% if section.settings.media_width == 'narrow' %}
      grid-template-columns: 50fr 50fr;
    {% elsif section.settings.media_width == 'wide' %}
      grid-template-columns: 62fr 38fr;
    {% else %}
      grid-template-columns: 58fr 42fr;
    {% endif %}
  }
  #shopify-section-{{ section.id }} .pdp-main {
    aspect-ratio: {{ section.settings.media_ratio }};
    border-radius: {{ section.settings.media_radius }}px;
  }
  #shopify-section-{{ section.id }} .pdp-thumb-btn {
    border-radius: {{ section.settings.thumb_radius }}px;
  }
  @media (max-width: 960px) {
    #shopify-section-{{ section.id }} .pdp-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    #shopify-section-{{ section.id }} .vv-pdp-sec {
      padding-bottom: 104px;
    }
  }
{% endstyle %}

<section
  class="vv-pdp-sec"
  data-product-section
  data-product-title="{{ product.title | escape }}"
  data-product-url="{{ product_full_url | escape }}"
  data-wa-digits="{{ wa_digits | escape }}"
  data-wa-greeting="{{ wa_greeting | escape }}"
>
  <div class="wrap">
    {% if section.settings.show_breadcrumbs %}
      {% render 'breadcrumbs' %}
    {% endif %}

    <div class="pdp-grid{% if section.settings.media_position == 'right' %} pdp-grid--media-right{% endif %}">
      <div class="pdp-gallery{% if section.settings.sticky_column == 'gallery' %} pdp-col--sticky{% endif %}" data-pdp-gallery>
        <div class="pdp-main" data-pdp-main-stage>
          {% if product.featured_image %}
            <img
              id="pdpMainImg-{{ section.id }}"
              data-pdp-main
              data-current-index="0"
              src="{{ product.featured_image | image_url: width: 1400 }}"
              srcset="{{ product.featured_image | image_url: width: 600 }} 600w, {{ product.featured_image | image_url: width: 1000 }} 1000w, {{ product.featured_image | image_url: width: 1400 }} 1400w"
              sizes="(max-width: 960px) 100vw, 56vw"
              alt="{{ product.featured_image.alt | default: product.title | escape }}"
              width="1000"
              height="1333"
              loading="eager"
              fetchpriority="high"
            >
            {% if section.settings.enable_zoom %}
              <button type="button" class="pdp-zoom-trigger" data-pdp-zoom-open aria-label="Zoom saree image">
                {% render 'icons', icon: 'zoom' %}
              </button>
            {% endif %}
            {% if product.images.size > 1 %}
              <button type="button" class="pdp-slide-nav pdp-slide-nav--prev" data-pdp-prev aria-label="Previous image">
                {% render 'icons', icon: 'chevron-left' %}
              </button>
              <button type="button" class="pdp-slide-nav pdp-slide-nav--next" data-pdp-next aria-label="Next image">
                {% render 'icons', icon: 'chevron-right' %}
              </button>
              <span class="pdp-slide-counter" data-pdp-counter>1 / {{ product.images.size }}</span>
            {% endif %}
          {% else %}
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {% endif %}
        </div>

        {% if product.images.size > 1 %}
          <div class="pdp-thumbs" role="list">
            {% for img in product.images %}
              <button
                type="button"
                class="pdp-thumb-btn{% if forloop.first %} is-active{% endif %}"
                data-pdp-thumb
                data-index="{{ forloop.index0 }}"
                data-src="{{ img | image_url: width: 1400 }}"
                data-zoom-src="{{ img | image_url: width: 2000 }}"
                data-alt="{{ img.alt | default: product.title | escape }}"
                aria-label="View saree photo {{ forloop.index }} of {{ product.images.size }}"
                aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
              >
                <img
                  src="{{ img | image_url: width: 220 }}"
                  alt="{{ img.alt | default: product.title | escape }}"
                  width="120"
                  height="160"
                  loading="lazy"
                >
              </button>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <div class="pdp-info{% if section.settings.sticky_column == 'info' %} pdp-col--sticky{% endif %}">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'vendor' %}
              {% if product.vendor != blank %}
                <span class="eyebrow" style="margin-bottom: 8px;" {{ block.shopify_attributes }}>{{ product.vendor }}</span>
              {% endif %}

            {% when 'title' %}
              <h1 style="font-size: {{ block.settings.title_size }}px; margin-bottom: 10px;" {{ block.shopify_attributes }}>
                {{ product.title }}
              </h1>

            {% when 'price' %}
              <div class="pdp-price-wrap" style="margin-bottom: 18px;" {{ block.shopify_attributes }}>
                <div class="price" style="font-size: {{ block.settings.price_size }}px;" data-pdp-price-container>
                  {% if current_variant.compare_at_price > current_variant.price %}
                    <span class="sale" data-pdp-price>{{ current_variant.price | money }}</span>
                    <s class="compare" data-pdp-compare>{{ current_variant.compare_at_price | money }}</s>
                  {% else %}
                    <span data-pdp-price>{{ current_variant.price | money }}</span>
                    <s class="compare" data-pdp-compare hidden></s>
                  {% endif %}
                </div>
                {% if block.settings.show_tax_note %}
                  <p class="pdp-tax-note">{{ block.settings.tax_note }}</p>
                {% endif %}
                <p class="pdp-sku" data-pdp-sku{% if current_variant.sku == blank %} hidden{% endif %}>
                  SKU: <span data-pdp-sku-val>{{ current_variant.sku }}</span>
                </p>
              </div>

            {% when 'variant_picker' %}
              {% unless product.has_only_default_variant %}
                <div class="pdp-variants" style="margin-bottom: 18px;" {{ block.shopify_attributes }}>
                  <label for="VariantSelect-{{ section.id }}" class="field-label">
                    {{ block.settings.label }}
                  </label>
                  <select id="VariantSelect-{{ section.id }}" data-variant-select>
                    {% for v in product.variants %}
                      <option
                        value="{{ v.id }}"
                        {% if v.id == current_variant.id %}selected{% endif %}
                        {% unless v.available %}disabled{% endunless %}
                      >
                        {{ v.title }} — {{ v.price | money }}{% unless v.available %} (Sold Out){% endunless %}
                      </option>
                    {% endfor %}
                  </select>
                </div>
              {% endunless %}

            {% when 'quantity' %}
              <div class="pdp-qty-wrap" style="margin-bottom: 18px;" {{ block.shopify_attributes }}>
                <label for="PdpQty-{{ section.id }}" class="field-label">Quantity</label>
                <div class="pdp-qty-control">
                  <button type="button" data-qty-step="-1" aria-label="Decrease quantity">−</button>
                  <input id="PdpQty-{{ section.id }}" type="number" name="quantity" value="1" min="1" form="{{ product_form_id }}" data-pdp-qty-input aria-label="Quantity">
                  <button type="button" data-qty-step="1" aria-label="Increase quantity">+</button>
                </div>
              </div>

            {% when 'buy_buttons' %}
              <div style="margin-bottom: 16px;" data-pdp-buy-sentinel {{ block.shopify_attributes }}>
                {% form 'product', product, id: product_form_id, class: 'js-ajax-cart-form pdp-form' %}
                  <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id-input>
                  <div class="pdp-form-error" data-pdp-error role="alert" hidden></div>
                  <button
                    type="submit"
                    class="btn pdp-atc"
                    data-pdp-submit
                    {% unless current_variant.available %}disabled{% endunless %}
                    style="width: 100%; background: {{ block.settings.btn_bg }}; border-color: {{ block.settings.btn_bg }}; color: {{ block.settings.btn_text }};"
                  >
                    {% if current_variant.available %}
                      {{ block.settings.add_label }}
                    {% else %}
                      Sold Out
                    {% endif %}
                  </button>
                  {% if block.settings.show_dynamic_checkout %}
                    <div style="margin-top: 10px;">
                      {{ form | payment_button }}
                    </div>
                  {% endif %}
                {% endform %}
              </div>

            {% when 'enquiry_share' %}
              {%- liquid
                assign wa_text = wa_greeting | append: ' ' | append: product.title
                unless product.has_only_default_variant
                  assign wa_text = wa_text | append: ' (' | append: current_variant.title | append: ')'
                endunless
                if current_variant.sku != blank
                  assign wa_text = wa_text | append: ' [SKU: ' | append: current_variant.sku | append: ']'
                endif
                assign wa_text = wa_text | append: ' ' | append: product_full_url
              -%}
              {% if wa_digits != blank or block.settings.show_share %}
                <div class="pdp-assist-row" {{ block.shopify_attributes }}>
                  {% if wa_digits != blank %}
                    <a
                      class="btn outline pdp-wa-btn"
                      data-pdp-wa-link
                      href="https://wa.me/{{ wa_digits }}?text={{ wa_text | url_encode }}"
                      target="_blank"
                      rel="noopener"
                    >
                      {% render 'icons', icon: 'whatsapp' %}
                      <span>{{ block.settings.whatsapp_label }}</span>
                    </a>
                  {% endif %}
                  {% if block.settings.show_share %}
                    <button
                      type="button"
                      class="btn outline pdp-share-btn"
                      data-pdp-share
                      data-share-title="{{ product.title | escape }}"
                      data-share-url="{{ product_full_url | escape }}"
                    >
                      {% render 'icons', icon: 'share' %}
                      <span data-share-label>{{ block.settings.share_label }}</span>
                    </button>
                  {% endif %}
                </div>
              {% endif %}

            {% when 'pincode_check' %}
              <div
                class="pdp-pincode-box"
                data-pincode-widget
                data-serviceable-prefixes="{{ block.settings.serviceable_prefixes | escape }}"
                data-msg-valid="{{ block.settings.valid_message | escape }}"
                data-msg-outside="{{ block.settings.outside_message | escape }}"
                {{ block.shopify_attributes }}
              >
                <div class="pdp-pincode-head">
                  {% render 'icons', icon: 'truck' %}
                  <span>{{ block.settings.heading }}</span>
                </div>
                <div class="pdp-pincode-form">
                  <label for="PincodeInput-{{ section.id }}" class="visually-hidden">Enter 6-digit Indian PIN code</label>
                  <input
                    id="PincodeInput-{{ section.id }}"
                    type="text"
                    inputmode="numeric"
                    maxlength="6"
                    pattern="[1-9][0-9]{5}"
                    placeholder="{{ block.settings.placeholder }}"
                    data-pincode-input
                  >
                  <button type="button" class="btn outline" data-pincode-btn>{{ block.settings.button_label }}</button>
                </div>
                <p class="pdp-pincode-result" data-pincode-result role="status" aria-live="polite" hidden></p>
              </div>

            {% when 'saree_specs' %}
              {%- liquid
                assign mf = product.metafields.custom
                assign has_any_spec = false
                if mf.fabric != blank or mf.weave != blank or mf.saree_length != blank or mf.width != blank or mf.blouse_piece != blank or mf.colour != blank or mf.border_type != blank or mf.occasion != blank or mf.weight != blank or mf.care_instructions != blank
                  assign has_any_spec = true
                endif
              -%}
              {% if has_any_spec %}
                <div class="pdp-specs" {{ block.shopify_attributes }}>
                  <h2 class="pdp-specs-heading">{{ block.settings.heading }}</h2>
                  <dl class="pdp-specs-grid">
                    {% if mf.fabric != blank %}
                      <div><dt>Fabric</dt><dd>{{ mf.fabric }}</dd></div>
                    {% endif %}
                    {% if mf.weave != blank %}
                      <div><dt>Weave / Style</dt><dd>{{ mf.weave }}</dd></div>
                    {% endif %}
                    {% if mf.saree_length != blank %}
                      <div><dt>Saree Length</dt><dd>{{ mf.saree_length }}</dd></div>
                    {% endif %}
                    {% if mf.width != blank %}
                      <div><dt>Width</dt><dd>{{ mf.width }}</dd></div>
                    {% endif %}
                    {% if mf.blouse_piece != blank %}
                      <div><dt>Blouse Piece</dt><dd>{{ mf.blouse_piece }}</dd></div>
                    {% endif %}
                    {% if mf.colour != blank %}
                      <div><dt>Colour</dt><dd>{{ mf.colour }}</dd></div>
                    {% endif %}
                    {% if mf.border_type != blank %}
                      <div><dt>Border &amp; Pallu</dt><dd>{{ mf.border_type }}</dd></div>
                    {% endif %}
                    {% if mf.occasion != blank %}
                      <div><dt>Occasion</dt><dd>{{ mf.occasion }}</dd></div>
                    {% endif %}
                    {% if mf.weight != blank %}
                      <div><dt>Weight / Drape</dt><dd>{{ mf.weight }}</dd></div>
                    {% endif %}
                    {% if mf.care_instructions != blank %}
                      <div><dt>Care</dt><dd>{{ mf.care_instructions }}</dd></div>
                    {% endif %}
                  </dl>
                </div>
              {% elsif request.design_mode %}
                <div class="pdp-specs pdp-specs--editor-hint" {{ block.shopify_attributes }}>
                  <p><strong>Saree Specifications (Metafield-driven):</strong> Populate product metafields under <code>custom.*</code> (<code>fabric</code>, <code>weave</code>, <code>saree_length</code>, <code>width</code>, <code>blouse_piece</code>, <code>colour</code>, <code>border_type</code>, <code>occasion</code>, <code>weight</code>, <code>care_instructions</code>) in Shopify Admin to show verified specs for each saree.</p>
                </div>
              {% endif %}

            {% when 'description' %}
              {% if product.description != blank %}
                <div class="pdp-desc rte" style="margin: 22px 0;" {{ block.shopify_attributes }}>
                  {{ product.description }}
                </div>
              {% endif %}

            {% when 'collapsible_tab' %}
              {%- liquid
                assign tab_content = block.settings.content
                assign policy_link_url = blank
                assign policy_link_label = blank
                if block.settings.policy_source == 'shipping' and shop.shipping_policy != blank
                  assign policy_link_url = shop.shipping_policy.url
                  assign policy_link_label = 'Read full Shipping Policy'
                elsif block.settings.policy_source == 'refund' and shop.refund_policy != blank
                  assign policy_link_url = shop.refund_policy.url
                  assign policy_link_label = 'Read full Returns & Refund Policy'
                endif
              -%}
              {% if tab_content != blank or policy_link_url != blank %}
                <details class="pdp-accordion" {% if block.settings.open_default %}open{% endif %} {{ block.shopify_attributes }}>
                  <summary>{{ block.settings.heading }}</summary>
                  <div class="pdp-accordion-body">
                    {% if tab_content != blank %}{{ tab_content }}{% endif %}
                    {% if policy_link_url != blank %}
                      <p style="margin-top: 10px;"><a href="{{ policy_link_url }}" class="link-cta"><span>{{ policy_link_label }}</span>{% render 'icons', icon: 'arrow-right' %}</a></p>
                    {% endif %}
                  </div>
                </details>
              {% endif %}

            {% when 'color_disclaimer' %}
              {% if block.settings.text != blank %}
                <p class="pdp-disclaimer" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
              {% endif %}

            {% when 'custom_text' %}
              {% if block.settings.text != blank %}
                <div class="pdp-trust-note" style="margin: 14px 0; font-size: 13px; color: var(--text-muted);" {{ block.shopify_attributes }}>
                  {{ block.settings.text }}
                </div>
              {% endif %}
          {% endcase %}
        {% endfor %}
      </div>
    </div>
  </div>

  {% if section.settings.enable_sticky_mobile_atc %}
    <div class="pdp-sticky-bar" data-pdp-sticky-bar aria-hidden="true">
      <div class="pdp-sticky-meta">
        <span class="pdp-sticky-title">{{ product.title | truncate: 38 }}</span>
        <strong class="pdp-sticky-price" data-pdp-sticky-price>{{ current_variant.price | money }}</strong>
      </div>
      <button
        type="button"
        class="btn pdp-sticky-btn"
        data-pdp-sticky-submit
        {% unless current_variant.available %}disabled{% endunless %}
      >
        {% if current_variant.available %}Add to Bag{% else %}Sold Out{% endif %}
      </button>
    </div>
  {% endif %}

  {% if section.settings.enable_zoom and product.images.size > 0 %}
    <div class="pdp-lightbox" data-pdp-lightbox role="dialog" aria-modal="true" aria-label="Saree image zoom" aria-hidden="true" hidden>
      <button type="button" class="pdp-lightbox-close" data-pdp-zoom-close aria-label="Close zoom">
        {% render 'icons', icon: 'close' %}
      </button>
      {% if product.images.size > 1 %}
        <button type="button" class="pdp-lightbox-nav pdp-lightbox-nav--prev" data-pdp-zoom-prev aria-label="Previous image">
          {% render 'icons', icon: 'chevron-left' %}
        </button>
        <button type="button" class="pdp-lightbox-nav pdp-lightbox-nav--next" data-pdp-zoom-next aria-label="Next image">
          {% render 'icons', icon: 'chevron-right' %}
        </button>
      {% endif %}
      <img class="pdp-lightbox-img" data-pdp-lightbox-img src="{{ product.featured_image | image_url: width: 2000 }}" alt="{{ product.title | escape }}" width="1600" height="2133" loading="lazy">
    </div>
  {% endif %}

  <script type="application/json" data-pdp-variants>
    [
      {% for v in product.variants %}
        {
          "id": {{ v.id }},
          "title": {{ v.title | json }},
          "available": {{ v.available | json }},
          "price_formatted": {{ v.price | money | json }},
          "compare_formatted": {% if v.compare_at_price > v.price %}{{ v.compare_at_price | money | json }}{% else %}null{% endif %},
          "sku": {{ v.sku | json }},
          "image_src": {% if v.featured_image %}{{ v.featured_image | image_url: width: 1400 | json }}{% else %}null{% endif %}
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]
  </script>
</section>

{% schema %}
{
  "name": "Main Product",
  "settings": [
    { "type": "header", "content": "Layout & Gallery" },
    { "type": "checkbox", "id": "show_breadcrumbs", "label": "Show breadcrumbs", "default": true },
    {
      "type": "select",
      "id": "media_position",
      "label": "Gallery position (desktop)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "media_width",
      "label": "Gallery column width",
      "options": [
        { "value": "narrow", "label": "Equal (50% / 50%)" },
        { "value": "medium", "label": "Editorial (58% / 42%)" },
        { "value": "wide", "label": "Wide (62% / 38%)" }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "Main image aspect ratio",
      "options": [
        { "value": "3 / 4", "label": "Portrait (3:4)" },
        { "value": "4 / 5", "label": "Editorial (4:5)" },
        { "value": "2 / 3", "label": "Tall (2:3)" },
        { "value": "1 / 1", "label": "Square (1:1)" }
      ],
      "default": "3 / 4"
    },
    {
      "type": "select",
      "id": "sticky_column",
      "label": "Sticky desktop column",
      "options": [
        { "value": "info", "label": "Sticky details & buy column" },
        { "value": "gallery", "label": "Sticky gallery column" },
        { "value": "none", "label": "None" }
      ],
      "default": "info"
    },
    { "type": "checkbox", "id": "enable_zoom", "label": "Enable fullscreen image zoom lightbox", "default": true },
    { "type": "checkbox", "id": "enable_sticky_mobile_atc", "label": "Show sticky Add-to-Bag bar on mobile", "default": true },
    { "type": "range", "id": "media_radius", "label": "Main image corner radius", "min": 0, "max": 12, "step": 2, "unit": "px", "default": 4 },
    { "type": "range", "id": "thumb_radius", "label": "Thumbnail corner radius", "min": 0, "max": 8, "step": 2, "unit": "px", "default": 4 },
    { "type": "range", "id": "column_gap", "label": "Gap between gallery & info", "min": 24, "max": 72, "step": 4, "unit": "px", "default": 48 },
    { "type": "header", "content": "Section Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 16, "max": 80, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 32, "max": 96, "step": 4, "unit": "px", "default": 72 }
  ],
  "blocks": [
    { "type": "vendor", "name": "Vendor / Label", "limit": 1 },
    {
      "type": "title",
      "name": "Product Title",
      "limit": 1,
      "settings": [
        { "type": "range", "id": "title_size", "label": "Title font size", "min": 24, "max": 44, "step": 2, "unit": "px", "default": 32 }
      ]
    },
    {
      "type": "price",
      "name": "Price & SKU",
      "limit": 1,
      "settings": [
        { "type": "range", "id": "price_size", "label": "Price font size", "min": 18, "max": 28, "step": 1, "unit": "px", "default": 20 },
        { "type": "checkbox", "id": "show_tax_note", "label": "Show tax note", "default": true },
        { "type": "text", "id": "tax_note", "label": "Tax note", "default": "Inclusive of applicable taxes. Shipping calculated at checkout." }
      ]
    },
    {
      "type": "variant_picker",
      "name": "Variant Picker",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Select Option" }
      ]
    },
    { "type": "quantity", "name": "Quantity Selector", "limit": 1 },
    {
      "type": "buy_buttons",
      "name": "Add to Bag Button",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "add_label", "label": "Add to bag label", "default": "Add to Bag" },
        { "type": "color", "id": "btn_bg", "label": "Button background", "default": "#244737" },
        { "type": "color", "id": "btn_text", "label": "Button text color", "default": "#FFFFFF" },
        { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show dynamic Buy Now button", "default": true }
      ]
    },
    {
      "type": "enquiry_share",
      "name": "WhatsApp & Share",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "whatsapp_label", "label": "WhatsApp enquiry button label", "default": "Enquire on WhatsApp" },
        { "type": "checkbox", "id": "show_share", "label": "Show Share Saree button", "default": true },
        { "type": "text", "id": "share_label", "label": "Share button label", "default": "Share Saree" }
      ]
    },
    {
      "type": "pincode_check",
      "name": "Delivery PIN Check",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Check Delivery Availability" },
        { "type": "text", "id": "placeholder", "label": "Input placeholder", "default": "Enter 6-digit PIN code" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Check" },
        { "type": "text", "id": "serviceable_prefixes", "label": "Serviceable PIN prefixes (optional)", "info": "Comma-separated prefixes (e.g. 51, 50, 56). Leave blank to accept all valid 6-digit Indian PINs." },
        { "type": "text", "id": "valid_message", "label": "Valid PIN message", "default": "Valid Indian PIN code. Final shipping options and delivery estimate are shown at checkout." },
