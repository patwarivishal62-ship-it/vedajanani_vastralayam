{%- assign ov_alpha = section.settings.banner_overlay | divided_by: 100.0 -%}

{% style %}
  #shopify-section-{{ section.id }} .vv-col-sec {
    {% if section.settings.bg_color != blank and section.settings.bg_color != 'rgba(0,0,0,0)' %}
      background: {{ section.settings.bg_color }};
    {% endif %}
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .col-banner {
    min-height: {{ section.settings.banner_height }}px;
    border-radius: {{ section.settings.banner_radius }}px;
    margin-bottom: 32px;
  }
  #shopify-section-{{ section.id }} .product-grid {
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
    gap: {{ section.settings.grid_gap }}px;
  }
  @media (max-width: 900px) {
    #shopify-section-{{ section.id }} .product-grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, minmax(0, 1fr));
    }
  }
{% endstyle %}

<section class="vv-col-sec">
  <div class="wrap">
    {% if section.settings.show_banner and collection.image != blank %}
      <div class="vv-banner col-banner" style="background: #2B0E14;">
        <div class="vv-banner-media">
          <img src="{{ collection.image | image_url: width: 1800 }}" alt="{{ collection.title | escape }}" style="object-fit: cover;" width="1600" height="600" loading="eager">
        </div>
        <div class="vv-banner-overlay" style="background: #000000; opacity: {{ ov_alpha }};"></div>
        <div class="vv-banner-inner" style="align-items: center; justify-content: {% if section.settings.header_align == 'left' %}flex-start{% elsif section.settings.header_align == 'right' %}flex-end{% else %}center{% endif %}; padding: 40px 32px;">
          <div class="vv-banner-content" style="text-align: {{ section.settings.header_align }}; color: #FFFFFF; max-width: 720px;">
            <h1 style="font-size: {{ section.settings.heading_size }}px; color: #FFFFFF;">{{ collection.title }}</h1>
            {% if section.settings.show_description and collection.description != blank %}
              <div>{{ collection.description }}</div>
            {% endif %}
          </div>
        </div>
      </div>
    {% else %}
      <div class="section-head section-head--{{ section.settings.header_align }}">
        <h1 style="font-size: {{ section.settings.heading_size }}px; color: {{ section.settings.heading_color }};">{{ collection.title }}</h1>
        {% if section.settings.show_description and collection.description != blank %}
          <div class="section-sub">{{ collection.description }}</div>
        {% endif %}
      </div>
    {% endif %}

    {% if section.settings.show_count or section.settings.show_sort %}
      <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; margin-bottom: 24px; padding-bottom: 14px; border-bottom: 1px solid var(--border-color);">
        {% if section.settings.show_count %}
          <span style="font-size: 13px; color: var(--text-muted);">{{ collection.products_count }} sarees</span>
        {% endif %}
        {% if section.settings.show_sort %}
          <div style="display: flex; align-items: center; gap: 10px;">
            <label for="SortBy-{{ section.id }}" style="font-size: 11px; letter-spacing: 2px; text-transform: uppercase;">Sort</label>
            <select id="SortBy-{{ section.id }}" data-collection-sort style="width: auto; padding: 8px 14px;">
              {% assign current_sort = collection.sort_by | default: collection.default_sort_by %}
              {% for option in collection.sort_options %}
                <option value="{{ option.value }}"{% if option.value == current_sort %} selected{% endif %}>{{ option.name }}</option>
              {% endfor %}
            </select>
          </div>
        {% endif %}
      </div>
    {% endif %}

    {% paginate collection.products by section.settings.products_per_page %}
      {% if collection.products.size > 0 %}
        <div class="product-grid">
          {% for p in collection.products %}
            {% render 'product-card', product: p, ratio: section.settings.image_ratio %}
          {% endfor %}
        </div>
      {% else %}
        <div class="empty">
          <p>No products in this collection yet.</p>
          <a class="btn" href="{{ routes.all_products_collection_url }}">Browse All Sarees</a>
        </div>
      {% endif %}

      {% if paginate.pages > 1 %}
        <nav class="pagination" aria-label="Pagination">
          {{ paginate | default_pagination }}
        </nav>
      {% endif %}
    {% endpaginate %}
  </div>
</section>

{% schema %}
{
  "name": "Main Collection",
  "settings": [
    {
      "type": "header",
      "content": "Collection Header & Banner"
    },
    {
      "type": "checkbox",
      "id": "show_banner",
      "label": "Show collection banner when image exists",
      "default": true
    },
    {
      "type": "range",
      "id": "banner_height",
      "label": "Collection banner height",
      "min": 180,
      "max": 600,
      "step": 20,
      "unit": "px",
      "default": 320
    },
    {
      "type": "range",
      "id": "banner_radius",
      "label": "Banner corner radius",
      "min": 0,
      "max": 36,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "banner_overlay",
      "label": "Banner overlay opacity",
      "min": 0,
      "max": 85,
      "step": 5,
      "unit": "%",
      "default": 35
    },
    {
      "type": "text_alignment",
      "id": "header_align",
      "label": "Header alignment",
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color (when no banner)",
      "default": "#1C1C1C"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show collection description",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Show product count",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sort",
      "label": "Show sort dropdown",
      "default": true
    },
    {
      "type": "header",
      "content": "Product Grid"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 4,
      "max": 48,
      "step": 4,
      "default": 12
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns (mobile)",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Grid gap",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Product image ratio",
      "options": [
        {
          "value": "3 / 4",
          "label": "Portrait (3:4)"
        },
        {
          "value": "4 / 5",
          "label": "Editorial (4:5)"
        },
        {
          "value": "2 / 3",
          "label": "Tall (2:3)"
        },
        {
          "value": "1 / 1",
          "label": "Square (1:1)"
        }
      ],
      "default": "3 / 4"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background (optional)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 16,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 16,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ]
}
{% endschema %}
