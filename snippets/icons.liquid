{% comment %}
  Uniform 24px outline SVG icon family (1.6px stroke) for Vedajanani Vastralayam
{% endcomment %}
{% case icon %}
  {% when 'search' %}
    <svg class="vv-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="11" cy="11" r="7"></circle>
      <path d="M20 20L16.2 16.2"></path>
    </svg>
  {% when 'account' %}
    <svg class="vv-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="8" r="3.8"></circle>
      <path d="M5 19.5c1.3-3.5 3.9-5.2 7-5.2s5.7 1.7 7 5.2"></path>
    </svg>
  {% when 'bag' %}
    <svg class="vv-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M6 8.5h12l1 11.5H5L6 8.5z"></path>
      <path d="M9 8.5V6.5a3 3 0 0 1 6 0v2"></path>
    </svg>
  {% when 'menu' %}
    <svg class="vv-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
      <path d="M4 7h16M4 12h16M4 17h16"></path>
    </svg>
  {% when 'close' %}
    <svg class="vv-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
      <path d="M6.5 6.5l11 11M17.5 6.5l-11 11"></path>
    </svg>
  {% when 'chevron-down' %}
    <svg class="vv-icon vv-icon--sm" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M6 9l6 6 6-6"></path>
    </svg>
  {% when 'chevron-left' %}
    <svg class="vv-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M15 6l-6 6 6 6"></path>
    </svg>
  {% when 'chevron-right' %}
    <svg class="vv-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M9 6l6 6-6 6"></path>
    </svg>
  {% when 'arrow-left' %}
    <svg class="vv-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M19 12H5M11 6l-6 6 6 6"></path>
    </svg>
  {% when 'arrow-right' %}
    <svg class="vv-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M5 12h14M13 6l6 6-6 6"></path>
    </svg>
  {% when 'filter' %}
    <svg class="vv-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M4 6h16M7 12h10M10 18h4"></path>
    </svg>
  {% when 'zoom' %}
    <svg class="vv-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="11" cy="11" r="7"></circle>
      <path d="M20 20l-4-4M11 8v6M8 11h6"></path>
    </svg>
  {% when 'whatsapp' %}
    <svg class="vv-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M20.5 11.8a8.5 8.5 0 0 1-12.5 7.5L3.5 20.5l1.3-4.3A8.5 8.5 0 1 1 20.5 11.8z"></path>
      <path d="M9.5 9.2c.2-.4.5-.4.8-.4h.6c.2 0 .4.1.5.4l.7 1.6c.1.2.1.5-.1.7l-.5.6c.6 1 1.4 1.8 2.4 2.4l.6-.5c.2-.2.5-.2.7-.1l1.6.7c.3.1.4.3.4.5v.6c0 .3 0 .6-.4.8-.5.3-1.4.4-2.5 0-1.6-.6-3.6-2.2-4.6-4.1-.5-.9-.6-1.9-.2-3.2z"></path>
    </svg>
  {% when 'share' %}
    <svg class="vv-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="18" cy="5" r="3"></circle>
      <circle cx="6" cy="12" r="3"></circle>
      <circle cx="18" cy="19" r="3"></circle>
      <path d="M8.6 13.5l6.8 4M15.4 6.5l-6.8 4"></path>
    </svg>
  {% when 'truck' %}
    <svg class="vv-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M2 7h12v9H2zM14 10h4l3 3v3h-7v-6z"></path>
      <circle cx="6.5" cy="17.5" r="1.8"></circle>
      <circle cx="17.5" cy="17.5" r="1.8"></circle>
    </svg>
  {% when 'play' %}
    <svg class="vv-icon" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" stroke="none" aria-hidden="true">
      <path d="M8 5.5v13l10.5-6.5L8 5.5z"></path>
    </svg>
{% endcase %}
